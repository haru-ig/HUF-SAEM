#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::memcpy, {CI}, {}, BB);

     
    II->setAtomicOrdering(llvm::AtomicOrdering::Unordered);
    II->setSyncScopeID(llvm::SyncScopeID::SingleThread);
    II->setVolatile(true);

     
    Mod->print(errs(), nullptr);

    return 0;
}
