#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    FunctionCallee Callee = M.getOrInsertFunction("llvm.memset", FTy);
    std::vector<Value *> Args;
    Args.push_back(ConstantInt::get(Type::getInt32Ty(Context), 0));
    Args.push_back(ConstantInt::get(Type::getInt32Ty(Context), 16));  
    Args.push_back(ConstantInt::get(Type::getInt32Ty(Context), 1));   
    CallBase *CI = CallInst::Create(Callee, Args, "", BB);

     
    CI->addUse(*F->arg_begin());

     
    if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memset) {
             
            F->setDoesNotThrow();
            F->setUnwindDest(nullptr);

             
            if (NumBytes > 0 && NumBytes % ElementSize == 0) {
                std::cerr << "Error: NumBytes must not be a multiple of ElementSize for atomic unordered memory intrinsics." << std::endl;
                return -1;
            }

             
        }
    }

     
    M.print(outs(), nullptr);

    return 0;
}
