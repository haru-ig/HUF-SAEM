#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function* F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    AllocaInst* ArgAlloca = new AllocaInst(Type::getInt32Ty(Context), 0, "", BB);
    Value* ArgPtr = Builder.CreatePointerCast(ArgAlloca, Type::getInt32PtrTy(Context));

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), { ArgPtr }, "", BB);

     
    Use& U = *CI->user_begin();

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    if (dyn_cast<IntrinsicInst>(CI) && CI->getIntrinsicID() == Intrinsic::memcpy) {
         
        F->addParamAttr(0, Attribute::NoCapture);

         
        legacy::FunctionPassManager FPM(&M);
        FPM.add(createPromoteMemoryToRegisterPass());
        FPM.run(*F);
    }

    std::cout << "Module after optimization:\n" << M;

    return 0;
}
