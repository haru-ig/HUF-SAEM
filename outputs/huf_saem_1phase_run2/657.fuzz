#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Argument *A = &*F->arg_begin();
    A->setName("arg");

     
    CallInst *CI = CallInst::Create(FTy, F, {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    F->setNoUnwind();
    assert(!CI->doesNotThrow() && "CallInst must not be marked as no-throw.");

     
    Intrinsic::ID ID = Intrinsic::not_an_intrinsic;  
    CallInst *IntrCI = CallInst::Create(FunctionType::get(Type::getVoidTy(Context), {Type::getInt32PtrTy(Context)}, false), Intrinsic::getDeclaration(&Mod, ID), {}, "", BB);
    assert(dyn_cast<IntrinsicInst>(IntrCI) && "CallInst must be an intrinsic call.");

     
    AnyMemIntrinsic *AnyMI = dyn_cast<AnyMemIntrinsic>(IntrCI);
    assert(AnyMI && "Memory intrinsic expected.");
    Value *NumBytes = ConstantInt::get(Type::getInt32Ty(Context), 0);  
    assert(NumBytes->isZero() || !NumBytes->isMultipleOf(4) && "Memory intrinsic length must be non-positive or not a multiple of element size.");

     
    std::cout << "Test passed!" << std::endl;
    return 0;
}
