#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Use.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "func", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Argument* Arg = &F->getArgumentList().front();
    Arg->setName("arg");
    Arg->addAttr(Attribute::Returned);

     
    Intrinsic::ID IntrID = Intrinsic::not_an_intrinsic;  
    if (Intrinsic::isSupported(IntrID)) {
        Value* Args[] = {Arg};
        CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), makeArrayRef(Args), "", BB);

         
        if (!CI->use_empty()) {
             
            F->setDoesNotThrow();
            F->addFnAttr(Attribute::NoUnwind);

             
            if (IntrinsicInst* IIC = dyn_cast<IntrinsicInst>(CI)) {
                if (IIC->isAnyMemIntrinsic()) {
                    Value* Op0 = ConstantInt::get(Type::getInt32Ty(Context), 0);
                    CallInst* NewCI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), makeArrayRef({Op0}), "", BB);

                     
                    if (!NewCI->use_empty()) {
                         
                    }
                }
            }
        }
    }

     
    M.print(outs(), nullptr);

    return 0;
}
