#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_function", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::anymemintrinsic), { Arg }, "", BB);

     
    if (!CI->use_empty()) {
        std::cerr << "CallInst must have at least one use to trigger simplification." << std::endl;
        return 1;
    }

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (!dyn_cast<IntrinsicInst>(CI)) {
        std::cerr << "CallInst must be an intrinsic call." << std::endl;
        return 1;
    }

     
    SimplifyQuery SQ(F->getContext());
    Value *Simplified = llvm::simplifyInstruction(CI, SQ);

    if (!Simplified) {
        std::cerr << "Failed to simplify CallInst." << std::endl;
        return 1;
    }

     
    Simplified->print(outs());

    return 0;
}
