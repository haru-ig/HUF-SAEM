#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg1 = new Argument(Type::getInt32Ty(Context), "arg1", (Function *)nullptr);
    Arg1->setParamAttr(0, AttributeSet::getIndexedParamAttribute(F, 0, Attribute::Returned));
    F->getArgumentList().push_back(Arg1);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context)}, {}, "", BB);
    CI->setDoesNotThrow();  

     
    CI->addUse(F->getArg(0));  

     
    F->setDoesNotThrow();

     
    std::cout << "Function: " << *F << "\n";
    std::cout << "CallInst: " << *CI << "\n";

    return 0;
}
