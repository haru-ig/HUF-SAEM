#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>

using namespace llvm;

 
void exampleFunction(Value *arg) {
    std::cout << "Example function called with argument: " << arg->getName() << "\n";
}

int main() {
    LLVMContext Context;
    Module module("testModule", Context);
    
     
    FunctionType *funcType = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32PtrTy(Context), false);
    Function *func = Function::Create(funcType, Function::ExternalLinkage, "exampleFunc", module);
    
     
    BasicBlock *entryBB = BasicBlock::Create(Context, "", func);
    
     
    Value *arg = new Argument(Type::getInt32Ty(Context), "arg", entryBB);
    
     
    CallInst *CI = CallInst::Create(func, arg, "", entryBB);
    
     
    CI->addUse(CI->getType(), 1);
    
    std::cout << "CallInst created with type: " << CI->getType()->getDescription() << "\n";
    
    return 0;
}
