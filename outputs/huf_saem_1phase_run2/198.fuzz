#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    ConstantInt *Const1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    ConstantInt *Const2 = ConstantInt::get(Type::getInt32Ty(Context), 2);

     
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, Const1, Const2, "", BB->getFirstInsertionBlock()->getTerminator());
    Value *TrueVal = Const1;
    Value *FalseVal = Const2;
    SelectInst *SI = SelectInst::Create(CondVal, TrueVal, FalseVal, "", BB->getFirstInsertionBlock()->getTerminator());

     
    assert(SI && "Select instruction creation failed");
    assert(CondVal->getType() == Type::getInt32Ty(Context) && "Condition type mismatch");
    assert(TrueVal->getType() == Type::getInt32Ty(Context) && "True value type mismatch");
    assert(FalseVal->getType() == Type::getInt32Ty(Context) && "False value type mismatch");

     
    std::cout << M;

    return 0;
}
