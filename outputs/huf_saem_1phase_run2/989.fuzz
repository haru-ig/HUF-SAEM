#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *ConstVal = ConstantInt::get(Type::getInt32Ty(Context), 5);

     
    CallBase *CI;
    if (true) {  
        CI = CallInst::Create(nullptr, {}, "", BB);
        IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
        assert(II && "Expected an intrinsic call");
        AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
        assert(AMII && "Expected a memory intrinsic call");
    }

     
    if (!CI->use_empty()) {
        CI->setArgOperand(0, ConstVal);  
    }

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow();

     
    if (AMII) {
        uint64_t NumBytes = 0;  
        if (NumBytes > 0 && !(NumBytes % sizeof(int32_t) == 0)) {
             
        }
    }

     
    M.print(outs(), nullptr);

    return 0;
}
