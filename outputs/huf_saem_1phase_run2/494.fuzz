#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Function *F = Function::Create(FunctionType::get(Type::getVoidTy(Context), {}, false), GlobalValue::ExternalLinkage, "test", &TheModule);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Args[1] = {ConstantInt::get(Type::getInt32Ty(Context), 0)};
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&TheModule, Intrinsic::memset), Args, "", BB);

     
    if (CI->use_empty()) {
        CI->addUse(Type::getInt32Ty(Context), nullptr);
    }

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        Intrinsic::ID ID = dyn_cast<IntrinsicInst>(CI)->getIntrinsicID();
        if (ID == Intrinsic::memset) {
             
            CI->setArgOperand(2, ConstantInt::get(Type::getInt32Ty(Context), 0));
        }
    }

     
    F->print(errs());
    BB->print(errs());

    return 0;
}
