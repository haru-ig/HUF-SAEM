#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.hpp>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function* F = Function::Create(FT, Function::ExternalLinkage, "foo", M);
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    
     
    Value* Args[] = {ConstantInt::get(Type::getInt32Ty(Context), 1)};
    CallBase* CI = CallBase::Create(Intrinsic::getDeclaration(M, Intrinsic::memset), {}, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    
     
    if (!CI->use_empty()) {
        std::cout << "CallInst has at least one use.\n";
    } else {
        std::cout << "CallInst does not have any uses.\n";
    }
    
    if (F->doesNotThrow()) {
        std::cout << "Function is marked as nounwind.\n";
    } else {
        std::cout << "Function is not marked as nounwind.\n";
    }
    
    if (dyn_cast<IntrinsicInst>(CI) && dyn_cast<IntrinsicInst>(CI)->getIntrinsicID() == Intrinsic::memset) {
        std::cout << "CallInst is an intrinsic call and specifically a memory intrinsic.\n";
    } else {
        std::cout << "CallInst is not an intrinsic call or not specific to memory intrinsics.\n";
    }
    
     
     
    
    return 0;
}
