#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Callee = M.getOrInsertFunction("llvm.sqrt", FTy).getCallee();
    CallInst *CI = CallInst::Create(Callee, {}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use.");
    assert(!F->doesNotThrow() && "Function must be marked as nounwind.");

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, CI, ConstantInt::get(Type::getInt32Ty(Context), 2));
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    assert(SI->hasOneUse() && "SelectInst must have at least one use.");
    assert(SI->getType()->isIntegerTy() && "SelectInst type should be integer.");

     
    BasicBlock *Preheader = BB;
    BasicBlock *Header = BasicBlock::Create(Context, "", F);
    BasicBlock *Latch = BasicBlock::Create(Context, "", F);
    BranchInst::Create(Header, Latch, SI, Preheader);

     
    assert(Preheader && "Loop must have a preheader block.");
    assert(Latch && "Loop must have a latch block.");

    std::cout << "Test setup completed.\n";
    return 0;
}
