#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Support/raw_ostream.h>

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", M);

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    AllocaInst *Alloca = new AllocaInst(Type::getInt32Ty(Context), 0, "", BB);
    Value *ArgList[] = { ConstantInt::get(Type::getInt64Ty(Context), 16), Builder.CreateBitCast(Alloca, Type::getInt8PtrTy(Context)), ConstantInt::get(Type::getInt64Ty(Context), 4) };
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memcpy), makeArrayRef(ArgList), "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwindBehavior(Function::Unwind);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "The instruction is an intrinsic call.\n";
    } else {
        errs() << "Not an intrinsic call.\n";
    }

     
    if (!CI->use_empty()) {
        errs() << "The call instruction has at least one use.\n";
    } else {
        errs() << "No uses of the call instruction.\n";
    }

     
    M->print(errs(), nullptr);

    delete M;
    return 0;
}
