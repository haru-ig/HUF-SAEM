#include <iostream>
int main() {
#include <llvm/IR/Instructions.h>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallInst *CI = CallInst::Create(F, { ConstantInt::get(Type::getInt32Ty(Context), 5) }, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setUnwind(false);
    
     
    Intrinsic::ID IntrID = Intrinsic::sqrt;
    CallInst *IntrCI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), { CI }, "", BB);
    
     
    if (dyn_cast<IntrinsicInst>(IntrCI)) {
         
    }
    
     
    std::cout << "Generated function: " << *F << "\n";
    std::cout << "CallInst in function: " << *CI << "\n";
    std::cout << "Intrinsic call: " << *IntrCI << "\n";
    
    return 0;
}
