#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/SimplifyIndVar.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "foo", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(nullptr, Callee, {}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwindPredecessor(BB);

     
    IntrinsicInst *II = CallInst::Create(Intrinsic::any_mem_intrinsic, {CI}, "", BB);

     
    if (auto *AMII = dyn_cast<AnyMemIntrinsic>(II)) {
        if (!AMII->isZeroLength()) {
            errs() << "Intrinsic has non-zero length.\n";
        }
    } else {
        errs() << "Not an AnyMemIntrinsic.\n";
    }

     

    return 0;
}
