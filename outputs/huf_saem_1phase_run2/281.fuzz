#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/LoopUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::anymem_intrinsic), { ConstantInt::get(Type::getInt32Ty(Context), 0) }, "", BB);

     
    CI->addUse(F->getArg(0));

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    Loop *L = new Loop;
    L->initialize(BB);

     
     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), -1);
    SelectInst *SI = new SelectInst(ConstantInt::get(Type::getInt1Ty(Context), true), TrueVal, FalseVal, "", BB);

     

    return 0;
}
