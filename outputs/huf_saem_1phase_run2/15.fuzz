#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Scalar/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    
     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function* F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", Module.get());
    
     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    
     
    Argument* Arg = &(*F->arg_begin());
    Arg->addAttr(Attribute::Returned);
    
     
    Value* Zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    std::vector<Value*> Args;
    Args.push_back(Zero);
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::abs, { Type::getInt32Ty(Context) }), Args, "", BB);
    
     
    Use& U = CI->use_begin();
    assert(!U.getUser()->use_empty() && "CallInst must have at least one use");
    
     
    F->setDoesNotThrow(false);
    F->addFnAttr(Attribute::NoUnwind);
    
     
    IntrinsicInst* II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    AnyMemIntrinsic* AMI = dyn_cast<AnyMemIntrinsic>(II);
    assert(AMI && "Intrinsic must be a memory intrinsic");
    
     
    if (AMI->isZeroLength()) {
         
    } else {
         
    }
    
     
    if (!CI->use_empty()) {
        std::unique_ptr<CallInst> SimplifiedCI = simplifyCall(CI);
        if (SimplifiedCI) {
            CI->replaceAllUsesWith(SimplifiedCI.get());
            CI->eraseFromParent();
            CI = SimplifiedCI.release();
        }
    }
    
     
    assert(F->hasFnAttr(Attribute::NoUnwind) && "Function must be marked as nounwind");
    assert(!CI->doesNotThrow() && "CallInst itself must not be marked as nounwind");
    
     
    
    std::cout << "Test passed!" << std::endl;
    return 0;
}
