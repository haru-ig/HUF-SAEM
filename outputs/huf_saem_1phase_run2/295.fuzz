#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), IntegerType::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(IntegerType::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "CallInst is an intrinsic call.\n";
    } else {
        errs() << "CallInst is not an intrinsic call.\n";
    }

     
    M.print(errs(), nullptr);

    return 0;
}
