#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/Transforms/Utils/Cloning.h>
#include <llvm/Transforms/Scalar/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Arg}, "", BB);
    assert(!CI->use_empty() && "The CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::Nounwind);
    CI->setDoesNotThrow();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        IntrinsicInst *II = cast<IntrinsicInst>(CI);
        if (II->getIntrinsicID() == Intrinsic::memcpy) {
             
            assert(CI->getFunction()->isNounwind());
            assert(!CI->doesNotThrow());
            assert(dyn_cast<IntrinsicInst>(CI));
            assert(II->getIntrinsicID() == Intrinsic::memcpy);
        }
    }

     

    return 0;
}
