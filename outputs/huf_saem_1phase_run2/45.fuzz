#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);
    
     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");
    
     
    CallBase *CI;
    if (true) {
        CI = CallBase::Create(Intrinsic::getDeclaration(&M, Intrinsic::anymem_intrinsic), {}, "", BB);
    } else {
         
        return 1;
    }
    
     
    CI->addUse(Type::getInt32Ty(Context));
    
     
    F->setDoesNotThrow();
    F->setUnwindDest(&*F->begin());
    
     
    if (!isa<CallBase>(CI)) {
        return 1;
    }
    
     
    BB->print(errs());
    
    return 0;
}
