#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, GlobalValue::InternalLinkage, "test_func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");
    Arg->setReturnValueAttr(Attribute::Returned);
    
     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    if (dyn_cast<IntrinsicInst>(CI)) {
        auto *IMI = dyn_cast<AnyMemIntrinsic>(CI);
        assert(IMI && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");
        
         
        if (IMI->isZeroLength()) {
             
        } else {
             
        }
    }
    
     
    auto *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");
    
     
    auto *IRP = IRPosition::callsite_argument(*CB);
    assert(IRP.getPositionKind() == IRP_CALL_SITE_ARGUMENT && "IRPosition must have the correct position kind");
    
     
    auto *AssocFunc = IRP.getAssociatedFunction();
    assert(AssocFunc && "Function associated with IRPosition must be non-null");
    
     
    
    return 0;
}
