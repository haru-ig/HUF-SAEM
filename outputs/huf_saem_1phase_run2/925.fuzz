#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function* F = Function::Create(FT, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memset), {}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked with 'nounwind'");

     
    if (auto* II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memset) {
             
        }
    }

     
    std::cout << "Function: " << F->getName().str() << "\n";
    std::cout << "CallInst in function: " << CI->getFunction()->getName().str() << "\n";

    return 0;
}
