#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    CallInst *CI = CallInst::Create(F->getFunctionType(), F, {Arg1}, "", BB);
    
     
    if (CI->use_empty()) {
        std::cerr << "CallInst does not have any uses. Test aborted." << std::endl;
        return 1;
    }
    
     
    assert(!F->doesNotThrow() && "Function must be marked as nounwind");
    
     
    Intrinsic::ID MemIntrinsicID = Intrinsic::not_an_intrinsic;  
    if (MemIntrinsicID == Intrinsic::not_an_intrinsic) {
        std::cerr << "Invalid intrinsic ID. Test aborted." << std::endl;
        return 1;
    }
    
    CallInst *MemCI = CallInst::Create(FunctionType::get(Type::getVoidTy(Context), {}, false), Intrinsic::getDeclaration(Module.get(), MemIntrinsicID), {Arg1}, "", BB);
    if (!dyn_cast<IntrinsicInst>(MemCI)) {
        std::cerr << "CallInst is not an intrinsic call. Test aborted." << std::endl;
        return 1;
    }
    
     
    CallBase *CB = dyn_cast<CallBase>(MemCI);
    if (!CB) {
        std::cerr << "Context instruction is not a CallBase. Test aborted." << std::endl;
        return 1;
    }
    
     
    
    std::cout << "All constraints satisfied." << std::endl;
    return 0;
}
