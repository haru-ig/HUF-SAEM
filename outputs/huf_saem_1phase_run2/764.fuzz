#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    Argument *Arg = F->getArg(0);
    Arg->addAttr(Attribute::Returned);

     
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 1);
    CallInst *CI = CallInst::Create(F, Callee, "", nullptr);

     
    Use &U = F->use_begin();
    assert(!CI.use_empty() && "CallInst must have at least one use");

     
    Function *Func = &M.getFunction("testFunc");
    Func->setDoesNotThrow();
    Func->removeFnAttr(Attribute::WillReturn);
    Func->addFnAttr(Attribute::Nounwind);

     
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::any_mem_intrinsic, CI, "", nullptr);
    assert(II && "CallInst must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase");

     
    M.print(outs(), nullptr);

    return 0;
}
