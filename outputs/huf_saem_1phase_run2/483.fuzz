#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Transforms/Utils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Args[1] = {ConstantInt::get(Type::getInt32Ty(Context), 42)};
    CallInst *CI = CallInst::Create(nullptr, Args, "call_inst", BB);

     
    CI->addUse(F->getArgList().front());

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    Intrinsic::ID IID = Intrinsic::not_an_intrinsic;  
    CI->setCalledFunction(Intrinsic::getDeclaration(&M, static_cast<Intrinsic::ID>(IID)));

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        switch (II->getIntrinsicID()) {
            case Intrinsic::memset:
            case Intrinsic::memcpy:
            case Intrinsic::memmove:
                 
                break;
            default:
                llvm_unreachable("Unsupported intrinsic");
        }
    } else {
        llvm_unreachable("Not an intrinsic call");
    }

     
    std::cout << "Generated LLVM IR:\n";
    M.print(outs(), nullptr);

    return 0;
}
