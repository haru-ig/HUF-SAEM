#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Dominators.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Transforms/Utils/LoopUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();

     
    Value *Vec = UndefValue::get(VectorType::get(IntegerType::getInt32Ty(Context), 4));
    Vec = InsertElementInst::Create(Vec, Arg, ConstantInt::get(IntegerType::getInt32Ty(Context), 0), "", BB);

     
    CallInst *CI = CallInst::Create(nullptr, Vec, {}, "", BB);

     
    CI->addUse(F->getArg(0));

     
    F->setDoesNotThrow();
    F->setUnwindDest(&*F->begin()->getContext());

     
    IntrinsicInst *AnyMemIntrinsic = IntrinsicInst::Create(Instruction::Call, CI, {Arg}, "", BB);

     
    assert(dyn_cast<AnyMemIntrinsic>(AnyMemIntrinsic));

     

    return 0;
}
