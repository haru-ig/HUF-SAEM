#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::Nounwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Args[1] = { ConstantInt::get(Type::getInt32Ty(Context), 42) };
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memset), Args, "", BB);

     
    CI->addUse(Value::use_iterator());

     
    M.print(errs(), nullptr);

    return 0;
}
