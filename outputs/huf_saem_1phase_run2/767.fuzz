#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>

using namespace llvm;

int main() {
  LLVMContext Context;
  Module M("test", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getVoidTy(Context), false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);

   
  BasicBlock *BB = BasicBlock::Create(Context, "", F);

   
  CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {}, "", BB);

   
  F->setDoesNotThrow();
  CI->setDoesNotThrow();

   
  assert(!CI->use_empty() && "CallInst must have at least one use");

   
  F->addFnAttr(Attribute::NoUnwind);

   
  if (dyn_cast<IntrinsicInst>(CI)) {
    std::cout << "Intrinsic call detected." << std::endl;
  } else {
    std::cout << "No intrinsic call detected." << std::endl;
  }

  return 0;
}
