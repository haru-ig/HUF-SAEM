#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");
    Arg->setParamAttribute(0, AttributeSet::ReturnIndex, Attribute::Returned);
    
     
    CallInst *CI = CallInst::Create(FTy, F, {Arg}, "", BB);
    
     
    if (CI->use_empty()) {
        CI->addUse(*F->arg_begin());
    }
    
     
    F->setDoesNotThrow();
    F->setUnwind(false);
    
     
    if (!dyn_cast<AnyMemIntrinsic>(CI)) {
        CI = new AnyMemIntrinsic(CI->getOpcode(), Type::getInt8Ty(Context), {Arg}, "", BB);
    }
    
     
    assert(!F->hasFnAttr(Attribute::NoUnwind) && "Function should be marked as nounwind");
    
     
    M->print(errs(), nullptr);
    
    return 0;
}
