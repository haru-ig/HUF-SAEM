#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getVoidTy(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Args[] = { ConstantInt::get(Type::getInt32Ty(Context), 1) };
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::memcpy, Type::getInt8PtrTy(Context)), Args, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        auto *IMI = dyn_cast<AnyMemIntrinsic>(CI);
        assert(IMI && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

         
        if (IMI->isAtomic() && !IMI->isVolatile()) {
            int64_t NumBytes = IMI->getLength();
            assert(NumBytes <= 0 || NumBytes % sizeof(int8_t) != 0, "Length must be non-positive or not a multiple of the element size");
        }
    }

     
    if (auto *CB = dyn_cast<CallBase>(CI)) {
        auto IRPos = IRPosition::callsite_argument(CB);
        assert(IRPos.getPositionKind() == IRPosition::IRP_CALL_SITE_ARGUMENT, "Context instruction must be a CallBase instance");
    }

     

    return 0;
}
