#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI;
    if (true) {  
        CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::any_mem_intrinsic), {Arg}, "", BB);
        assert(!CI->use_empty() && "CallInst must have at least one use");
    }

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI)) {
        assert(II->getIntrinsicID() == Intrinsic::any_mem_intrinsic && "CallInst must be an intrinsic");
    }

     
    M.print(errs(), nullptr);

    return 0;
}
