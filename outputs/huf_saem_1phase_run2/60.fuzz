#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Intrinsic::ID IntrID = Intrinsic::memcpy;
    Value *Args[] = {
        ConstantExpr::getPointerNull(Type::getInt8PtrTy(Context)),
        ConstantExpr::getPointerNull(Type::getInt8PtrTy(Context)),
        Builder.getInt64(0)
    };
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), makeArrayRef(Args), "", BB);

     
    CI->addUse(F->arg_begin());

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "CallInst is an intrinsic call.\n";
    } else {
        errs() << "CallInst is not an intrinsic call.\n";
    }

     
    if (F->doesNotThrow()) {
        errs() << "Function is marked as nounwind.\n";
    } else {
        errs() << "Function is not marked as nounwind.\n";
    }

     
    if (!CI->doesNotThrow()) {
        errs() << "CallInst is not marked as nounwind.\n";
    } else {
        errs() << "CallInst is marked as nounwind.\n";
    }

     
    F->print(errs());

    return 0;
}
