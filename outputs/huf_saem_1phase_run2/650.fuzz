#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    ConstantInt *C1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    ConstantInt *C2 = ConstantInt::get(Type::getInt32Ty(Context), 2);
    Value *Args[] = {C1};

     
    CallInst *CI = CallInst::Create(F, Args, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    IntrinsicInst *II = IntrinsicInst::get(CI, Intrinsic::any_mem_intrinsic, {}, BB);

     
    II->setAtomicOrdering(::llvm::AtomicOrdering::NotAtomic);

     
    M.print(outs(), nullptr);

    return 0;
}
