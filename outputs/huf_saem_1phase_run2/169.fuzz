#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 0)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow();

     
    CallInst *AnyMemIntrinsicCI = CallInst::CreateIntrinsic(Intrinsic::any_mem, {Type::getInt8PtrTy(Context), Type::getInt32Ty(Context)}, "", BB);
    assert(dyn_cast<IntrinsicInst>(AnyMemIntrinsicCI) && "CallInst must be an intrinsic call");
    auto *AMII = cast<AnyMemIntrinsic>(AnyMemIntrinsicCI);
    assert(AMII->getLength() <= 0 || !((AMII->getLength() % AMII->getElementSize()) == 0) && "Length must be non-positive or not a multiple of the element size");

     
    assert(isa<CallBase>(CI) && "Context instruction must be a CallBase");

     
     

    return 0;
}
