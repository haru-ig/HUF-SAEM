#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Module.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = &*F->arg_begin();   
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(nullptr, { Arg }, "", BB);
    CI->setCalledFunction(Intrinsic::getDeclaration(Module.get(), Intrinsic::any_mem_intrinsic));

     
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst should not be marked as no-throw");

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ICmpInst::create(ICmpInst::Predicate::ult, Arg, ConstantInt::get(Type::getInt32Ty(Context), 2), "", BB);
    SelectInst *SI = new SelectInst(CI->getType(), FalseVal, TrueVal, "cond_select", BB);

     
    assert(SI->getType()->isIntegerTy() && "SelectInst type should be integer");
    assert(!SI->getType()->isVectorTy() && "SelectInst type should not be vector");

     
    Module->print(errs(), nullptr);

    return 0;
}
