#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "main", M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0);
    std::vector<Value *> Args;
    Args.push_back(Arg);
    CallInst *CI = CallInst::Create(FunctionCallee(), Args, "", BB);
    
     
    CI->addUse(Type::getInt32Ty(Context));
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI)) {
        if (AnyMemIntrinsic *AM = dyn_cast<AnyMemIntrinsic>(II)) {
            Value *Ptr = ConstantPointerNull::get(Type::getInt8PtrTy(Context));
            AM->setArgOperand(0, Ptr);
            
             
            uint64_t NumBytes = 0;
            if (AM->mayReadOrWriteFromMemory()) {
                NumBytes = AM->getAllocatedTypeSize();
                if (NumBytes > 0 && !AM->isAtomic() && !AM->isVolatile()) {
                     
                }
            }
        }
    }
    
     
    F->setNoUnwind();
    
     
    M->print(llvm::errs(), nullptr);
    
    delete M;
    return 0;
}
