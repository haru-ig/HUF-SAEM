#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "foo", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::abs), {}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setUnwindPredecessor(BB);

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::abs) {
             
            auto *NumBytes = II->getArgOperand(0);
            if (!NumBytes || !NumBytes->isZero()) {
                return 1;  
            }
        }
    } else {
        return 1;  
    }

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
