#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyLibCalls.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = &*(F->arg_begin());
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::anymemintrinsic), { Arg }, "", BB);
    
     
    CI->addUse(F->getArgNo(0));
    
     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);
    F->setUnnamedAddr(GlobalValue::UnnamedAddr::None);
    F->addFnAttr(Attribute::NoUnwind);
    
     
    if (dyn_cast<IntrinsicInst>(CI)) {
        Intrinsic::ID IID = CI->getIntrinsicID();
        assert((IID == Intrinsic::anymemintrinsic && "Expected AnyMemIntrinsic"));
        
         
        if (IID == Intrinsic::atomicrmw || IID == Intrinsic::cmpxchg) {
            Value *NumBytes = ConstantInt::get(Type::getInt32Ty(Context), 0);  
            assert(NumBytes->getLimitedValue() <= 0 && "Expected non-positive length or not a multiple of element size");
        }
    }
    
     
    
    std::cout << "Module built successfully with test call instruction." << std::endl;
    
    return 0;
}
