#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

 
Value* createIntrinsicCall(LLVMContext &Ctx, Module &M) {
    Function *F = Intrinsic::getDeclaration(&M, Intrinsic::memcpy);
    CallInst *CI = CallInst::Create(F, {}, "", nullptr);
    return CI;
}

int main() {
    LLVMContext Ctx;
    Module M("test_module", Ctx);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Ctx), {}, false);
    Function *F = cast<Function>(M.getOrInsertFunction("test_func", FTy));
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    CallInst *CI = createIntrinsicCall(Ctx, M);
    BasicBlock *BB = BasicBlock::Create(Ctx, "", F);
    IRBuilder<> Builder(BB);
    Builder.CreateRet(ConstantInt::get(Type::getInt32Ty(Ctx), 0));

     
    BB->begin()->insert(BB->begin(), CI);
    assert(!CI.use_empty() && "CallInst must have at least one use");

     
    assert((F->getFnAttr(Attribute::NoUnwind) || F->doesNotThrow()) && "Function must be marked as nounwind or call should not throw");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::memcpy && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     

    std::cout << "All constraints satisfied!" << std::endl;
    return 0;
}
