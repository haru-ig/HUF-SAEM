#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", &M);
    F->addArgAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    IntrinsicInst *CI = CallInst::Create(Intrinsic::memset, {}, "", BB);
    CI->setOperand(0, ConstantInt::get(IntegerType::getInt32Ty(Context), 0));
    CI->setOperand(1, ConstantInt::get(IntegerType::getInt64Ty(Context), 8));
    CI->setOperand(2, ConstantInt::get(IntegerType::getInt32Ty(Context), 1));

     
    BB->push_back(CI);

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    if (auto *II = dyn_cast<AnyMemIntrinsic>(CI)) {
        assert(!II->isZeroLength() && "Expected non-zero length operation");
    } else {
        errs() << "Expected an intrinsic call\n";
        return 1;
    }

     

    return 0;
}
