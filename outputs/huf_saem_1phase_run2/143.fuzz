#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/Instructions.h"
#include "llvm/IR/IntrinsicInst.h"
#include "llvm/IR/Constants.h"
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getVoidTy(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Intrinsic::ID IID = Intrinsic::memcpy;  
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), IID), {}, "", BB);

     
    if (CI->use_empty()) {
        CI->addUse(Type::getVoidTy(Context));
    }

     
    F->setDoesNotThrow();
    F->removeFnAttr(Attribute::NoUnwind);

     
    if (!isa<IntrinsicInst>(CI)) {
        std::cerr << "Expected an intrinsic instruction!" << std::endl;
        return 1;
    }

     
    for (auto &BB : *F) {
        for (auto &I : BB) {
            if (auto *Arg = dyn_cast<Argument>(&I)) {
                if (Arg->hasAttribute(llvm::Attribute::Returned)) {
                    std::cout << "Found argument with returned attribute!" << std::endl;
                }
            }
        }
    }

     
    Loop *L = nullptr;  
    if (L && L->isSafeToClone() && !L->getHeader()->hasAddressTaken()) {
        unsigned unrollCount = 4;
        LoopUnrollOptions ULO;
        ULO.setCount(unrollCount);
        if (ULO.Count > 0) {
            L->unroll(ULO);
        }
    }

     
    Mod->print(outs(), nullptr);

    return 0;
}
