#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Transforms/Utils.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

 
void createModule(Module &M) {
   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(M.getContext()), {}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "main", M);
  BasicBlock *BB = BasicBlock::Create(M.getContext(), "", F);

   
  CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {}, "", BB);
  assert(!CI->use_empty() && "CallInst must have at least one use");
  assert(F->doesNotThrow() && "Function must be marked as nounwind");
  assert(dyn_cast<IntrinsicInst>(&CI) && "CallInst must be an intrinsic call");
  IntrinsicInst *II = dyn_cast<IntrinsicInst>(&CI);
  assert(II->getIntrinsicID() == Intrinsic::memcpy && "CallInst must be memcpy intrinsic");

   
  if (II->getIntrinsicID() == Intrinsic::memcpy) {
    Value *NumBytes = ConstantInt::get(Type::getInt32Ty(M.getContext()), 16);
    assert(cast<ConstantInt>(NumBytes)->getValue().isNonNegative() && "NumBytes must be non-negative for memcpy intrinsic");
  }

   
  Value *TrueVal = ConstantInt::get(Type::getInt32Ty(M.getContext()), APInt(32, 1));
  Value *FalseVal = ConstantInt::get(Type::getInt32Ty(M.getContext()), APInt(32, 2));
  SelectInst *SI = new SelectInst(ConstantInt::getTrue(), TrueVal, FalseVal, "", BB);
  assert(SI->getType()->isIntegerTy() && "SelectInst must be of integer type");
  assert(SI->getCondition()->getType()->isIntegerTy() && "Condition of SelectInst must be an integer type");
  assert(SI->getTrueValue()->getType()->isIntegerTy() && "True value of SelectInst must be an integer type");
  assert(SI->getFalseValue()->getType()->isIntegerTy() && "False value of SelectInst must be an integer type");

   
  ICmpInst *Cmp = ICmpInst::Create(ICmpInst::ICMP_ULT, TrueVal, ConstantInt::get(Type::getInt32Ty(M.getContext()), 2), "", BB);
  SI->setCondition(Cmp);

   
  assert(!isa<SelectInst>(SI) && "simplifySelectInst should not have simplified the SelectInst");
  assert(!isSimpleValsForShuffle(SI) && "canonicalizeSelectToShuffle should not have transformed the SelectInst");
  assert(!isScalarOfVecs(SI) && "canonicalizeScalarSelectOfVecs should not have transformed the SelectInst");
}

int main() {
  LLVMContext Context;
  Module M("test", Context);
  createModule(M);
  return 0;
}
