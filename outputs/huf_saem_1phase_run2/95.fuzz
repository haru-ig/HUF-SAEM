#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/CallSite.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());
    F->addFnAttr(Attribute::NoUnwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttr(Attribute::Returned);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::any_mem_intrinsic), {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use.");
    assert(!CI->doesNotThrow() && "CallInst must not be marked as nounwind.");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call.");
    IntrinsicInst *AII = cast<IntrinsicInst>(CI);
    assert(AII->getIntrinsicID() == Intrinsic::any_mem_intrinsic && "Must be an AnyMemIntrinsic.");

     
    legacy::PassManager Passes;
    Passes.add(createInstructionSimplifierPass());
    Passes.run(*Mod);

     
    Mod->print(errs(), nullptr);

    return 0;
}
