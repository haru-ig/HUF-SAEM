#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

void generateTestCode() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    FunctionCallee Callee = M.getOrInsertFunction("llvm.memcpy.p0i8.p0i8.i64", Type::getVoidTy(Context),
                                                 PointerType::get(Type::getInt8Ty(Context), 0),
                                                 PointerType::get(Type::getInt8Ty(Context), 0),
                                                 ConstantInt::get(Type::getInt64Ty(Context), 8));
    CallInst *CI = Builder.CreateCall(Callee, {Arg, Arg}, "", BB);

     
    CI->addUse(*F->arg_begin());

     
    F->setDoesNotThrow();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "CallInst is an intrinsic call\n";
    } else {
        errs() << "CallInst is not an intrinsic call\n";
    }

     
    if (auto *II = dyn_cast<AnyMemIntrinsic>(CI)) {
        if (II->getNumElements() <= 0 || II->getNumElements() % 8 != 0) {
            errs() << "Length condition met\n";
        } else {
            errs() << "Length condition not met\n";
        }
    }

     
    M.print(errs(), nullptr);
}

int main() {
    generateTestCode();
    return 0;
}
