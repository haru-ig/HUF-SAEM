#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function* F = Function::Create(FT, GlobalValue::InternalLinkage, "testFunc", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Value* Arg = F->getArg(0);

     
    CallInst* CI;
    if (F->isVarArg()) {
        std::vector<Value*> Args = {Arg};
        CI = CallInst::Create(FT, F, Args, "", BB);
    } else {
        CI = CallInst::Create(FT, F, "", BB);
    }

     
    Use &U = *CI->use_begin();

     
    assert(!F->doesNotThrow() && "Function should not be nounwind");

     
    if (IntrinsicInst* IIC = dyn_cast<IntrinsicInst>(CI)) {
        if (IIC->getIntrinsicID() == Intrinsic::memset) {
             
            Value* Size = ConstantInt::get(Type::getInt32Ty(Context), 4);
            CI->setArgOperand(1, Size);
        }
    }

     
    M.print(errs(), nullptr);

    return 0;
}
