#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &Mod);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(F->getFunctionType(), F, {Arg}, "", BB);

     
    CI->addUse(F->getParamType(0));

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *II = CallInst::Create(Intrinsic::any_memory, {}, "", BB);

     
    II->setDoesNotThrow();
    II->setNoUnwind();

     
    Mod.print(outs(), nullptr);

    return 0;
}
