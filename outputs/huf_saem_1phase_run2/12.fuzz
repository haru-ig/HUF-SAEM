#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *VecVal = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    VecVal = InsertElementInst::Create(VecVal, ConstantInt::get(Type::getInt32Ty(Context), 1), ConstantInt::get(Type::getInt32Ty(Context), 0), "", BB);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, {VecVal->getType(), VecVal}, {VecVal, ConstantInt::get(Type::getInt32Ty(Context), 0), ConstantInt::get(Type::getInt32Ty(Context), 4)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    IntrinsicInst *Intr = dyn_cast<IntrinsicInst>(CI);
    assert(Intr && Intr->getIntrinsicID() == Intrinsic::memset && "CallInst must be an intrinsic call for memory operations");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     
    auto IRPos = IRPosition::callsite_argument(CI, 0);
    assert(IRPos.getPositionKind() == IRP_CALL_SITE_ARGUMENT && "IRPosition must have the correct position kind");

     
    Function *Func = F;
    assert(Func && "Function associated with the IRPosition must be non-null");

     

    std::cout << "Test passed successfully!" << std::endl;
    return 0;
}
