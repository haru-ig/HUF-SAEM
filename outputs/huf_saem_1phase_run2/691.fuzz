#include <iostream>
int main() {
  

 

#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Scalar/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), false), GlobalValue::ExternalLinkage, "testFunc", Mod.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(Callee, {}, "", BB);
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *AnyMem = Intrinsic::anymem_intrinsic;  
    CallInst *IntrCall = CallInst::Create(AnyMem, {CI}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind and does not throw");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(IntrCall) && "Intrinsic call must be of type AnyMemIntrinsic");

     
    new SimplifyCFGPass( ).run(*BB, *F);

    std::cout << "Test case generated successfully!" << std::endl;
    return 0;
}
