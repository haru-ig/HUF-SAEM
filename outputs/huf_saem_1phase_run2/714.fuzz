#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/Instructions.h"
#include "llvm/IR/Intrinsics.h"
#include "llvm/IR/Constants.h"
#include <iostream>

using namespace llvm;

int main() {
  LLVMContext Context;
  std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", Mod.get());
  F->addFnAttr(Attribute::Nounwind);

   
  BasicBlock *BB = BasicBlock::Create(Context, "", F);

   
  CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::memset), {Constant::getNullValue(Type::getInt8PtrTy(Context))}, "", BB);
  assert(!CI->use_empty() && "CallInst must have at least one use");

   
  if (dyn_cast<AnyMemIntrinsic>(CI) && dyn_cast<IntrinsicInst>(CI)->getIntrinsicID() == Intrinsic::memset) {
    std::cout << "CallInst is valid for memory intrinsic handling." << std::endl;
  } else {
    std::cout << "CallInst does not match the required intrinsic type." << std::endl;
  }

   

  return 0;
}
