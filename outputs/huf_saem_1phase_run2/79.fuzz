#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallBase *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), { Arg }, "", BB);

     
    if (CI->use_empty()) {
        std::cerr << "Error: CallInst does not have any uses." << std::endl;
        return 1;
    }

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    if (!isa<IntrinsicInst>(CI)) {
        std::cerr << "Error: CallInst is not an intrinsic call." << std::endl;
        return 1;
    }
    IntrinsicInst *II = cast<IntrinsicInst>(CI);
    if (!II->isMemIntrinsic()) {
        std::cerr << "Error: CallInst is not a memory intrinsic." << std::endl;
        return 1;
    }

     
    if (!isa<CallBase>(CI)) {
        std::cerr << "Error: Context instruction is not a CallBase." << std::endl;
        return 1;
    }

     
    M.print(llvm::outs(), nullptr);

    return 0;
}
