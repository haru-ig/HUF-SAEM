#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/BasicBlock.h"
#include "llvm/IR/Instruction.h"
#include "llvm/IR/Instructions.h"
#include "llvm/IR/IntrinsicInst.h"
#include "llvm/IR/Constants.h"
#include "llvm/IR/TypeBuilder.h"
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *VecVal = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    ConstantInt *Index = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Instruction *InsElt = InsertElementInst::Create(VecVal, VecVal, Index, "", BB);

     
    Value *TrueVal = ConstantFP::get(Type::getFloatTy(Context), APFloat::fltNaN());
    Value *FalseVal = ConstantFP::get(Type::getFloatTy(Context), APFloat::fltZero());
    Value *CondVal = ICmpInst::Create(Instruction::ICmp, ICmpInst::ICMP_ULT, TrueVal, ConstantInt::get(Type::getInt32Ty(Context), 2));
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    SI->setDoesNotThrow();
    F->setDoesNotThrow();

     
    assert(!SI.use_empty() && "CallInst must have at least one use");

     
    assert(F->doesNotThrow() && "Function must be marked as nounwind");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(SI);
    assert(II && II->getIntrinsicID() == Intrinsic::memset && "CallInst must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(SI);
    assert(CB && "Context instruction must be a CallBase instance");

    std::cout << "Test passed!" << std::endl;
    return 0;
}
