#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("testModule", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB);

     
    Use &U = F->args().begin();
    U.set(CI);

     
    F->setDoesNotThrow();
    F->setUnwindDest(&M.getNonexistentBlock());

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic instruction");
    if (II->getIntrinsicID() == llvm::Intrinsic::memset) {
        II->setArgOperand(1, ConstantInt::get(Type::getInt32Ty(Context), 0));
    } else if (II->getIntrinsicID() == llvm::Intrinsic::memcpy) {
        Value *Dest = Builder.CreateAlloca(Type::getInt8Ty(Context), ConstantInt::get(Type::getInt64Ty(Context), 16));
        II->setArgOperand(0, Dest);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::memmove) {
        Value *Dest = Builder.CreateAlloca(Type::getInt8Ty(Context), ConstantInt::get(Type::getInt64Ty(Context), 16));
        II->setArgOperand(0, Dest);
    } else {
        assert(false && "Expected a memory intrinsic");
    }

     
    M.print(errs());

    return 0;
}
