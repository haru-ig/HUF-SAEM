#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::anymem_intrinsic), {}, "", BB);

     
    if (!CI->use_empty()) {
        CI->addUse(...);  
    }

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    CI->setDoesNotThrow();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
         
    }

     
    Mod->print(outs(), nullptr);

    return 0;
}
