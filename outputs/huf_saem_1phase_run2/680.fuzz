#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

 
Function *createFunctionWithIntrinsicCalls() {
    LLVMContext Context;
    Module module("testModule", Context);
    FunctionType *funcType = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *func = Function::Create(funcType, GlobalValue::ExternalLinkage, "main", &module);
    BasicBlock *entryBB = BasicBlock::Create(Context, "", func);

     
    Value *zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&module, Intrinsic::abs, { Type::getInt32Ty(Context) }), { zero }, "", entryBB);

     
    func->setDoesNotThrow();
    func->setLinkage(GlobalValue::InternalLinkage);

    return func;
}

int main() {
    Function *func = createFunctionWithIntrinsicCalls();
    if (!func) {
        errs() << "Failed to create function with intrinsic calls.\n";
        return 1;
    }

     
    func->print(outs());

    return 0;
}
