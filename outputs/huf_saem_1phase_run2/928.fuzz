#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallBase *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 0)}, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);
    
     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memcpy) {
             
            auto NumBytes = II->getArgOperand(2)->getValue();
            if (NumBytes.isNegativeOrZero()) {
                 
            }
        }
    }
    
     
    Mod->print(outs(), nullptr);
    
    return 0;
}
