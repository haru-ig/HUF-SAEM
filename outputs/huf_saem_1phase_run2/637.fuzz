#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("testModule", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::any_mem_intrinsic), {}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setLinkage(GlobalValue::InternalLinkage);
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked with no-throw");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::any_mem_intrinsic && "CallInst must be an AnyMemIntrinsic");

     
    Value *TrueVal = ConstantFP::get(Type::getFloatTy(Context), 1.0);
    Value *FalseVal = ConstantFP::get(Type::getFloatTy(Context), -1.0);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, F->getArg(0), ConstantInt::get(Type::getInt32Ty(Context), 2));
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    assert(TrueVal && FalseVal && CondVal && "SelectInst must have valid condition, true, and false values");

     
    Type *SelType = SI->getType();
    assert(SelType && "SelectInst type must be correctly retrievable");

     
    F->eraseFromParent();
    M.clear();

    return 0;
}
