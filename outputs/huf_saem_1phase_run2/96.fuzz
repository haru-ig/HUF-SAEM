#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/Cloning.h>
#include <llvm/Transforms/Scalar/SimplifyCFG.h>

using namespace llvm;

bool checkAndUpdate(CallBase &CI) {
   
  if (CI.use_empty()) return false;

   
  if (!dyn_cast<IntrinsicInst>(&CI)) return false;
  auto *II = dyn_cast<IntrinsicInst>(&CI);
  if (!II->isAnyMemIntrinsic()) return false;

   
  Function *func = CI.getFunction();
  if (func->doesNotThrow() || func->isNounwind()) return false;

   
  return true;
}

int main() {
  LLVMContext Context;
  Module M("test", Context);
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
  BasicBlock *BB = BasicBlock::Create(Context, "", F);
  IRBuilder<> Builder(BB);

   
  Value *Args[] = {};
  CallInst *CI = CallInst::CreateIntrinsic(II->getIntrinsicID(), Args, "", BB);

  if (checkAndUpdate(*CI)) {
    std::cout << "Constraints satisfied!" << std::endl;
  } else {
    std::cout << "Constraints not satisfied." << std::endl;
  }

  return 0;
}
