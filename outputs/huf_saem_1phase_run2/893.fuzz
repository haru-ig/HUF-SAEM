#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Verifier.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::InternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg1 = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::memset), {Arg1}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic." << std::endl;
    }

     
    if (F->doesNotThrow()) {
        F->setDoesNotThrow(false);
        std::cout << "Function marked as nounwind." << std::endl;
    } else {
        std::cout << "Function not marked as nounwind." << std::endl;
    }

     
    if (verifyModule(Mod, &outs())) {
        std::cerr << "Module verification failed!" << std::endl;
        return 1;
    } else {
        std::cout << "Module verified successfully." << std::endl;
    }

    return 0;
}
