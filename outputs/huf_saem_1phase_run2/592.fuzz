#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    Intrinsic::ID IntrID = Intrinsic::not_intrinsic;  
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), IntrID), {Arg}, "", BB);

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->isAnyMemory());

     

    std::cerr << "Test passed!" << std::endl;
    return 0;
}
