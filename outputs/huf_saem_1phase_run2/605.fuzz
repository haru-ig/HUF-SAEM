#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/Cloning.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);

     
    FunctionType* FT = FunctionType::get(IntegerType::getInt32Ty(Context), true);
    Function* F = Function::Create(FT, GlobalValue::ExternalLinkage, "func", M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Argument* Arg = &(*F->arg_begin());
    Arg->setParamAttribute(0, AttributeSet::get(Context, {Attribute::Returned}));

     
    CallInst* CI = CallInst::CreateIntrinsic(Intrinsic::anymemintrinsic, {}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(CI) && "CallInst must be an AnyMemIntrinsic");

     
     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
