#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);
    F->addFnAttr(Attribute::NoUnwind);  

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0, true);
    Arg->setName("arg");
    F->getArgumentList().push_back(Arg);

     
    CallInst *CI = CallInst::Create(FuncTy, F, { Arg }, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    assert(F->doesNotThrow() && !CI->doesNotThrow() && "Function and CallInst must be marked appropriately");

     
    Intrinsic::ID MemOp = Intrinsic::memcpy;  
    CallInst *MI = CallInst::Create(Intrinsic::getDeclaration(&M, MemOp), CI->getType(), { CI }, "", BB);
    assert(dyn_cast<IntrinsicInst>(MI) && "CallInst must be an intrinsic call");

     
    M.print(errs());

    return 0;
}
