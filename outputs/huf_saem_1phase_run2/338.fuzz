#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = F->getArg(0);

     
    Intrinsic::ID IntrID = Intrinsic::memcpy;
    std::vector<Value *> Args = {ConstantExpr::getIntToPtr(ConstantInt::get(Type::getInt32Ty(Context), 0), Type::getInt32PtrTy(Context)), ConstantExpr::getIntToPtr(ConstantInt::get(Type::getInt32Ty(Context), 0), Type::getInt32PtrTy(Context)), ConstantInt::get(Type::getInt32Ty(Context), 4)};
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), Args, "", BB);

     
    CI->addUse(F->getArg(0));

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic call");
    AnyMemIntrinsic *AMIntr = dyn_cast<AnyMemIntrinsic>(II);
    assert(AMIntr && "Expected a memory intrinsic");

     
    uint64_t NumBytes = AMIntr->getNumElements() * 2;  
    assert(NumBytes <= 0 || (NumBytes % 2 != 0) && "Expected non-positive length or not a multiple of element size");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Expected a CallBase instruction");

     
    std::cout << "Function: " << F->getName().str() << "\n";
    std::cout << "CallInst in function: " << CI->getFunction()->getName().str() << "\n";
    std::cout << "Is nounwind: " << (F->doesNotThrow() ? "Yes" : "No") << "\n";
    std::cout << "Intrinsic ID: " << IntrID << "\n";
    std::cout << "Number of arguments: " << CI->getNumOperands() << "\n";

    return 0;
}
