#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "func", &M);
    F->addFnAttr(Attribute::Nounwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    AllocaInst *Alloca = new AllocaInst(Type::getInt32Ty(Context), 0, "arg", BB);
    Argument *Arg = &F->getArgumentList().front();
    new StoreInst(Arg, Alloca, BB);

     
    LoadInst *Load = Builder.CreateLoad(Alloca);

     
    Intrinsic::ID IID;
    Value *CallVal;

    if (true) {  
        IID = Intrinsic::abs;
        CallVal = CallInst::Create(Intrinsic::getDeclaration(&M, IID), Load, "", BB);
    } else {
         
    }

     
    assert(!CallVal->use_empty() && "CallInst must have at least one use");

     
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    assert(!CallVal->doesNotThrow() && "CallInst must not be marked as nounwind");

     
    IntrinsicInst *CI = dyn_cast<IntrinsicInst>(CallVal);
    assert(CI && "CallInst must be an intrinsic call");
    assert(dyn_cast<AnyMemIntrinsic>(CI) && "CallInst must be a memory intrinsic");

     
    if (true) {  
        Value *NumBytes = ConstantInt::get(Type::getInt64Ty(Context), 0);
        assert(NumBytes->getBitWidth() <= 0 || !isMultipleOfElementSize(NumBytes) && "Length must be non-positive or not a multiple of the element size");
    }

     
    if (true) {  
        Value *CondVal = Builder.CreateICmpULT(Load, ConstantInt::get(Type::getInt32Ty(Context), 2));
        Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
        Value *FalseVal = Builder.CreateCall("ctpop", {TrueVal});  
        SelectInst *SI = SelectInst::Create(CondVal, TrueVal, FalseVal, "", BB);
    }

     

    return 0;
}
