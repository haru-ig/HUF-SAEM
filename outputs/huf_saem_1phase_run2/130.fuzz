#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
  LLVMContext Context;
  Module M("test", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);
  F->setDoesNotThrow();
  F->addFnAttr(Attribute::Nounwind);

   
  BasicBlock *BB = BasicBlock::Create(Context, "", F);
  IRBuilder<> Builder(BB);

   
  Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
  CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::any_mem_intrinsic), {Arg}, "", BB);
  assert(!CI->use_empty() && "CI must have at least one use");

   
  if (dyn_cast<IntrinsicInst>(CI)) {
    Intrinsic::ID ID = CI->getIntrinsicID();
    assert(Intrinsic::isAnyMemoryIntrinsic(ID) && "CI must be an AnyMemIntrinsic");
  }

   
  Builder.CreateRet(CI);
  assert(!CI->use_empty() && "CI must have at least one use");

   
  M.print(errs());

  return 0;
}
