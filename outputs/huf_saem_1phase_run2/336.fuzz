#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt32Ty(Context), 4)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setUnwind(false);

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
    assert(AMII && "CallInst must be an AnyMemIntrinsic");

     
    uint64_t NumBytes = 0;  
    assert(NumBytes <= 0 || (NumBytes % sizeof(uint8_t) != 0) && "Length must be non-positive or not a multiple of the element size");

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = CallInst::CreateNUWNSW(Instruction::Cast, TrueVal, Type::getInt32Ty(Context), "", BB);  
    SelectInst *SI = new SelectInst(ConstantInt::get(Type::getInt1Ty(Context), true), TrueVal, FalseVal, "", BB);

     
    assert(SI->hasOneUse() && "SelectInst must have at least one use");
    Value *CondVal = SI->getCondition();
    ICmpInst *ICmp = dyn_cast<ICmpInst>(CondVal);
    assert(ICmp && ICmp->getPredicate() == ICmpInst::ICMP_ULT && "Condition must be an 'ult' icmp");
    Value *TrueVal2 = SI->getTrueValue();
    Value *FalseVal2 = SI->getFalseValue();
    assert(TrueVal2 && FalseVal2 && "TrueVal and FalseVal must be valid values");
    Type *SelType = SI->getType();
    assert(SelType && "SelectInst type must be correctly retrievable");

     
     

    return 0;
}
