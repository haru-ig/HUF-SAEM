#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *Func = Function::Create(FuncTy, Function::ExternalLinkage, "testFunc", Module.get());
    BasicBlock *EntryBB = BasicBlock::Create(Context, "", Func);

     
    CallInst *CI;
    if (true) {
        CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::abs), {}, "", EntryBB);
    } else {
        CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::sqrt), {}, "", EntryBB);
    }

     
    if (!CI->use_empty()) {
        std::cout << "CallInst has uses.\n";
    } else {
        std::cout << "CallInst does not have enough uses.\n";
    }

     
    if (Func->doesNotThrow()) {
        std::cout << "Function is marked as nounwind.\n";
    } else {
        std::cout << "Function is not marked as nounwind.\n";
    }

     
    if (!CI->doesNotThrow()) {
        std::cout << "CallInst does not throw.\n";
    } else {
        std::cout << "CallInst throws.\n";
    }

    return 0;
}
