#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Transforms/Utils/LoopUtils.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallInst *CI = CallInst::Create(F, {ConstantInt::get(Type::getInt32Ty(Context), 1)}, "", BB);
    
     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);
    
     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    assert(II->getIntrinsicID() == Intrinsic::anymemintrinsic && "CI must be an AnyMemIntrinsic");
    
     
    if (II->getIntrinsicID() == Intrinsic::atomicrmw_fadd) {
        Value *NumBytes = ConstantInt::get(Type::getInt64Ty(Context), 0);  
        assert(NumBytes && "NumBytes must be valid");
    }
    
     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");
    
     
    
    return 0;
}
