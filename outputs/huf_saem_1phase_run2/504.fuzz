#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/SimplifyLibCalls.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module module("test_module", Context);

     
    FunctionType *funcType = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *func = Function::Create(funcType, GlobalValue::ExternalLinkage, "test_function", &module);
    func->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *bb = BasicBlock::Create(Context, "", func);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", bb);
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    func->setDoesNotThrow();
    func->setUnwindBehavior(Function::UnwindNone);

     
    assert(!CI->doesNotThrow() && "CallInst must not be marked as nounwind.");

     
    legacy::PassManager Passes;
    Passes.add(createSimplifyLibCallsPass());
    Passes.run(module);

    return 0;
}
