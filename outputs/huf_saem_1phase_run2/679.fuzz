#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    FunctionCallee Callee = M.getOrInsertFunction("llvm.memset.p0i8.i32", FunctionType::get(Type::getVoidTy(Context), {PointerType::getInt8PtrTy(Context), Type::getInt32Ty(Context), ConstantInt::get(Type::getInt32Ty(Context), 1)}, false));
    Value *Arg0 = Builder.CreateAlloca(Type::getInt8Ty(Context));
    Value *Arg1 = ConstantInt::get(Type::getInt32Ty(Context), 4);
    CallInst *CI = CallInst::Create(Callee, {Arg0, Arg1}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     
    if (F->doesNotThrow()) {
        std::cout << "Function is marked as nounwind." << std::endl;
    } else {
        std::cout << "Function is not marked as nounwind." << std::endl;
    }

     
    if (!CI->doesNotThrow()) {
        std::cout << "CallInst does not throw." << std::endl;
    } else {
        std::cout << "CallInst throws." << std::endl;
    }

    return 0;
}
