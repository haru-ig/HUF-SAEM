#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Args[1] = { ConstantInt::get(Type::getInt32Ty(Context), 0) };
    CallInst *CI = CallInst::Create(FuncTy, Intrinsic::getDeclaration(&M, Intrinsic::abs), Args, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setUnwind(false);
    
     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantFP::get(Type::getFloatTy(Context), APFloat(-1.0));  
    SelectInst *SI = new SelectInst(CI, TrueVal, FalseVal, "", BB);
    
     
    SI->setCondition(ConstantInt::get(Type::getInt1Ty(Context), true));
    
     
    F->getEntryBlock().push_back(SI);
    
     
    
    std::cout << "Module: " << M.getName() << "\n";
    return 0;
}
