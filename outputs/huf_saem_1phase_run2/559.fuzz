#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    FunctionCallee Callee = M.getOrInsertFunction("llvm.memcpy.p0i8.p0i8.i32",
                                                  FunctionType::get(Type::getVoidTy(Context),
                                                                     {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 4)},
                                                                     false));
    CallInst *CI = CallInst::Create(Callee, {Arg, Arg, ConstantInt::get(Type::getInt64Ty(Context), 4)}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    assert(!CI->getFunction()->hasFnAttribute(Attribute::NoUnwind) && "Function must be marked as nounwind");

     
    assert(!CI->doesNotThrow() && "CallInst must not have a 'nothrow' attribute");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::memcpy && "CallInst must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     
    std::cout << "Function: " << CI->getFunction()->getName() << "\n";
    std::cout << "CallInst: " << *CI << "\n";

    return 0;
}
