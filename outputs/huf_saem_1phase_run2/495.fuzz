#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Transforms/Utils/Cloning.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = new Argument(Type::getInt32Ty(Context), "arg", F);
    Arg->setParamAttr(0, AttributeSet::ReturnIndex, Attribute::Returned);

     
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(F, Callee, "", BB);

     
    if (CI->use_empty()) {
        std::cerr << "CallInst does not have any uses." << std::endl;
        return 1;
    }

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow();

     
    Intrinsic::ID IID = Intrinsic::not_intrinsic;  
    Value *IntrArg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *ICall = CallInst::Create(Intrinsic::getDeclaration(&M, IID), {IntrArg}, "", BB);

     
    if (ICall->use_empty()) {
        std::cerr << "Intrinsic call does not have any uses." << std::endl;
        return 1;
    }

     
     

    std::cout << "Test case created successfully." << std::endl;
    return 0;
}
