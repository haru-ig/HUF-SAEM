#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg1 = new Argument(Type::getInt32Ty(Context), "arg1", (Function *)0);
    Arg1->setArgNo(0);
    F->getArgumentList().push_back(Arg1);

     
    CallInst *CI = CallInst::Create(F, {Arg1}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    IntrinsicInst *II = CallInst::Create(Intrinsic::anymemintrinsic, {Arg1}, "", BB);
    assert(dyn_cast<IntrinsicInst>(II) && "The instruction must be an intrinsic call");

     
    AnyMemIntrinsic *AMII = dyn_cast<AnyMemIntrinsic>(II);
    assert(AMII->getLength() <= 0 && "For atomic unordered memory intrinsics, the length must be non-positive");

     
    CallBase *CB = CI;
    assert(isa<CallBase>(CB) && "The context instruction must be a CallBase instance");

     
    auto IRExp = IRPosition::callsite_argument(CI);
    assert(IRExp.isValid() && "IRPosition must be valid");

     
    Function *Func = IRExp.getAnchorScope();
    assert(Func && "The function associated with the IRPosition must be non-null");

     

    std::cout << "All conditions satisfied." << std::endl;
    return 0;
}
