#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::fabs, {Type::getFloatTy(Context)}, {}, "", BB);
    CI->addUse(0, Use());  

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic instruction");
    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
    assert(AMII && "Expected a memory intrinsic");

     
    if (!CI->use_empty()) {
        CI->setArgOperand(0, ConstantFP::get(Type::getFloatTy(Context), APFloat::IEEEdouble()))));
    }

     
    M.print(outs(), nullptr);

    return 0;
}
