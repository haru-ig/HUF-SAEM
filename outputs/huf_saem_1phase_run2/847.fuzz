#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", BB);
    CI->setDoesNotThrow();  

     
    BB->push_back(CI);

     
    assert(!F->use_empty() && "Function must have at least one use.");
    assert(F->doesNotThrow() && "Function must be marked as nounwind.");
    assert(CI->getCalledValue()->isIntrinsic() && "CallInst must be an intrinsic call.");
    assert(isa<AnyMemIntrinsic>(CI) && "CallInst must be a memory intrinsic.");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase.");

     
    assert(!CI->use_empty() && "CallInst must have at least one use.");
    assert(!F->doesNotThrow() && "Function must not be marked as nounwind.");

     
    std::cout << "All constraints satisfied." << std::endl;

    return 0;
}
