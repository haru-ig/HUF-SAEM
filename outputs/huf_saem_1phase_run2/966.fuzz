#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Analysis/TargetLibraryInfo.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    Builder.SetInsertPoint(BB->getFirstNonPHI());
    CallInst *CI = CallInst::Create(FuncTy, FunctionCtor::get(&M), {Arg}, "", BB);

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow();

     
    Value *IntrinsicArgs[] = {CI};
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::any_mem_intrinsic, IntrinsicArgs, "", BB);

     
    II->addUse(CI);

     

     
    M.print(outs(), nullptr);

    return 0;
}
