#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Args[] = {ConstantInt::get(Type::getInt32Ty(Context), 0)};
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context)}, Args, "", BB);

     
    CI->addUse(F->getArg(0));

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "The CallInst is an intrinsic.\n";
    } else {
        errs() << "The CallInst is not an intrinsic.\n";
    }

     
    if (F->doesNotThrow()) {
        errs() << "Function is marked as nounwind.\n";
    } else {
        errs() << "Function is not marked as nounwind.\n";
    }

     
    if (!CI->doesNotThrow()) {
        errs() << "CallInst does not throw.\n";
    } else {
        errs() << "CallInst throws.\n";
    }

    return 0;
}
