#include <iostream>
int main() {
  

#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>
#include <llvm/Transforms/Utils/LoopUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallBase *CI = CallInst::Create(nullptr, Arg, {}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwindDest();

     
    Intrinsic::ID IID = Intrinsic::memcpy;
    CallInst *MemCpyCI = CallInst::Create(Intrinsic::getDeclaration(&M, IID), CI, "", BB);

     
    if (dyn_cast<IntrinsicInst>(MemCpyCI)) {
        std::cout << "Intrinsic call detected." << std::endl;
    } else {
        std::cout << "Not an intrinsic call." << std::endl;
    }

     
     

     
     

    return 0;
}
