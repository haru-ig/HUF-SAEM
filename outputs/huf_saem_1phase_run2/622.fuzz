#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Verifier.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    Arg->setName("arg");
    std::vector<Value *> Args = {Arg};
    Intrinsic::ID IID = Intrinsic::memcpy;  
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, IID), Args, "", BB);
    
     
    CI->addUse(F->getArg(0));
    
     
    if (verifyModule(*M, &std::cerr)) {
        std::cerr << "Module failed verification.\n";
        return 1;
    }
    
    delete M;
    return 0;
}
