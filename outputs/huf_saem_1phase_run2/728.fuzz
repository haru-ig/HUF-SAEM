#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = Argument::Create(Type::getInt32Ty(Context), "arg", F);
    Arg->setParamAttr(0, AttributeSet::get(Context, 0, Attribute::Returned));

     
    CallBase *CI = CallInst::Create(FuncTy, (Value *)F, {Arg}, "", BB);
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setUnwindBehavior(Function::NoUnwind);

     
    IntrinsicInst *II = IntrinsicInst::Create(Type::getVoidTy(Context), Intrinsic::anymemintrinsic, {}, BB);
    II->addOperand(CI);

     
    II->setDoesNotThrow();

     
    Mod.print(errs(), nullptr);

    return 0;
}
