#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function* F = Function::Create(FT, Function::ExternalLinkage, "testFunc", M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Argument* Arg = &(*F->arg_begin());
    Arg->setName("arg");
    Arg->addAttr(Attribute::Returned);

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::anymemset), {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    IntrinsicInst* IIC = cast<IntrinsicInst>(CI);
    assert(IIC->getIntrinsicID() == Intrinsic::anymemset && "Intrinsic must be anymemset");

     
    auto IRPosition = IRPosition::callsite_argument(*CI);
    assert(!IRPosition.isNull() && "IRPosition should not be null");
    assert(IRPosition.getPositionKind() == IRP_CALL_SITE_ARGUMENT && "IRPosition must have call site argument kind");

     
     

     
    M->print(errs(), nullptr);

    return 0;
}
