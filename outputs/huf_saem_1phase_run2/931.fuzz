#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Args[1] = { ConstantInt::get(Type::getInt32Ty(Context), 0) };
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, Args, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        std::cout << "Intrinsic call satisfies constraints." << std::endl;
    } else {
        std::cout << "Intrinsic call does not satisfy constraints." << std::endl;
    }

     
    if (isa<CallBase>(CI)) {
        std::cout << "Context instruction is a CallBase." << std::endl;
    } else {
        std::cout << "Context instruction is not a CallBase." << std::endl;
    }

     

    return 0;
}
