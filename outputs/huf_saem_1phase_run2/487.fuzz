#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module module("test_module", Context);

     
    FunctionType* funcType = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *func = Function::Create(funcType, GlobalValue::ExternalLinkage, "test_function", &module);

     
    BasicBlock *bb = BasicBlock::Create(Context, "", func);

     
    Argument *arg = &(*func->arg_begin());
    arg->addAttr(Attribute::Returned);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, { Type::getInt8PtrTy(Context), arg, ConstantInt::get(Type::getInt32Ty(Context), 0) }, "", bb);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    func->setDoesNotThrow();
    func->addFnAttr(Attribute::NoUnwind);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
        assert(isa<AnyMemIntrinsic>(II) && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

         
        if (II->isAtomic()) {
            int NumBytes = 0;  
            assert(NumBytes <= 0 || NumBytes % II->getType()->getScalarSizeInBits() != 0, "Length must be non-positive or not a multiple of the element size");
        }
    }

     
    if (isa<CallBase>(CI)) {
        CallBase *CB = cast<CallBase>(CI);
        assert(CB->getFunction() && "Function must be non-null");
    }

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
