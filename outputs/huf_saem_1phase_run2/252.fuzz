#include <iostream>
int main() {
#include <llvm/IR/IRBuilder.h>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    IRBuilder<> Builder(Context);
    Module Mod("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Builder.SetInsertPoint(BB);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = Builder.CreateCall(FuncTy, F, {Arg});
    CI->setCalledFunction(F);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);
    CI->doesNotThrow();

     
    Value *Ptr = ConstantPointerNull::get(Type::getInt8PtrTy(Context));
    CallInst *AnyMemCI = Builder.CreateCall("anymemintrinsic", {Ptr});
    assert(dyn_cast<IntrinsicInst>(AnyMemCI) && "Must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(AnyMemCI);
    assert(CB && "Context instruction must be a CallBase");

     

    std::cout << "Module: " << Mod << std::endl;
    return 0;
}
