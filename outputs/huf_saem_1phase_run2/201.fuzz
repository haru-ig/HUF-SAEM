#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/UnrollLoop.h>

using namespace llvm;

int main() {
  LLVMContext Context;
  Module M("test", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
  BasicBlock *BB = BasicBlock::Create(Context, "", F);
  IRBuilder<> Builder(BB);

   
  Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
  CallInst *CI = CallInst::Create(FTy, F, {Arg}, "", BB);

   
  CI->addUse(F->arg_begin());

   
  F->setLinkage(GlobalValue::ExternalLinkage);
  F->setDoesNotThrow();
  F->setUnnamedAddr(GlobalValue::UnnamedAddr::None);
  F->addFnAttr(Attribute::NoUnwind);

   
  IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
  assert(II && "Expected an intrinsic call");
  assert(II->getIntrinsicID() == Intrinsic::memset, "Expected memset intrinsic");

   

   
  Loop *L = nullptr;
  for (auto &BB : *F) {
    if (BranchInst *BI = dyn_cast<BranchInst>(&*BB.rbegin())) {
      if (BI->isUnconditional() && BI->getSuccessor(0) == BB) {
        L = LI.getLoopFor(&BB);
        break;
      }
    }
  }
  assert(L && "Expected a loop to unroll");

  UnrollLoopOptions ULO;
  ULO.Count = 2;  
  UnrollLoop(L, ULO);

  std::cout << "Module: " << M << "\n";
  return 0;
}
