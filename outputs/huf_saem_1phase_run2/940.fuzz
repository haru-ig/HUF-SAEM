#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/BasicBlock.h"
#include "llvm/IR/Instructions.h"
#include "llvm/IR/Constants.h"
#include "llvm/IR/Intrinsics.h"
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 0)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     
    if (dyn_cast<CallBase>(CI)) {
        std::cout << "Context instruction is a CallBase." << std::endl;
    } else {
        std::cout << "Context instruction is not a CallBase." << std::endl;
    }

     

    return 0;
}
