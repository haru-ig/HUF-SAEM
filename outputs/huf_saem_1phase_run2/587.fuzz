#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *Arg = new Argument(Type::getInt32Ty(Context), "arg", (Value *)F);
    Arg->setParamAttrs(AttributeList::get(Context, { Attribute::Returned }));
    new StoreInst(Arg, ConstantInt::get(Type::getInt32Ty(Context), 42), BB);

     
    CallInst *CI = CallInst::Create(FTy, (Value *)F, { Arg }, "", BB->getTerminator());
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be nounwind");

     
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::anymemintrinsic, {}, "", BB->getTerminator());
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(II);
    assert(CB && "Context instruction must be a CallBase");

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
