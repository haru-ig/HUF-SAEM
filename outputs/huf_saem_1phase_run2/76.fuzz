#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "test", &TheModule);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Args[] = {ConstantInt::get(Type::getInt32Ty(Context), 0)};
    CallInst *CI = CallInst::Create(F->getFunctionType(), F, Args, "", BB);

     
    CI->addUse(Builder.getInt32Ty());

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *MemIntrin = Intrinsic::memcpy;
    Value *Dst = Builder.CreateAlloca(Type::getInt8Ty(Context));
    Value *Src = Builder.CreateAlloca(Type::getInt8Ty(Context));
    CallInst *MI = CallInst::Create(F->getFunctionType(), F, {Dst, Src}, "", BB);

     
    assert(dyn_cast<IntrinsicInst>(MI) && "Expected an intrinsic call");
    IntrinsicInst *AnyMemIntrin = dyn_cast<IntrinsicInst>(MI);
    assert(AnyMemIntrin->getIntrinsicID() == MemIntrin && "Expected a memcpy intrinsic");

     
    Value *TrueVal = ConstantFP::get(Type::getFloatTy(Context), APFloat::fltOne));
    Value *FalseVal = Builder.CreateFNeg(Builder.CreateFAbs(TrueVal));
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, TrueVal, ConstantFP::get(Type::getFloatTy(Context), 2.0));
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    assert(SI->getType()->isIntegerTy() && "Expected integer type for condition");
    assert(TrueVal->getType() == SI->getCondition()->getType() && "TrueVal type mismatch");
    assert(FalseVal->getType() == TrueVal->getType() && "FalseVal type mismatch");

     
    F->print(errs());

    return 0;
}
