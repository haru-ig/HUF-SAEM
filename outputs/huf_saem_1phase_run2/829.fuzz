#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *Func = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", Module.get());
    Func->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", Func);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, { Type::getInt8PtrTy(Context), Constant::getNullValue(Type::getInt8PtrTy(Context)), ConstantInt::get(Type::getInt32Ty(Context), 0) }, "", BB);
    CI->addUse(Func->getArg(0));  

     
    if (auto *II = dyn_cast<AnyMemIntrinsic>(CI)) {
        if (!II->isVolatile()) {
            errs() << "Intrinsic is not volatile\n";
        }
    } else {
        errs() << "Not an AnyMemIntrinsic\n";
    }

     
    if (!Func->doesNotThrow()) {
        errs() << "Function is not marked as nounwind\n";
    }

     
    BB->print(errs());

    return 0;
}
