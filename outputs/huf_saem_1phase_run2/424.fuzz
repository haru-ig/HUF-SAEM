#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(IntegerType::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB->getTerminator());
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow(false);

     
    Intrinsic::ID IntrID = Intrinsic::not_an_intrinsic;  
    CallInst *IntrCI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), {Arg}, "", BB->getTerminator());
    assert(dyn_cast<IntrinsicInst>(IntrCI) && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(IntrCI) && "Intrinsic call must be AnyMemIntrinsic");

     
    assert(isa<CallBase>(CI) && "Context instruction must be a CallBase");

     

    std::cout << "Test program setup completed." << std::endl;
    return 0;
}
