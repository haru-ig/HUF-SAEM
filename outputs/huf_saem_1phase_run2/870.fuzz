#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Use.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "main", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(nullptr, Callee, "", BB);

     
    CI->addUse(F->arg_begin());

     
    assert(!F->isDeclaredNounwind() && !CI->doesNotThrow() && "Function or CallInst should not be nounwind");

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 1);
    IntrinsicInst *II = IntrinsicInst::Create(Instruction::MemSet, CI->getType(), {CI, Arg, ConstantInt::get(Type::getInt32Ty(Context), 4)}, "", BB);
    II->setIsMetadata()  

     
    assert(!II->isZeroOperand() && "Intrinsic call should not have zero operands");

     
    M.print(errs());
    F->print(errs());

    return 0;
}
