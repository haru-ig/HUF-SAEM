#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    F->addFnAttr(Attribute::Nounwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    IRBuilder<> Builder(BB);
    Value *Arg = &*(F->arg_begin());
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Arg, Arg}, {}, "");

     
    BB->getInstList().push_back(CI);
    assert(!CI.use_empty() && "CallInst must have at least one use.");

     
    assert(F->doesNotThrow() && "Function must be marked as nounwind while CallInst is not.");

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memcpy) {
            assert(true && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic.");
        }
    }

     
     

    std::cout << "Test program completed successfully." << std::endl;
    return 0;
}
