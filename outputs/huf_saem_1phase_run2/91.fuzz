#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/LoopUtils.h>
#include <llvm/Analysis/ScalarEvolution.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("testModule", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunction", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, {Type::getInt8PtrTy(Context)}, {ConstantExpr::getNull(), ConstantInt::get(Type::getInt64Ty(Context), 0)}, "", BB);
    CI->addUse(F->arg_begin());  

     
    assert(!CI->doesNotThrow() && "CallInst should be marked as nounwind");
    F->setDoesNotThrow();

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memset) {
            errs() << "Intrinsic detected: memset\n";
        }
    }

     
    bool simplified = CI->hasOneUse();  
    if (simplified) {
        CI->dump();
    } else {
        errs() << "CallInst does not have enough uses to be simplified.\n";
    }

     
    Type *argType = F->getArg(0)->getType();
    if (isValidElementType(argType)) {
        errs() << "Valid element type detected.\n";
    } else {
        errs() << "Invalid element type.\n";
    }

     

    return 0;
}
