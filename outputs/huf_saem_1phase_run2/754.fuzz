#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/Transforms/Utils/Cloning.h>
#include <llvm/Transforms/Scalar/SimplifyCFG.h>

using namespace llvm;

bool isCallInstUsed(const CallInst &CI) {
  return !CI.use_empty();
}

bool isFunctionNounwind(const Function &F) {
  return F.doesNotThrow();
}

bool isIntrinsicCall(const CallInst &CI) {
  if (auto *II = dyn_cast<IntrinsicInst>(&CI)) {
    return II->getIntrinsicID() == Intrinsic::anymemintrinsic;
  }
  return false;
}

bool hasAtLeastOneArgumentWithReturnedAttr(const Function &F) {
  for (auto &Arg : F.args()) {
    if (Arg.hasRetainedAttr()) {
      return true;
    }
  }
  return false;
}

int main() {
  LLVMContext Context;
  Module M("test_module", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

  BasicBlock *BB = BasicBlock::Create(Context, "", F);
  IRBuilder<> Builder(BB);

   
  Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 0);
  CallInst *CI = Builder.CreateCall(F->getFunctionType(), Callee, "", BB);

   
  assert(hasAtLeastOneArgumentWithReturnedAttr(*F) && "Function must have at least one argument with returned attribute");

   
  assert(isCallInstUsed(*CI) && "CallInst must have at least one use");
  assert(isFunctionNounwind(*F) && "Function must be marked as nounwind");
  assert(isIntrinsicCall(*CI) && "CallInst must be an intrinsic call");

  std::cout << "All constraints satisfied!" << std::endl;

  return 0;
}
