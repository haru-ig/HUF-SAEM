#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Vec = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    Value *Idx = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Instruction *InsElt = InsertElementInst::Create(Vec, Vec, Idx, "", BB);
    
     
    assert(!Vec->getType()->isVectorTy() && "Vec should not be a vector type");
    assert(InsElt->getType()->isVectorTy() && "InsElt should be a vector type");
    
     
    Intrinsic::ID IID = Intrinsic::fabs;
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, IID), Vec, "", BB);
    
     
    assert(!CI->use_empty() && "CI must have at least one use");
    assert(!F->doesNotThrow() && "Function must be marked as !nounwind");
    assert(dyn_cast<IntrinsicInst>(CI) && "CI must be an intrinsic call");
    assert(dyn_cast<AnyMemIntrinsic>(CI) && "CI must be a memory intrinsic");
    
     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase");
    
     
    std::cout << "Module: " << M.getName() << "\n";
    std::cout << "Function: " << F->getName() << "\n";
    std::cout << "Basic Block: " << BB->getName() << "\n";
    std::cout << "Call Instruction: " << *CI << "\n";
    
    return 0;
}
