#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);
    
     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0);
    new Argument(Type::getInt32Ty(Context), arg_ssa_name(*F, 0), nullptr, Arg);
    
     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, { Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 10) }, {}, "", BB);
    
     
    CI->addUse(*F);
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    CallBase *CtxI = CI;
    
     
    assert(dyn_cast<CallBase>(CtxI) && "Context instruction must be a CallBase");
    
     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, CI->getType(), CI, ConstantInt::get(CI->getType(), 2));
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);
    
     
    assert(SI && "SelectInst must have valid operands and condition");
    
    return 0;
}
