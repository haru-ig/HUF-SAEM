#include <iostream>
int main() {
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>
#include <llvm/Transforms/Utils/LoopUtils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module module("test", Context);

     
    FunctionType *funcType = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *func = Function::Create(funcType, GlobalValue::ExternalLinkage, "testFunc", &module);
    func->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *entryBB = BasicBlock::Create(Context, "", func);
    IRBuilder<> builder(entryBB);

     
    Value *arg1 = ConstantInt::get(IntegerType::getInt32Ty(Context), 1);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&module, Intrinsic::memset), {arg1}, "", entryBB);

     
    CI->addUse(func->getArg(0));

     
    func->setDoesNotThrow();
    func->setUnwindDest(&module.getContext().createBasicBlock("unwind"));

     
    CI->setDoesNotThrow();

     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "Intrinsic call detected.\n";
    } else {
        errs() << "No intrinsic call detected.\n";
    }

     
    assert(func->doesNotThrow() && "Function must be marked as nounwind");

     

    return 0;
}
