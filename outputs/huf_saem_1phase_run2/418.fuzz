#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Use.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);
    Function* F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", M);
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    Instruction* CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::any_mem_intrinsic), {}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    assert(!F->doesNotThrow() && "Function must be marked as nounwind");

     
    IntrinsicInst* IIC = dyn_cast<IntrinsicInst>(CI);
    assert(IIC && IIC->getIntrinsicID() == Intrinsic::any_mem_intrinsic && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

     
    Value* NumBytes = IIC->getArgOperand(0);
    int64_t numBytesValue = cast<ConstantInt>(NumBytes)->getSExtValue();
    assert(numBytesValue <= 0 || (numBytesValue % 16 != 0) && "Length must be non-positive or not a multiple of the element size");

     
    CallBase* CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     
    IRPosition Pos = IRPosition::callsite_argument(*F, CB);
    assert(Pos.getKind() == IRPosition::IRP_CALL_SITE_ARGUMENT && "IRPosition must have a position kind of IRP_CALL_SITE_ARGUMENT");

     
    Function* Func = Pos.getFunction();
    assert(Func && "Function associated with the IRPosition must be non-null");

     
     

     
    Value* TrueVal = ConstantFP::get(Type::getFloatTy(Context), 1.0);
    Value* FalseVal = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::ctpop), {TrueVal}, "", BB);
    Value* CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, TrueVal, ConstantInt::get(Type::getInt32Ty(Context), 2));
    Type* SelType = Type::getFloatTy(Context);
    SelectInst* SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);
    assert(SI && "SelectInst must be created successfully");

     
    assert(SI->getCondition() == CondVal && "Condition of SelectInst must match CondVal");
    assert(SI->getTrueValue() == TrueVal && "True value of SelectInst must match TrueVal");
    assert(SI->getFalseValue() == FalseVal && "False value of SelectInst must match FalseVal");
    assert(SI->getType() == SelType && "SelectInst type must match SelType");

     
    assert(isa<CallInst>(FalseVal) && "FalseVal must be a ctpop operation of TrueVal");
    assert(isa<ICmpInst>(CondVal) && "CondVal must be an icmp ult comparison of TrueVal with integer constant 2");

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
