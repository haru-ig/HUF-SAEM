#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::InternalLinkage, "testFunc", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    BB->addArgument(Type::getInt32Ty(Context), false);

     
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);
    CI->setTailCall();
    CI->addUse(Arg);

     
    F->setDoesNotThrow();
    F->setUnwindDest(&M.getContext().getBasicBlockByName(".unwind"));

     
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::memcpy, { CI }, "", BB);
    II->setAtomicOrdering(llvm::AtomicOrdering::NotAtomic);
    II->setSyncScopeID(SyncScope::System);

     
    M.print(outs(), nullptr);

    return 0;
}
