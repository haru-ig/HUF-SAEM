#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, GlobalValue::InternalLinkage, "test_func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, { Type::getInt32PtrTy(Context), Constant::getNullValue(Type::getInt32PtrTy(Context)), ConstantInt::get(Type::getInt32Ty(Context), 4) }, "", BB);
    CI->addUse(1);  

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        outs() << "CallInst is an intrinsic call.\n";
    } else {
        errs() << "CallInst is not an intrinsic call.\n";
        return 1;
    }

     
    if (!F->doesNotThrow()) {
        errs() << "Function is not marked as nounwind.\n";
        return 1;
    }

     
    CI->setDoesNotThrow();

     
    F->print(outs());
    CI->print(outs());

    return 0;
}
