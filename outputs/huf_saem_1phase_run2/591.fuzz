#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memcpy), {}, "", BB);
    CI->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    if (F->hasFnAttribute(Attribute::NoUnwind) && !CI->doesNotThrow()) {
        errs() << "Function and CallInst attributes are correctly set.\n";
    } else {
        errs() << "Incorrect function or call instruction attributes.\n";
    }

     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "CallInst is an AnyMemIntrinsic.\n";
    } else {
        errs() << "Incorrect CallInst type.\n";
    }

     
    M->print(errs());

    delete M;
    return 0;
}
