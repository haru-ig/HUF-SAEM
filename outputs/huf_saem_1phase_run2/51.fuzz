#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("module", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FT, GlobalValue::ExternalLinkage, "func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0);
    F->arg_begin()->setName("arg");

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::anymem_intrinsic), {Arg}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    if (!F->doesNotThrow()) {
        std::cerr << "Function should be marked as nounwind but it isn't." << std::endl;
        return 1;
    }

     
    Mod.print(outs(), nullptr);

    return 0;
}
