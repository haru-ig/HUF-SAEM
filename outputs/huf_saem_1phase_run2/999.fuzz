#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/Instructions.h"
#include "llvm/IR/Intrinsics.h"
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", Mod.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::abs), {ConstantFP::get(Type::getFloatTy(Context), 1.0)}, "", BB);

     
    if (CI->use_empty()) {
        std::cerr << "Error: CallInst does not have any uses." << std::endl;
        return -1;
    }

     
    F->setDoesNotThrow();
    if (F->doesNotThrow() || CI->doesNotThrow()) {
        std::cerr << "Error: Function or CallInst is marked as nounwind." << std::endl;
        return -1;
    }

     
    if (!dyn_cast<IntrinsicInst>(CI)) {
        std::cerr << "Error: CI is not an intrinsic call." << std::endl;
        return -1;
    }

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    if (II->getIntrinsicID() == Intrinsic::memcpy || II->getIntrinsicID() == Intrinsic::memmove) {
         
        Value *NumBytes = nullptr;  
        if (NumBytes && ((APInt(32, NumBytes).getSExtValue() <= 0 || !isMultipleOfElementSize(NumBytes))) {
            std::cerr << "Error: Invalid atomic unordered memory intrinsic." << std::endl;
            return -1;
        }
    }

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
