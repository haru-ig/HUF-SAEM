#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Verifier.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Intrinsic::ID IntrID = Intrinsic::pow;  
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), {ConstantInt::get(Type::getInt32Ty(Context), 2)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    AnyMemIntrinsic *AMInst = dyn_cast<AnyMemIntrinsic>(CI);
    assert(AMInst && "CallInst must be an intrinsic call and satisfy AnyMemIntrinsic");

     
    if (verifyModule(M, &outs())) {
        errs() << "Module failed verification.\n";
        return 1;
    }

    std::cout << "Module created successfully with a function having an intrinsic call." << std::endl;
    return 0;
}
