#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0, true);
    BB->addArgument(Type::getInt32PtrTy(Context), false);
    
     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::any_mem_intrinsic, {}, "", BB);
    
     
    CI->addUse(F->getArg(0));
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "CallInst is an intrinsic call\n";
    } else {
        errs() << "CallInst is not an intrinsic call\n";
    }
    
     
    if (isa<CallBase>(CI)) {
        errs() << "Context instruction is a CallBase instance\n";
    } else {
        errs() << "Context instruction is not a CallBase instance\n";
    }
    
     
    delete M;
    return 0;
}
