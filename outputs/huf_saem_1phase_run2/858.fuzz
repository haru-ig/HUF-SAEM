#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/Cloning.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = &*F->arg_begin();
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);

     
    CI->setDoesNotThrow();
    F->setNoUnwind();

     
    if (!CI->use_empty()) {
        std::cout << "CallInst has at least one use." << std::endl;
    } else {
        std::cout << "CallInst does not have any uses." << std::endl;
    }

     
    if (F->hasFnAttribute(Attribute::NoUnwind)) {
        std::cout << "Function is marked as nounwind." << std::endl;
    } else {
        std::cout << "Function is not marked as nounwind." << std::endl;
    }

    if (!CI->doesNotThrow()) {
        std::cout << "CallInst does not have 'nothrow' attribute." << std::endl;
    } else {
        std::cout << "CallInst has 'nothrow' attribute." << std::endl;
    }

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     

    return 0;
}
