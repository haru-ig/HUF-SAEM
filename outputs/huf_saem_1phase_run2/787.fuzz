#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyIndVar.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *Func = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_function", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", Func);

     
    Argument *Arg = new Argument(IntegerType::getInt32Ty(Context), "arg", Func);
    Arg->setAttr(AttributeIndex, Attribute::Returned);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::memcpy), {}, "", BB);
    CI->setDoesNotThrow();

     
    Value *User = CI;
    if (User.use_empty()) {
        User = ConstantInt::get(Type::getInt32Ty(Context), 0);
        CI->replaceAllUsesWith(User);
    }

     
    Func->setDoesNotThrow();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    if (!II || !II->isAnyMemIntrinsic()) {
        return 1;
    }

     
    if (auto *SimplifiedCI = simplifyCall(CI)) {
        CI->replaceAllUsesWith(SimplifiedCI);
        delete CI;
        CI = SimplifiedCI;
    }

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    if (!CB) {
        return 1;
    }

     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
