#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);
    
     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FT, Function::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt32Ty(Context), 4)}, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);
    
     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "The intrinsic call is valid and recognized.\n";
    } else {
        errs() << "The intrinsic call is not recognized as a memory intrinsic.\n";
    }
    
     
    if (F->arg_size() > 0 && F->getArg(0)->hasRetAttr()) {
        errs() << "The function contains an argument with the returned attribute.\n";
    } else {
        errs() << "The function does not contain an argument with the returned attribute.\n";
    }
    
     
    
    return 0;
}
