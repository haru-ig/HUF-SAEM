#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Transforms/Utils.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    new Argument(Type::getInt32Ty(Context), Arg->getName(), &M, 0);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, {Arg->getType()}, {Arg, ConstantInt::get(Type::getInt8Ty(Context), 0), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", BB);
    CI->addUse(Arg);  

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
     

     
     

     

     
    M.print(errs());

    return 0;
}
