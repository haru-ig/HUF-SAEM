#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getVoidTy(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", Module.get());

     
    Value *Arg1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Function *Printf = Intrinsic::getDeclaration(Module.get(), Intrinsic::printf, {Type::getInt8PtrTy(Context)});
    CallInst *CI = CallInst::Create(Printf, {Arg1}, "", F);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwind(false);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        errs() << "CallInst is an intrinsic call.\n";
    } else {
        errs() << "CallInst is not an intrinsic call.\n";
        return 1;
    }

     
    if (dyn_cast<CallBase>(CI)) {
        errs() << "Context instruction is a CallBase.\n";
    } else {
        errs() << "Context instruction is not a CallBase.\n";
        return 1;
    }

     

    return 0;
}
