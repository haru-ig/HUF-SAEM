#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttr(Attribute::Returned);

     
    Value *Callee = nullptr;  
    std::vector<Value *> Args = {Arg};
    CallBase *CI = CallBase::Create(Intrinsic::getDeclaration(&M, Intrinsic::any_mem_intrinsic), Callee, Args, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use.");
    assert(!F->doesNotThrow() && "Function must be marked as nounwind while CallInst is not doesNotThrow.");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call.");

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::any_mem_intrinsic) {
            int NumBytes = 0;  
            assert(NumBytes <= 0 || NumBytes % getElementTypeSize(Arg->getType()) != 0);
        }
    }

     
    CI->print(errs());

    return 0;
}
