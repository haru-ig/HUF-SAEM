#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "foo", M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    std::vector<Value *> Args;
    Args.push_back(Arg1);
    CallInst *CI = CallInst::Create(nullptr, F->getName(), Args, "", BB);

     
    Use &U = CI->use_begin();
    if (!U) {
        std::cerr << "CallInst does not have any uses.\n";
        return 1;
    }

     
    F->setDoesNotThrow(true);

     
    if (!dyn_cast<IntrinsicInst>(CI)) {
        std::cerr << "CallInst is not an intrinsic.\n";
        return 1;
    }

     
    Value *Zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *AtomicCmpXchg = Intrinsic::getDeclaration(M, llvm::Intrinsic::atomic_cmpxchg, {CI->getType()});
    AtomicCmpXchg->setArgOperand(2, Zero);  

     
    M->print(errs());

    return 0;
}
