#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {}, {}, "", BB);
    assert(!CI->use_empty() && "The CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    F->setNoUnwind();
    CI->setDoesNotThrow();

     
    SimplifyCFG(F);

    std::cout << "Test function with intrinsic call created." << std::endl;
    return 0;
}
