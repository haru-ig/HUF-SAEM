#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &Mod);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Argument *Arg = new Argument(Type::getInt32Ty(Context), "arg", BB);
    Arg->setParamAttr(0, Attribute::Returned);
    
     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::memcpy), { ConstantInt::get(Type::getInt32Ty(Context), 0) }, "", BB);
    
     
    CI->addUse(Type::getInt32Ty(Context));
    
     
    F->setDoesNotThrow();
    
     
    if (dyn_cast<IntrinsicInst>(CI)) {
        AnyMemIntrinsic *AMII = dyn_cast<AnyMemIntrinsic>(CI);
        if (AMII) {
             
            uint64_t NumBytes = 0;
            if (!NumBytes || !(NumBytes % sizeof(int32_t))) {
                 
            }
        }
    }
    
     
    Mod.print(outs(), nullptr);
    
    return 0;
}
