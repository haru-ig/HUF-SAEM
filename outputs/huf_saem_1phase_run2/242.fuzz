#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Value.h>
#include <iostream>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *Func = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", Module.get());
    Func->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", Func);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    Func->setDoesNotThrow();
    CI->setDoesNotThrow(false);

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     
    Module->print(outs(), nullptr);

    return 0;
}
