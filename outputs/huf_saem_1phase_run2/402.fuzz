#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());
    BasicBlock *EntryBB = BasicBlock::Create(Context, "", F);
    
     
    IRBuilder<> Builder(EntryBB);
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 5);
    CallInst *CI = CallInst::Create(FTy, FunctionCtor::get(F->getContext()), {}, "", EntryBB);
    
     
    CI->addUse(Type::getInt32Ty(Context), nullptr);
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    Intrinsic::ID IID = Intrinsic::memcpy;  
    CallInst *MemCI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), IID), CI->getType(), {CI}, "", EntryBB);
    
     
    if (dyn_cast<IntrinsicInst>(MemCI)) {
        std::cout << "Intrinsic detected, proceeding with test." << std::endl;
    } else {
        std::cerr << "No intrinsic detected!" << std::endl;
        return 1;
    }
    
     
     
    
     
    Mod->print(outs(),   false, nullptr);
    
    return 0;
}
