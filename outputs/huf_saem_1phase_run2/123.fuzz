#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);
    Argument *Arg = F->getArg(0);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    IRBuilder<> Builder(BB);
    Value *ArgValue = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(FTy, F, {ArgValue}, "", BB);

     
    CI->addUse(F->getArgNo());

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    Intrinsic::ID IID = Intrinsic::not_an_intrinsic;  
    CallInst *IntrinsicCI = CallInst::Create(Type::getVoidTy(Context), static_cast<Value*>(nullptr), std::vector<Value*>(), "", BB);
    IntrinsicCI->setCalledFunction(Intrinsic::not_an_intrinsic, FTy);  

     

    return 0;
}
