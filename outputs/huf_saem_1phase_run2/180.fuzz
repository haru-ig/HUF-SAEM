#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallInst *CI = CallInst::Create(F, {ConstantExpr::getInt32Ptr(0)}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setOnlyAccessesStack();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(II) && "Intrinsic must be a memory intrinsic");

     
    if (auto *AMI = dyn_cast<AtomicRMWInst>(CI)) {
        Value *Ptr = AMI->getPointerOperand();
        uint64_t NumBytes = 0;  
        assert(NumBytes <= 0 || !isMultipleOfElementSize(NumBytes, 4) && "Atomic unordered memory intrinsic length must be non-positive or not a multiple of the element size");
    }

     
    std::cout << "Function: " << F->getName() << "\n";
    std::cout << "CallInst: " << *CI << "\n";

    return 0;
}
