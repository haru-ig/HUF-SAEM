#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    F->addFnAttr(llvm::Attribute::ReturnsTwice);

     
    CallInst *CI = CallInst::Create(FTy, F, {Arg}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *AnyMemCI = IntrinsicInst::get(Context, Intrinsic::anymemintrinsic, { CI }, "", BB);

     
    F->getBasicBlockList().push_back(BB);

     
    M->print(errs());

    return 0;
}
