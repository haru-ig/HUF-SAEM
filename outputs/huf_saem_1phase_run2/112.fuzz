#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FT, Function::ExternalLinkage, "testFunc", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    Value *Zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *Vec = InsertElementInst::Create(UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4)), Zero, Zero, "", BB);

     
    CallInst *CI = CallInst::Create(Vec->getType(), Vec, {Arg}, "", BB);

     
    CI->addUse(F->getArgNo(0));

     
    F->print(errs());

    return 0;
}
