#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttribute(0, Attribute::Returned);
    
     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memset), {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked as nounwind");
    
     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    
     
    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
    
     
    Value *Length = AMII->getArgOperand(1);
    int64_t NumBytes = cast<ConstantInt>(Length)->getSExtValue();
    assert(NumBytes <= 0 || !isMultipleOfElementSize(NumBytes) && "NumBytes must be non-positive or not a multiple of the element size");
    
     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");
    
     
    IRPosition Pos = IRPosition::callsite_argument(*CI);
    assert(Pos.getKind() == IRP_CALL_SITE_ARGUMENT && "IRPosition must have the correct position kind");
    
     
    Function *Func = Pos.getAssociatedFunction();
    assert(Func && "Function associated with IRPosition must be non-null");
    
     
    
    return 0;
}
