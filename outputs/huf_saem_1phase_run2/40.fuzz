#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    F->arg_begin()->setName("arg");

     
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB);
    CI->setCalledFunction(F);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    assert(!F->doesNotThrow() && "Function must be marked as nounwind while CallInst is not");

     
    Intrinsic::ID ID = Intrinsic::sqrt;
    CallInst *IntrCall = CallInst::Create(Intrinsic::getDeclaration(&M, ID), {Arg}, "", BB);
    assert(isa<IntrinsicInst>(IntrCall) && "CallInst must be an intrinsic call");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(IntrCall);
    assert(II && "IntrinsicInst must be castable from CallInst");
    assert(!II->use_empty() && "IntrinsicInst must have at least one use");

     
    CI->print(errs());
    std::cout << "\n";
    IntrCall->print(errs());

    return 0;
}
