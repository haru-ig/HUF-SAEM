#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Verifier.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType* FuncType = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncType, Function::ExternalLinkage, "test_function", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value* Const1 = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value* Const2 = ConstantInt::get(Type::getInt32Ty(Context), 2);
    Value* CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, Const1, Const2, "", BB);

     
    Type* Int32Ty = Type::getInt32Ty(Context);
    Value* TrueVal = ConstantInt::get(Int32Ty, 10);
    Value* FalseVal = CallInst::Create(Intrinsic::getName(Intrinsic::fabs), {Const1}, "", BB);
    Value* SelectInst = SelectInst::Create(CondVal, TrueVal, FalseVal, "", BB);

     
    F->getBasicBlockList().push_back(BB);
    BB->getInstList().push_back(SelectInst);

     
    if (verifyModule(M, &outs())) {
        std::cerr << "Error in module: verification failed.\n";
        return -1;
    }

     
    std::cout << "Generated function:\n" << *F << "\n";

    return 0;
}
