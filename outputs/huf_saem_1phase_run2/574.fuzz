#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function* F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Argument* Arg = &*F->arg_begin();
    Arg->setArgAttr(0, Attribute::Returned);

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::memcpy), { ConstantPointerNull::get(Type::getInt8PtrTy(Context)), Arg, ConstantInt::get(Type::getInt64Ty(Context), 4) }, "", BB);
    CI->setDoesNotThrow();  

     
    F->setNoUnwind();

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    if (!F->doesNotThrow()) {
        std::cerr << "Function is not marked as nounwind or CallInst throws\n";
        return 1;
    }

     
    IntrinsicInst* II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    if (!II->isAnyMemory()) {
        std::cerr << "CallInst is not an AnyMemIntrinsic\n";
        return 1;
    }

     
    Value* Simplified = nullptr;
    bool SimplifiedSuccess = SimplifyInstruction(CI, Simplified);
    assert(SimplifiedSuccess && "Failed to simplify CallInst");

     

    std::cout << "Test passed successfully!\n";
    return 0;
}
