#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/BasicBlock.h"
#include "llvm/IR/Instruction.h"
#include "llvm/IR/IntrinsicInst.h"
#include "llvm/IR/Constants.h"
#include "llvm/Transforms/Utils/BasicBlockUtils.h"

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::sqrt, {ConstantFP::get(Type::getFloatTy(Context), 1.0)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::Nounwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked as nounwind");

     
    IntrinsicInst *AnyMemIntrinsic = IntrinsicInst::get(CI, Intrinsic::anymemintrinsic);
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     

    std::cout << "Test program setup completed." << std::endl;
    return 0;
}
