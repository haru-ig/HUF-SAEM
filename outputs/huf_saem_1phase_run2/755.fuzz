#include <iostream>
int main() {
#include "llvm/IR/LLVMContext.h"
#include "llvm/IR/Module.h"
#include "llvm/IR/Function.h"
#include "llvm/IR/BasicBlock.h"
#include "llvm/IR/Instruction.h"
#include "llvm/IR/Constants.h"
#include "llvm/IR/Intrinsics.h"
#include "llvm/IR/CallBase.h"
#include "llvm/IR/IRBuilder.h"

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), IntegerType::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");
    Arg->addAttr(Attribute::Returned);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memcpy), {}, "", BB);
    CI->setDoesNotThrow();

     
    Use &U = F->back().use_begin();
    Instruction *User = cast<Instruction>(U.getUser());
    assert(User && "CallInst must have at least one user");

     
    F->setDoesNotThrow();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic");
    assert(II->getIntrinsicID() == Intrinsic::memcpy && "Intrinsic must be memcpy");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase");

     
     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
