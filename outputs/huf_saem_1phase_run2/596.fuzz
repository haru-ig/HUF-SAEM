#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function* F = Function::Create(FT, Function::ExternalLinkage, "test_func", M);
    F->addArgAttr(0, Attribute::Returned);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memset), {}, "memset_call", BB);

     
    F->addFnAttr(Attribute::NoUnwind);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    IntrinsicInst* II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "The CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

     
    if (II->getIntrinsicID() == Intrinsic::memset) {
         
    }

     
    std::cout << "Module: " << M->getName() << "\n";
    std::cout << "Function: " << F->getName() << "\n";
    std::cout << "BasicBlock: " << BB->getName() << "\n";
    std::cout << "CallInst: " << *CI << "\n";

     
    delete M;
    return 0;
}
