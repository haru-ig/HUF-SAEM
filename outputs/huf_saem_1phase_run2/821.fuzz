#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::Nounwind);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::getDeclaration(Mod.get(), Intrinsic::memset), {}, "", BB);
    CI->setDoesNotThrow();
    
     
    Use &U = F->back().front().addUse(*CI);
    
     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "The CallInst is an intrinsic call.\n";
    } else {
        errs() << "The CallInst is not an intrinsic call.\n";
    }
    
     
    Mod->print(outs(), nullptr);
    
    return 0;
}
