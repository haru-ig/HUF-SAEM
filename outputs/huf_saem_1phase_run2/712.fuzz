#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallInst.h>
#include <llvm/Transforms/Utils/LoopUtils.h>
#include <llvm/Analysis/ScalarEvolution.h>
#include <llvm/Analysis/ValueTracking.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    CI->setDoesNotThrow();  
    assert(!CI->doesNotThrow() && "CallInst must not be marked as nounwind");
    CI->setIsNoUnwind();  
    assert(CI->isNoUnwind() && "CallInst must be marked as nounwind");

     
    Intrinsic::ID IID = Intrinsic::not_an_intrinsic;  
    CI->setCalledFunction(Intrinsic::getDeclaration(&M, IID));
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    AnyMemIntrinsic *AMII = dyn_cast<AnyMemIntrinsic>(CI);
    assert(AMII && "CallInst must be a memory intrinsic");

     
    if (AMII->isAtomic() && !AMII->isUnordered()) {
        uint64_t NumBytes = 0;  
        assert(NumBytes <= 0 || !(NumBytes % AMII->getElementSize()), "For atomic unordered memory intrinsics, length must be non-positive or not a multiple of the element size");
    }

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase");

     

    return 0;
}
