#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttribute(AttributeList::ReturnIndex, Attribute::Returned);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context)}, {}, "", BB);
    CI->addUse(Arg);  

     
    F->setDoesNotThrow();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic." << std::endl;
    }

     
    if (!CI->use_empty()) {
        CI->setDoesNotThrow();  
        simplifyCall(CI);  
    }

     
     

    return 0;
}
