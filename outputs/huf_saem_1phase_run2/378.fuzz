#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Attributes.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), true);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::anymem_start), {}, "", BB);

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "The CallInst must be an intrinsic call");
    assert(II->getIntrinsicID() == Intrinsic::anymem_start && "Specific intrinsic check");

     

    std::cout << "Test program structure created successfully.\n";
    return 0;
}
