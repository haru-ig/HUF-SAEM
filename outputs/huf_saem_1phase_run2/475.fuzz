#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

 
void simplifyCallInst(CallInst &CI) {
    if (CI.use_empty()) return;  

    Function *func = CI.getFunction();
    if (!func->isNounwind() && !CI.doesNotThrow()) return;  

    IntrinsicInst *II = dyn_cast<IntrinsicInst>(&CI);
    if (!II || !II->isAnyMemIntrinsic()) return;  

    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
    Value *Ptr = AMII->getPointerOperand();
    uint64_t NumBytes = AMII->getNumElements() * AMII->getElementType()->getPrimitiveSizeInBits();
    if (NumBytes > 0 && NumBytes % 8 == 0) return;  

     
    CI.setTailCall(true);  
}

int main() {
    LLVMContext Context;
    Module M("test_module", Context);
    FunctionType *FTy = FunctionType::get(Type::getVoidTy(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(nullptr, Value::getUndef(Type::getVoidTy(Context)), "", BB);

     
    simplifyCallInst(*CI);

    std::cout << "Module: " << M.getName() << "\n";
    return 0;
}
