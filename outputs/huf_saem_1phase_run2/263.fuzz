#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_function", &M);

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *CI = CallInst::CreateIntrinsic(Intrinsic::memset, {Type::getInt8PtrTy(Context)}, {}, "", BB);

     
    CI->addUse(Type::getInt32Ty(Context));

     
    F->setDoesNotThrow();
    F->setUnwindDest(nullptr);

     
    CallInst *CtxCI = dyn_cast<CallBase>(CI);
    assert(CtxCI && "Context instruction must be a CallBase");

     
    if (auto *IMI = dyn_cast<AnyMemIntrinsic>(CI)) {
         
        uint64_t NumBytes;
        if (IMI->isUnordered()) {
            IMI->getLength(NumBytes);
            assert(NumBytes <= 0 || NumBytes % 8 != 0 && "NumBytes must be non-positive or not a multiple of the element size");
        }
    }

     
    Function::arg_iterator AI = F->arg_begin();
    if (AI != F->args().end()) {
        AI.addAttr(Attribute::Returned);
    }

     
    outs() << "Module: " << M.getName() << "\n";
    outs() << "Function: " << F->getName() << "\n";
    CI->print(outs());
    outs() << "\n";

    return 0;
}
