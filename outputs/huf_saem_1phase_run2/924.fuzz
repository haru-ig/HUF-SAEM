#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *UndefVec = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    Instruction *InsertElem = new InsertElementInst(UndefVec, Zero, Zero, "", BB);

     
    assert(InsertElem->getNumOperands() == 3 && "InsertElementInst should have three operands");

     
    errs() << "Module: " << M.getName() << "\n";
    F->printAsOperand(errs(), false);
    errs() << "\n";
    BB->printAsOperand(errs(), false);
    errs() << "\n";
    InsertElem->printAsOperand(errs(), false);
    errs() << "\n";

     
    delete InsertElem;

    return 0;
}
