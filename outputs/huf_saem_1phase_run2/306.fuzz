#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>

using namespace llvm;

 
void simplifyInstruction(Instruction &I) {
     
    if (!I.use_empty()) {
        I.simplify();
    }
}

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *X = ConstantInt::get(Type::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(nullptr, { X }, "", BB);

     
    if (F->doesNotThrow()) {
         
        F->setDoesNotThrow();
    }

     
    simplifyInstruction(*CI);

    std::cout << "Module: " << M.getName() << "\n";

    return 0;
}
