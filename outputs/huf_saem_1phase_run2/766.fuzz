#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function* F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Argument* Arg = &*(F->arg_begin());
    Arg->setName("arg");
    Arg->setParamAttr(0, Attribute::Returned);

     
    CallInst* CI = CallInst::Create(FuncTy, Intrinsic::getDeclaration(&M, Intrinsic::memcpy), { Arg }, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    IntrinsicInst* IIC = cast<IntrinsicInst>(CI);
    assert(IIC->getIntrinsicID() == Intrinsic::memcpy && "CallInst must be a memcpy intrinsic");

     
    CallBase* CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase");

     
     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
