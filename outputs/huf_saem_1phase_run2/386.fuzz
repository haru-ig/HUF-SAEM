#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Verifier.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = Builder.CreateAlloca(Type::getInt32Ty(Context));
    CallInst *CI = Builder.CreateCall(Intrinsic::getDeclaration(&M, Intrinsic::memset), { Arg, ConstantInt::get(Type::getInt8Ty(Context), 0), ConstantInt::get(Type::getInt64Ty(Context), 1) });
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    assert(II->getIntrinsicID() == Intrinsic::memset && "Specific intrinsic must be used");

     
    std::string Error;
    raw_fd_ostream OS("output.ll", Error);
    if (Error.empty()) {
        ModulePassManager MPM;
        MPM.addPass(PrintModulePass(OS));
        MPM.run(*M);
    } else {
        std::cerr << "Failed to write IR to output: " << Error << "\n";
    }

    return 0;
}
