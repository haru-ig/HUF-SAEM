#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);
    Function* F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", M);
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    CallInst* CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::any_mem_intrinsic), {}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        Intrinsic::ID ID = CI->getIntrinsicID();
        assert(ID == Intrinsic::any_mem_intrinsic && "CallInst must be an intrinsic call of type AnyMemIntrinsic");
    } else {
        std::cerr << "CallInst is not an intrinsic call" << std::endl;
        return 1;
    }

     
    if (!isa<CallBase>(CI)) {
        std::cerr << "Context instruction is not a CallBase" << std::endl;
        return 1;
    }

     

    std::cout << "All constraints satisfied." << std::endl;
    return 0;
}
