#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32PtrTy(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(F, Arg, "", BB);

     
    CI->addUse(CI->getType());

     
    F->setDoesNotThrow();
    F->setUnwindPredecessor(&*F->begin()->getFirstInsertionBlock(), BB);

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    if (II->getIntrinsicID() == Intrinsic::anymemset) {
         
    } else if (II->getIntrinsicID() == Intrinsic::anymemcpy) {
         
    } else if (II->getIntrinsicID() == Intrinsic::anyread || II->getIntrinsicID() == Intrinsic::anywrite) {
         
    }

     
    M.print(errs());

    return 0;
}
