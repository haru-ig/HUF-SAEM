#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", Mod.get());
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), IntrinsicType::memcpy), {}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    F->setLinkage(GlobalValue::ExternalLinkage);
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked with 'nounwind'");
    
     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (const auto *AMII = dyn_cast<AnyMemIntrinsic>(II)) {
            assert(AMII->getDstAlign() == 0 && "Zero-length operation for atomic unordered memory intrinsic");
        }
    }
    
     
    Mod->print(outs(), nullptr);

    return 0;
}
