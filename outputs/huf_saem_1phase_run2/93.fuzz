#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);
    
     
    FunctionType* FT = FunctionType::get(IntegerType::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FT, GlobalValue::InternalLinkage, "func", &M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);
    
     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    assert(II->getIntrinsicID() == Intrinsic::memcpy && "Intrinsic must be memcpy");
    
     
    assert(!CI->doesNotThrow() && "CI must not throw");
    assert(!F->isDeclaration() && "Function must not be declared externally");
    
     
    M.print(errs());
    
    return 0;
}
