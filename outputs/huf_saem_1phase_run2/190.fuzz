#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

void generateTestCode() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(F, {Arg}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    Intrinsic::ID IntrID = Intrinsic::not_an_intrinsic;  
    CallInst *IntrCI = CallInst::Create(Intrinsic::getDeclaration(&M, IntrID), {Arg}, "", BB);
    assert(dyn_cast<IntrinsicInst>(IntrCI) && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(IntrCI) && "Intrinsic call must be a memory intrinsic");

     
    Value *CtxI = IntrCI;
    assert(isa<CallBase>(CtxI) && "Context instruction must be a CallBase");

     
}

int main() {
    generateTestCode();
    return 0;
}
