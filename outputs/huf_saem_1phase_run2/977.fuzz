#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "foo", &Mod);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memset, {}, {ConstantInt::get(Type::getInt32Ty(Context), 0)}, "", BB);
    
     
    CI->addUse(F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setOnlyAccessesMemory();
    
     
    assert(!CI->doesNotThrow() && "Intrinsic call should not be marked as nounwind");
    
     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "Intrinsic call detected\n";
    } else {
        errs() << "No intrinsic call detected\n";
    }
    
     
    assert(F->doesNotThrow() && "Function should be marked as nounwind");
    assert(!CI->doesNotThrow() && "Intrinsic call should not be marked as nounwind");
    
    return 0;
}
