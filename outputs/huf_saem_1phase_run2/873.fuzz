#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    ConstantInt *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    ConstantInt *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 0);
    ConstantInt *CondVal = ConstantInt::get(Type::getInt1Ty(Context), true);

     
    SelectInst *SI = SelectInst::Create(CondVal, TrueVal, FalseVal, "", BB->getFirstNonPHI());

     
    assert(!SI->use_empty() && "The `CallInst` object `CI` must have at least one use.");
    assert(F->doesNotThrow() && "The function containing the `CallInst` (`CI.getFunction()`) must be marked as `nounwind`.");
    assert(isa<IntrinsicInst>(SI) && isa<AnyMemIntrinsic>(SI) && "The `CallInst` must be an intrinsic call and specifically an `AnyMemIntrinsic`.");
     

    std::cout << "All constraints satisfied." << std::endl;
    return 0;
}
