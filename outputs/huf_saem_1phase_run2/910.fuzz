#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallBase *CI = CallBase::Create(Intrinsic::getDeclaration(M, Intrinsic::anymemintrinsic), {Value::get(Type::getInt32Ty(Context), 0)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::anymemintrinsic && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    Value *TrueVal = ConstantFP::get(Type::getFloatTy(Context), 1.0);
    Value *FalseVal = Intrinsic::create(Intrinsic::fabs, {TrueVal}, "", BB);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, TrueVal, ConstantInt::get(Type::getInt32Ty(Context), 2));
    Type *SelType = Type::getFloatTy(Context);
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);
    assert(SI && "SelectInst must be valid");
    SI->setType(SelType);

     
    assert(TrueVal->getType() == SelType && "TrueVal type must match SelType");
    assert(FalseVal->getType() == SelType && "FalseVal type must match SelType");
    assert(CondVal->getType() == Type::getInt1Ty(Context) && "CondVal type must be i1");

     
     

    return 0;
}
