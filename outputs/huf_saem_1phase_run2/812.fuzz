#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    ConstantInt *Zero = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *Vec[1] = { Zero };
    InsertElementInst *IEI = new InsertElementInst(UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 1)), Vec[0], Zero, "", BB);

     
    Intrinsic::ID IID = Intrinsic::memcpy;
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(M, IID), IEI, IEI->getType(), "", BB);

     
    CI->addUse(*F);

     
    F->setLinkage(GlobalValue::InternalLinkage);
    F->setDoesNotThrow();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic call");
    assert(II->getIntrinsicID() == IID && "Expected a memcpy intrinsic call");

     
    assert(!F->hasFnAttribute(Attribute::NoUnwind) && "Function should not be marked as nounwind");
    assert(!CI->doesNotThrow() && "CallInst should not be marked as nounwind");

     
    M->print(outs(), nullptr);

    delete M;
    return 0;
}
