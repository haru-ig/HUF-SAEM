#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &Mod);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    AllocaInst *Alloca = new AllocaInst(Type::getInt32Ty(Context), 0, "arg_alloca", BB->getFirstInsertionPt());

     
    LoadInst *LoadArg = new LoadInst(Type::getInt32Ty(Context), F->getArg(0), "", BB);
    StoreInst *StoreArg = new StoreInst(LoadArg, Alloca, BB);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&Mod, Intrinsic::memset), { Alloca, ConstantInt::get(Type::getInt32Ty(Context), 0), ConstantInt::get(Type::getInt64Ty(Context), 8) }, "", BB);
    assert(!CI.use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::ExternalLinkage);
    F->setUnnamedAddr(GlobalValue::UnnamedAddr::None);

     
    assert(F->doesNotThrow() && "Function must be marked as nounwind");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::memset && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");

     
     

    std::cout << "Test passed!" << std::endl;
    return 0;
}
