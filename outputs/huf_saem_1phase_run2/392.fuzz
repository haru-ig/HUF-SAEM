#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Use.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", &M);
    Argument *Arg = F->getArg(0);
    Arg->setParamAttr(0, AttributeSet::ReturnIndex, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {Constant::getNullValue(Type::getInt8PtrTy(Context)), Constant::getNullValue(Type::getInt8PtrTy(Context)), Constant::getInt32(Type::getInt32Ty(Context)), Constant::getInt32(Type::getInt32Ty(Context))});
    CI->setDoesNotThrow();
    BB->getInstList().push_back(CI);

     
    Use &U = F->arg_begin()->use_begin();
    assert(!U.getUser()->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow(true);
    CI->setDoesNotThrow(false);

     
    IntrinsicInst *AII = dyn_cast<IntrinsicInst>(CI);
    assert(AII && "CallInst must be an intrinsic call");
    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(AII);
    assert(AMII && "CallInst must be a memory intrinsic call");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");

     
    Value *Simplified;
    bool SimplifiedSuccess = simplifyCallInst(*CI, Simplified);

     
    assert(SimplifiedSuccess && "simplifyCallInst must be successful");

    return 0;
}
