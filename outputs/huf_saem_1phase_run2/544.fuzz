#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testfunc", Mod.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::abs), {}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    IntrinsicInst *II = cast<IntrinsicInst>(CI);
    assert(isa<AnyMemIntrinsic>(II) && "Intrinsic must be a memory intrinsic");
    AnyMemIntrinsic *AMII = cast<AnyMemIntrinsic>(II);
    if (AMII->getIntrinsicID() == Intrinsic::memset || AMII->getIntrinsicID() == Intrinsic::memcpy) {
        int NumBytes = 16;  
        assert(NumBytes <= 0 || NumBytes % sizeof(int) != 0, "For atomic unordered memory intrinsics, length must meet the condition");
    }

     
    Function::arg_iterator AI = F->arg_begin();
    Value *Arg = &*AI;
    Arg->setName("arg");
    Arg->addAttr(Attribute::Return);

     
    assert(isa<CallBase>(CI) && "Context instruction must be a CallBase");

     
    auto *IRP = IRPosition::callsite_argument(*CI);
    assert(IRP.getKind() == IRP_CALL_SITE_ARGUMENT, "IRPosition should have the correct kind");

     

    Mod->print(errs(), nullptr);
    return 0;
}
