#include <iostream>
int main() {
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Support/Casting.h>

using namespace llvm;

int main() {
     
     
    
    Function *F = nullptr;  
    CallInst *CI = nullptr;  

    assert(!CI->use_empty() && "CallInst must have at least one use.");
    assert(F->doesNotThrow() && "Function must be marked nounwind and not throw.");
    
    if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI)) {
        assert(II->getIntrinsicID() == Intrinsic::anymemintrinsic && "Must be an AnyMemIntrinsic.");
    }

     

    return 0;
}
