#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", M);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");
    Arg->addAttr(Attribute::Returned);
    
     
    Intrinsic::ID IID = Intrinsic::fabs;  
    Function *IntrinFunc = Intrinsic::getDeclaration(M, IID);
    CallInst *CI = CallInst::Create(IntrinFunc, {Arg}, "", F->getEntryBlock().getFirstInsertionPt());
    
     
    CI->addUse(*F->arg_begin());
    
     
    F->setDoesNotThrow();
    F->setNoUnwind();
    
     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
         
         
    }
    
     
    M->print(outs(), nullptr);
    
    delete M;
    return 0;
}
