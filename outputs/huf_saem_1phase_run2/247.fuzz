#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "main", &M);
    BasicBlock *EntryBB = BasicBlock::Create(Context, "", F);
    BuilderBase<BasicBlock*, ConstantFolder> B(EntryBB);

     
    FunctionCallee Callee = M.getOrInsertFunction("llvm.return.zero", FuncTy);
    CallInst *CI = CallInst::Create(FuncTy, Callee, "", EntryBB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setIsNoUnwind();
    assert(!CI->doesNotThrow() && "CallInst must not be marked as doesNotThrow");

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, CI, ConstantInt::get(Type::getInt32Ty(Context), 2), "", EntryBB);
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", EntryBB);

     
    for (int i = 0; i < 10; ++i) {
        BasicBlock *LoopHeader = BasicBlock::Create(Context, "loop.header", F);
        BranchInst::Create(LoopHeader, EntryBB);  
        LoopHeader->moveAfter(EntryBB);
    }

     
    M.print(errs(), nullptr);

    return 0;
}
