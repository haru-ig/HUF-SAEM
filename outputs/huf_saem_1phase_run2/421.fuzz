#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Transforms/Utils/Cloning.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", M);
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);
    
     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttr(Attribute::Returned);
    
     
    FunctionCallee Callee = M->getOrInsertFunction("llvm.memcpy.p0i8.p0i8.i32", FunctionType::get(Type::getVoidTy(Context), {PointerType::get(Type::getInt8Ty(Context), 0), PointerType::get(Type::getInt8Ty(Context), 0), Type::getInt32Ty(Context)}, false));
    CallInst *CI = Builder.CreateCall(Callee, {ConstantExpr::getBitCast(Arg, PointerType::get(Type::getInt8Ty(Context), 0)), ConstantExpr::getBitCast(Arg, PointerType::get(Type::getInt8Ty(Context), 0)), ConstantInt::get(Type::getInt32Ty(Context), 4)});
    CI->setDoesNotThrow();  
    
     
    F->setDoesNotThrow();
    
     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    
     
    assert(F->doesNotThrow() && !CI->doesNotThrow() && "Function must be marked as nounwind while CallInst is not");
    
     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::memcpy && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic");
    
     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance");
    
     
    Value *ArgValue = CB->getArgOperand(0);
    assert(ArgValue && "IRPosition must have a non-null value");
    
     
    Function *Func = CI->getFunction();
    assert(Func && "Associated function must be non-null");
    
     

    std::cout << "All constraints satisfied!" << std::endl;
    return 0;
}
