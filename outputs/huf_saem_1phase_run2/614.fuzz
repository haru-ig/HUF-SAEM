#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "func", &M);

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memset), {}, "", BB);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(!F->doesNotThrow() && "Function must be marked as nounwind while CallInst is not");

     

     
    if (auto *II = dyn_cast<AnyMemIntrinsic>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::memset) {
             
        }
    }

     
    legacy::PassManager Passes;
    Passes.add(createInstructionSimplifierPass());
    Passes.run(*F);

     
    bool simplified = false;
    for (auto &BB : *F) {
        for (auto &I : BB) {
            if (&I == CI) {
                simplified = true;
                break;
            }
        }
    }

    assert(simplified && "Expected the CallInst to be simplified");

     
    M.print(errs(), nullptr);

    return 0;
}
