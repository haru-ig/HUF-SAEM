#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);

     
    FunctionType* FT = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function* F = Function::Create(FT, Function::ExternalLinkage, "testFunc", M);
    Argument* Arg = &(*F->arg_begin());
    Arg->setName("input");
    Arg->addAttr(Attribute::Returned);

     
    Intrinsic::ID ID = Intrinsic::memcpy;  
    Function* MemCpyFunc = Intrinsic::getDeclaration(M, ID);
    std::vector<Value*> Args;
    Args.push_back(ConstantExpr::getPointerNull(Type::getInt8PtrTy(Context)));
    Args.push_back(ConstantExpr::getSizeOf(Type::getInt32Ty(Context)));
    CallInst* CI = CallInst::Create(MemCpyFunc, Args, "", F->getEntryBlock().getFirstInsertionPt());

     
    CI->addUse(*F);

     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
        errs() << "The CallInst is an intrinsic call.\n";
    } else {
        errs() << "The CallInst is not an intrinsic call.\n";
    }

     
    if (!CI->use_empty()) {
        std::unique_ptr<CallBase> SimplifiedCI = CI->simplify();
        if (SimplifiedCI) {
            errs() << "The CallInst has been simplified.\n";
        } else {
            errs() << "The CallInst could not be simplified.\n";
        }
    }

    return 0;
}
