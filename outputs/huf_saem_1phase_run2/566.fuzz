#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

void generateTest() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *Func = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "func", Module.get());
    BasicBlock *EntryBB = BasicBlock::Create(Context, "", Func);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(Func->getFunctionType(), Func, {Arg}, "", EntryBB);
    CI->setCalledFunction(Intrinsic::getDeclaration(Module.get(), Intrinsic::example_intrinsic));

     
    CI->addUse(CI->getType());

     
    Func->setDoesNotThrow();
    Func->setLinkage(GlobalValue::InternalLinkage);

     
    if (IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI)) {
        if (AnyMemIntrinsic *AM = dyn_cast<AnyMemIntrinsic>(II)) {
             
            uint64_t NumBytes = 0;  
            if (NumBytes > 0 && !isMultiple(NumBytes, Func->getFunctionType()->getScalarSizeInBits())) {
                 
            }
        }
    }

     
    if (!CI->use_empty()) {
         
    }

     
    Module->print(outs(), nullptr);
}

int main() {
    generateTest();
    return 0;
}
