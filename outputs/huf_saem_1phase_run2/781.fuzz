#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FuncTy = FunctionType::get(IntegerType::getInt32Ty(Context), true);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(IntegerType::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(FuncTy->getPointerTo(), Intrinsic::memset, {Arg}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     
    M.print(errs());

    return 0;
}
