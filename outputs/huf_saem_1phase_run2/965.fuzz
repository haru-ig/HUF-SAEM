#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *Func = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &Mod);
    Func->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", Func);

     
    Value *VecTy = VectorType::get(Type::getInt32Ty(Context), 4);
    Constant *ZeroIdx = ConstantInt::get(Type::getInt64Ty(Context), 0);
    Instruction *InsertElem = InsertElementInst::Create(UndefValue::get(VecTy), ConstantInt::get(Type::getInt32Ty(Context), 1), ZeroIdx, "", BB);

     
    assert(InsertElem->getType()->isVectorTy() && "InsertElementInst should be a vector type");
    assert(isa<ConstantInt>(ZeroIdx) && "Index must be an integer constant");

     
    CallInst *CI = CallInst::Create(Func, {InsertElem}, "", BB);
    assert(!CI->use_empty() && "CallInst should have at least one use");

     
    Func->setDoesNotThrow();
    Func->setUnwindPredecessor(BB);

     
    IntrinsicInst *AnyMemIntrinsic = IntrinsicInst::get(Intrinsic::anymem_intrinsic, {CI}, "", BB);
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst should be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(CI) && "Intrinsic should be AnyMemIntrinsic");

     
    Mod.print(outs(), nullptr);

    return 0;
}
