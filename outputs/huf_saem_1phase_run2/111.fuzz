#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module Mod("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &Mod);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Vec = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    Constant *Idx = ConstantInt::get(Type::getInt32Ty(Context), 0);
    Instruction *InsElt = InsertElementInst::Create(Vec, ConstantInt::get(Type::getInt32Ty(Context), 1), Idx, "", BB);

     
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, InsElt, ConstantInt::get(Type::getInt32Ty(Context), 2), "", BB);
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantPopInst::create(TrueVal, BB);
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    assert(CondVal && "Condition value must be non-null");
    assert(TrueVal->getType() == FalseVal->getType() && "True and false values must have compatible types");

     
     
    SI = simplifySelectInst(SI, CondVal, TrueVal, FalseVal);

     
    assert(SI && "Simplified select instruction must be non-null");

    std::cout << "Select instruction created: " << *SI << std::endl;

    return 0;
}
