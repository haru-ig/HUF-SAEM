#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_function", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg1 = &*F->arg_begin();
    Arg1->setName("arg1");

     
    CallInst *CI = CallInst::Create(FTy, F, {Arg1}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    CI->setDoesNotThrow();

     
    Intrinsic::ID IntrinID = Intrinsic::sqrt;
    CallInst *IntrinCI = CallInst::Create(Type::getVoidTy(Context), Intrinsic::getDeclaration(&M, IntrinID), {}, "", BB);
    assert(dyn_cast<IntrinsicInst>(IntrinCI) && "CallInst must be an intrinsic call.");
    assert(isa<AnyMemIntrinsic>(IntrinCI) && "CallInst must be an AnyMemIntrinsic.");

     
    CallBase *CB = dyn_cast<CallBase>(IntrinCI);
    assert(CB && "Context instruction must be a CallBase instance.");

     

    return 0;
}
