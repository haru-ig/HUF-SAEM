#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "main", &M);

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *CallInst = CallInst::Create(nullptr, nullptr, "", BB);

     
    CallInst->addUse(*F->arg_begin());

     
    F->setDoesNotThrow();
    F->setUnwindDest(BB);

     
    Intrinsic::ID IID = Intrinsic::not_an_intrinsic;  
    CallInst *IntrinsicCall = CallInst::Create(Intrinsic::getDeclaration(&M, IID), {}, "", BB);

     
    if (auto *ICall = dyn_cast<IntrinsicInst>(IntrinsicCall)) {
        if (ICall->getIntrinsicID() == Intrinsic::any_mem_intrinsic) {
             
        }
    }

     
    assert(F->doesNotThrow() && "Function must be marked as nounwind");

     
    M.print(outs(), nullptr);

    return 0;
}
