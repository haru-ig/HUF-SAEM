#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/Cloning.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(FuncTy->getPointerTo(), F, { Arg }, "", BB);

     
    CI->addUse(F->getArg(0));

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::ExternalLinkage);

     
    if (!dyn_cast<IntrinsicInst>(CI)) {
        std::cerr << "CallInst is not an intrinsic call!" << std::endl;
        return 1;
    }

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    if (II->getIntrinsicID() == llvm::Intrinsic::memset || II->getIntrinsicID() == llvm::Intrinsic::memcpy) {
         
        Value *NumBytes = ConstantInt::get(Type::getInt64Ty(Context), 0);  
        CI->setArgOperand(2, NumBytes);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::memmove) {
         
        Value *NumBytes = ConstantInt::get(Type::getInt64Ty(Context), 0);  
        CI->setArgOperand(2, NumBytes);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::atomic_load || II->getIntrinsicID() == llvm::Intrinsic::atomic_store) {
         
        Value *NumBytes = ConstantInt::get(Type::getInt64Ty(Context), -1);  
        CI->setArgOperand(2, NumBytes);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::fabs) {
         
        Value *X = ConstantFP::get(Type::getFloatTy(Context), 1.0);
        CI->setArgOperand(0, X);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::fneg) {
         
        Value *X = ConstantFP::get(Type::getFloatTy(Context), 1.0);
        CI->setArgOperand(0, X);
    } else if (II->getIntrinsicID() == llvm::Intrinsic::ctpop) {
         
        Value *X = ConstantInt::get(Type::getInt32Ty(Context), 1);
        CI->setArgOperand(0, X);
    }

     

    return 0;
}
