#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    Argument *Arg = F->getArg(0);  
    Arg->addAttr(Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *VecVal = UndefValue::get(VectorType::get(Type::getInt32Ty(Context), 4));
    ConstantInt *Index = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Instruction *InsertElem = InsertElementInst::Create(VecVal, Arg, Index, "", BB);

     
    assert(!InsertElem->use_empty() && "InsertElementInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");

     
    Intrinsic::ID ID = Intrinsic::memset;  
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, ID), VecVal, Arg, "", BB);
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");

     
     

    std::cout << "Test input generated successfully!" << std::endl;
    return 0;
}
