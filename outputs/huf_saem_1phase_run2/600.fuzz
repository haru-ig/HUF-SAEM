#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/Transforms/Utils/LoopUtils.h>
#include <llvm/Analysis/ScalarEvolution.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
    Argument *Arg = F->getArgument(0);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 4)}, "", BB);

     
    CI->addUse(F->getArgNo(0));

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::InternalLinkage);

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 2);
    Value *CondVal = ICmpInst::create(ICmpInst::ICMP_ULT, Arg, ConstantInt::get(Type::getInt32Ty(Context), 2), "", BB);
    SelectInst *SI = new SelectInst(CondVal, TrueVal, FalseVal, "", BB);

     
    assert(SI->getType()->isIntegerTy() && "SelectInst must be of integer type");
    assert(isa<ConstantInt>(SI->getTrueValue()) && isa<ConstantInt>(SI->getFalseValue()) && "SelectInst operands must be constants");

     
    delete SI;
    return 0;
}
