#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Value.h>
#include <llvm/Transforms/Utils/BasicBlockUtils.h>
#include <iostream>

using namespace llvm;

bool checkConstraints(CallInst &CI) {
     
    if (CI.use_empty()) return false;

    Function *func = CI.getFunction();
     
    if (!func->doesNotThrow() || func->hasFnAttribute(Attribute::NoUnwind)) return false;

     
    if (!dyn_cast<IntrinsicInst>(&CI) || !isa<AnyMemIntrinsic>(&CI)) return false;

    IntrinsicInst *II = dyn_cast<IntrinsicInst>(&CI);
     
    if (II->getIntrinsicID() == Intrinsic::memset || II->getIntrinsicID() == Intrinsic::memcpy) {
        Value *Length = II->getOperand(1);
        if (!Length || !isa<ConstantInt>(Length)) return false;
        int64_t NumBytes = Length->getType()->getScalarSizeInBits();  
        if (NumBytes > 0 && !(NumBytes % sizeof(int))) return false;
    }

     
    for (Argument &arg : func->args()) {
        if (arg.hasAttribute(Attribute::Returned)) return true;
    }
    return false;
}

int main() {
    LLVMContext Context;
    Module M("test_module", Context);
    FunctionType *FTy = FunctionType::get(Type::getVoidTy(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock &BB = *(BasicBlock::Create(Context, "", F));
    IRBuilder<> Builder(&BB);
    Value *Callee = ConstantInt::get(Type::getInt32Ty(Context), 0);
    CallInst *CI = Builder.CreateCall(Callee, "call_inst");

    if (checkConstraints(*CI)) {
        std::cout << "Constraints satisfied!" << std::endl;
    } else {
        std::cout << "Constraints not satisfied." << std::endl;
    }

    return 0;
}
