#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

bool checkForAtomicMemIntrinsic(CallInst &CI) {
    if (auto *II = dyn_cast<IntrinsicInst>(&CI)) {
        if (II->getIntrinsicID() == Intrinsic::atomicrmw || II->getIntrinsicID() == Intrinsic::atomic_load) {
            return !II->use_empty();  
        }
    }
    return false;
}

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", Module.get());

    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Args[] = {ConstantInt::get(Type::getInt32Ty(Context), 0)};
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::abs, Type::getInt32Ty(Context)), Args, "", BB);

    if (checkForAtomicMemIntrinsic(*CI)) {
        outs() << "Found an atomic memory intrinsic with at least one use.\n";
    } else {
        errs() << "No suitable intrinsic found or insufficient uses to trigger simplification.\n";
    }

    return 0;
}
