#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    Instruction *Call = CallInst::Create(Intrinsic::getDeclaration(Mod.get(), Intrinsic::abs), { Arg }, "", BB);

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    Mod->print(outs(), nullptr);

    return 0;
}
