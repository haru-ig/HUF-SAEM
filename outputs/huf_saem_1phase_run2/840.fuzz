#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    assert(F->doesNotThrow() && !CI->doesNotThrow() && "Function must be nounwind and CallInst must not throw.");

     
    Intrinsic::ID ID = Intrinsic::memset;
    AnyMemIntrinsic *AMII = Intrinsic::getAnyMemoryIntrinsic(CI, ID);
    assert(AMII && "CallInst must be an intrinsic call and specifically an AnyMemIntrinsic.");

     
    if (AtomicMemIntrinsic *AIMI = dyn_cast<AtomicMemIntrinsic>(AMII)) {
        Value *Ptr = AIMI->getPointerOperand();
        uint64_t NumBytes = AIMI->getNumElements() * AIMI->getElementType()->getPrimitiveSizeInBits() / 8;
        assert(NumBytes <= 0 || (NumBytes % AIMI->getElementType()->getPrimitiveSizeInBits()) != 0 && "For atomic unordered memory intrinsics, the length must be non-positive or not a multiple of the element size.");
    }

     
    std::cout << "Function: " << F->getName() << "\n";
    std::cout << "CallInst: " << *CI << "\n";

    return 0;
}
