#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Verifier.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32Ty(Context), false);
    Function* F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_func", &M);
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value* Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    Function* IntrinFunc = Intrinsic::getDeclaration(&M, Intrinsic::memset, {Arg->getType()});
    std::vector<Value*> MemSetArgs = {ConstantExpr::getBitCast(Builder.CreateAlloca(Type::getInt32Ty(Context)), PointerType::get(Type::getInt32Ty(Context), 0)), Arg, ConstantInt::get(Type::getInt32Ty(Context), 4)};
    CallInst* CI = CallInst::Create(IntrinFunc, MemSetArgs, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (verifyModule(M, &errs())) {
        std::cerr << "Module verification failed.\n";
        return 1;
    }

    std::cout << "Test module successfully created with constraints.\n";
    return 0;
}
