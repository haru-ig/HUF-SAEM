#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Transforms/Utils/UnrollLoop.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {Arg}, "", BB);

     
    CI->addUse(F->arg_begin());

     
    F->setLinkage(GlobalValue::InternalLinkage);
    F->setDoesNotThrow();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic instruction");

     
    AnyMemIntrinsic *MI = cast<AnyMemIntrinsic>(II);
    assert(MI && "Expected a memory intrinsic");

     

     
    simplifyCall(CI, true);

     

    return 0;
}
