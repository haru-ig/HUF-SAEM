#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "testFunc", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    Instruction *I = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::abs), {ConstantInt::get(Type::getInt32Ty(Context), 5)}, "", BB);
    assert(!I->use_empty() && "CallInst must have at least one use");
    assert(F->doesNotThrow() && "Function must be marked as nounwind");
    CallInst *CI = cast<CallInst>(I);
    assert(dyn_cast<IntrinsicInst>(CI) && "CallInst must be an intrinsic call");
    IntrinsicInst *II = cast<IntrinsicInst>(CI);
    assert(isa<AnyMemIntrinsic>(II) && "Intrinsic must be a memory intrinsic");
    
     

    return 0;
}
