#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallBase *CI = CallInst::Create(F->getFunctionType(), F, {ConstantExpr::getInt32(42)}, "", BB);

     
    CI->addUse(Value::use_iterator());

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *II = IntrinsicInst::Create(Intrinsic::any_mem_intrinsic, {CI}, "", BB);

     
    if (auto *AMII = dyn_cast<AnyMemIntrinsic>(II)) {
        AMII->setAtomicOrdering(llvm::AtomicOrdering::Unordered);
        AMII->setSyncScopeID(llvm::SyncScope::System);
    }

     
    M.print(outs(), nullptr);

    return 0;
}
