#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/CallInst.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32PtrTy(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);
    F->addParamAttr(0, Attribute::Returned);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context), Type::getInt8PtrTy(Context), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    assert(!CI->doesNotThrow() && "The CallInst itself should not be nounwind.");
    CI->setDoesNotThrow();
    assert(F->hasFnAttribute(Attribute::NoUnwind) && "Function must be marked as nounwind.");

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && II->getIntrinsicID() == Intrinsic::memcpy && "The CallInst must be an intrinsic call and specifically an AnyMemIntrinsic.");

     
    CallBase *CB = dyn_cast<CallBase>(CI);
    assert(CB && "Context instruction must be a CallBase instance.");

     
    auto IRPos = CB->getCalledOperand()->getValueID();
    assert(IRPos == Value::InstructionVal && "The IRPosition must have a position kind of IRP_CALL_SITE_ARGUMENT.");

     
    Function *Func = CB->getFunction();
    assert(Func && "The function associated with the IRPosition must be non-null.");

     
    std::cout << "Module: " << M.getName() << "\n";
    std::cout << "Function: " << F->getName() << "\n";
    std::cout << "Basic Block: " << BB->getName() << "\n";
    std::cout << "CallInst: " << *CI << "\n";

    return 0;
}
