#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/Transforms/Utils/LoopUtils.h>
#include <llvm/Analysis/LoopPass.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "foo", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    FunctionType *IntrinsicType = Intrinsic::getDeclaration(Module.get(), Intrinsic::memset, {Type::getInt8PtrTy(Context), Type::getInt32Ty(Context), Type::getInt64Ty(Context)});
    CallInst *CI = CallInst::Create(IntrinsicType, {}, "", BB);

     
    CI->addUse(Value::use_empty());

     
    F->setDoesNotThrow();

     
    if (dyn_cast<IntrinsicInst>(CI)) {
        IntrinsicInst *II = cast<IntrinsicInst>(CI);
        if (II->getIntrinsicID() == Intrinsic::memset) {
             
            Value *NumBytes = II->getOperand(2);
            if (!isZero(NumBytes)) {
                IntegerType *IntTy = cast<IntegerType>(NumBytes->getType());
                int64_t BitWidth = IntTy->getBitWidth();
                if (BitWidth <= 0 || BitWidth % 8 != 0) {
                     
                    Builder.CreateCall(Intrinsic::getDeclaration(Module.get(), Intrinsic::trap), {});
                }
            }
        }
    }

     
    Argument *Arg = &*F->arg_begin();
    Arg->addAttr(Attribute::Returned);

     
    CallBase *CB = CI;

     
    if (isa<CallInst>(CB)) {
        CallInst *CI = cast<CallInst>(CB);
        FunctionType *FTy = dyn_cast<FunctionType>(CI->getType());
        if (!FTy) continue;

         
        Value *CondVal = Builder.CreateICmpULT(CI, ConstantInt::get(Context, APInt(32, 2)));
        Value *TrueVal = CI;
        Value *FalseVal = Builder.CreateCall("ctpop", {CI});
        Type *SelType = TrueVal->getType();

         
        if (CondVal && TrueVal && FalseVal && SelType) {
            SelectInst *SI = SelectInst::Create(CondVal, TrueVal, FalseVal, "", BB);

             
            for (int i = 0; i < 10; ++i) {
                SI = Builder.CreateSelect(CondVal, TrueVal, FalseVal, "", BB);
            }
        }
    }

     
    if (F->arg_size() > 0 && F->getArg(0)->hasAttr(Attribute::Returned)) {
         
    }

    std::cout << "Module: " << *Module << std::endl;
    return 0;
}
