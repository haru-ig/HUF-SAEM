#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolution.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("my_module", Context);

     
    FunctionType* FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function* F = Function::Create(FuncTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock* BB = BasicBlock::Create(Context, "", F);

     
    Value* Arg1 = new Argument(Type::getInt32Ty(Context), "arg1", F);
    Instruction* CallInst = CallInst::Create(FuncTy, FunctionCallee(&M.getFunction("test_func")), {Arg1}, "", BB);

     
    assert(!CallInst->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);
    CallInst->setDoesNotThrow();

     
    Value* TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
    Value* FalseVal = BinaryOperator::CreateFNeg(BinaryOperator::CreateFAbs(Arg1), "", BB);
    SelectInst* SI = new SelectInst(ICmpInst::create(Instruction::ICmp, ICmpInst::ICMP_ULT, Arg1, ConstantInt::get(Type::getInt32Ty(Context), 2)), TrueVal, FalseVal, "", BB);

     
    assert(SI->hasOneUse() && "SelectInst must have at least one use");
    assert(SI->getType()->isIntegerTy() && "SelectInst type must be integer");

     
    delete SI;

    return 0;
}
