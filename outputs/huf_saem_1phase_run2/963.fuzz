#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Intrinsics.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Analysis/ScalarEvolution.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), Type::getInt32PtrTy(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    Arg = Builder.CreateAlloca(Arg->getType(), nullptr, "arg");
    Builder.CreateStore(Arg, Arg);
    CallInst *CI = Builder.CreateCall(Intrinsic::getDeclaration(&M, Intrinsic::memcpy), {Arg, ConstantInt::get(Type::getInt64Ty(Context), 8), ConstantInt::get(Type::getInt64Ty(Context), 1)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    auto *AnyMI = dyn_cast<AnyMemIntrinsic>(II);
    assert(AnyMI && "Intrinsic call must be AnyMemIntrinsic");

     
    CallBase *CB = cast<CallBase>(CI);

     

    return 0;
}
