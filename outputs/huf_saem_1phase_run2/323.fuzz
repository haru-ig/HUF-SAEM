#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), IntegerType::getInt32Ty(Context), false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "func", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);

     
    Value *Arg = ConstantInt::get(IntegerType::getInt32Ty(Context), 0);
    CallInst *CI = CallInst::Create(F->getFunctionType(), F, {Arg}, "", BB);

     
    assert(!CI->doesNotThrow() && "CallInst must be marked as !doesNotThrow()");
    F->setDoesNotThrow(false);

     
    Intrinsic::ID IID = Intrinsic::not_an_intrinsic;  
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        switch (II->getIntrinsicID()) {
            case Intrinsic::anymemintrinsic:
                break;
            default:
                return 1;  
        }
    } else {
        return 1;  
    }

     
    CI->addUse(F->getArgList().front());

     
     

    std::cout << "Test program executed successfully." << std::endl;
    return 0;
}
