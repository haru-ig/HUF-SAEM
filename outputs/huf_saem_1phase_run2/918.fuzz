#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/IRBuilder.h>
#include <llvm/Transforms/Utils/Cloning.h>
#include <llvm/Analysis/LoopInfo.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module* M = new Module("test", Context);
    Function* F = cast<Function>(M->getOrInsertFunction("foo", Type::getVoidTy(Context), nullptr));
    BasicBlock* BB = BasicBlock::Create(Context, "", F);
    
     
    IRBuilder<> Builder(BB);
    Value* Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst* CI = Builder.CreateCall(Intrinsic::getDeclaration(M, Intrinsic::memset), {Arg}, "", BB);
    
     
    if (CI->use_empty()) {
        CI->addUse(Builder.getInt32Ty(), Arg);
    }

     
    F->setDoesNotThrow();
    F->setNoUnwind();

     
    if (!dyn_cast<IntrinsicInst>(CI)) {
        return -1;  
    }

     

    delete M;
    return 0;
}
