#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Scalar.h>
#include <llvm/Transforms/Utils.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32PtrTy(Context) }, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);

     
    CI->addUse(F->getParamType(0));

     
    F->setDoesNotThrow();
    F->setLinkage(GlobalValue::ExternalLinkage);
    F->setUnnamedAddr(GlobalValue::UnnamedAddr::None);

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "CallInst must be an intrinsic call");
    assert(isa<AnyMemIntrinsic>(II) && "CallInst must be a memory intrinsic");

     
    CallBase *CB = CI;

     
     
    assert(!CI->use_empty() && "CallInst must have at least one use");
    assert(!F->doesNotThrow() && "Function must be marked as !nounwind");

     

     
    M.print(errs(), nullptr);

    return 0;
}
