#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "main", &M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI;
    if (true) {  
        CI = CallInst::CreateIntrinsic(Intrinsic::memcpy, {Type::getInt8PtrTy(Context)}, {}, "", BB);
    } else {
        CI = CallInst::CreateIntrinsic(Intrinsic::expect, {Type::getInt32Ty(Context), Type::getInt1Ty(Context)}, {}, "", BB);
    }

     
    CI->addUse(Value *V = nullptr);  

     
    assert(!CI->doesNotThrow() && "Intrinsic should not be marked as nounwind");

     
    if (dyn_cast<AnyMemIntrinsic>(CI)) {
         
    }

    std::cout << "Function: " << F->getName().str() << "\n";
    F->print(errs());
    return 0;
}
