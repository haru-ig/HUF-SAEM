#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module *M = new Module("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), {}, false), GlobalValue::ExternalLinkage, "foo", M);
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    CallBase *CI = CallInst::Create(Intrinsic::getDeclaration(M, Intrinsic::memset), {Constant::getNullValue(Type::getInt8PtrTy(Context))}, "", BB);

     
    CI->addUse(F->getArg(0));

     
    IntrinsicInst *II = dyn_cast<IntrinsicInst>(CI);
    assert(II && "Expected an intrinsic instruction");
    assert(II->getIntrinsicID() == Intrinsic::memset && "Expected memset intrinsic");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    assert(!CI->doesNotThrow() && "Expected the call to not be nounwind");

     
    CallBase *CB = dyn_cast<CallBase>(BB->getFirstNonPHI());
    assert(CB && "Expected a CallBase instruction");

    return 0;
}
