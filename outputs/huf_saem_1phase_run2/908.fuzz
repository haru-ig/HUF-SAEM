#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/Instructions.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "testfunc", Mod.get());
    Instruction *CI = CallInst::Create(FuncTy, F, "", new BasicBlock("entry", F));
    assert(!CI->use_empty() && "CallInst must have at least one use.");

     
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);
    assert(!CI->doesNotThrow() && "CallInst must not be marked as no-throw.");

     
    Intrinsic::ID IntrID = Intrinsic::not_an_intrinsic;  
    Instruction *II = IntrinsicInst::Create(IntrID, {}, "", new BasicBlock("entry", F));
    assert((dyn_cast<IntrinsicInst>(II) && isa<AnyMemIntrinsic>(II)) && "Instruction must be an intrinsic call and AnyMemIntrinsic.");

     

    return 0;
}
