#include <iostream>
int main() {
#include <iostream>
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/CallBase.h>
#include <llvm/IR/Value.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Attributes.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test_module", Context);

     
    FunctionType *FuncTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FuncTy, GlobalValue::ExternalLinkage, "test_function", &M);
    F->setDoesNotThrow();
    F->addFnAttr(Attribute::NoUnwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(&M, Intrinsic::any_mem_intrinsic), {ConstantInt::get(Type::getInt32Ty(Context), 0)}, "", BB);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::any_mem_intrinsic) {
            std::cout << "CallInst is an AnyMemIntrinsic intrinsic call." << std::endl;
        } else {
            std::cout << "CallInst is not an AnyMemIntrinsic intrinsic call." << std::endl;
        }
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }

     

    return 0;
}
