#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instruction.h>
#include <llvm/IR/IntrinsicInst.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Type.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("module", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", &M);
    F->addFnAttr(Attribute::NoUnwind);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    IRBuilder<> Builder(BB);
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 42);
    CallInst *CI = CallInst::Create(F, { Arg }, "", BB);

     
    CI->addUse(F);

     
    assert(!CI->doesNotThrow() && "CallInst should not be marked as no-throw");

     
    Intrinsic::ID IID = Intrinsic::pow;  
    Function *PowFunc = Intrinsic::getDeclaration(&M, IID);
    Value *Base = ConstantInt::get(Type::getInt32Ty(Context), 2);
    Value *Exp = ConstantInt::get(Type::getInt32Ty(Context), 3);
    CallInst *PowCI = CallInst::Create(PowFunc, { Base, Exp }, "", BB);

     
    assert(dyn_cast<IntrinsicInst>(PowCI) && "CallInst must be an intrinsic call");
    IntrinsicInst *II = cast<IntrinsicInst>(PowCI);
    assert(II->isMemIntrinsic() && !II->isVolatile());  

     
    M.print(errs(), nullptr);

    return 0;
}
