#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/LegacyPassManager.h>
#include <llvm/Transforms/Utils/SimplifyLibCalls.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Module = std::make_unique<Module>("test", Context);
    Function *F = Function::Create(FunctionType::get(Type::getInt32Ty(Context), false), GlobalValue::ExternalLinkage, "testFunc", Module.get());
    BasicBlock *BB = BasicBlock::Create(Context, "entry", F);

     
    Value *Arg = ConstantInt::get(Type::getInt32Ty(Context), 10);
    CallInst *CI = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::abs, {Arg->getType()}), {Arg}, "", BB);
    CI->setDoesNotThrow();  
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    F->addFnAttr(Attribute::Nounwind);
    assert(!F->doesNotThrow() && "Function must be marked as nounwind while CallInst is not");

     
    if (auto *II = dyn_cast<IntrinsicInst>(CI)) {
        if (II->getIntrinsicID() == Intrinsic::abs) {
            errs() << "Intrinsic: abs\n";
        }
    }

     
    BB->getInstList().push_back(CI);
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    std::unique_ptr<TargetLibraryInfo> TLIM = std::make_unique<TargetLibraryInfo>();
    legacy::PassManager Passes;
    Passes.add(TLIM.get());
    Passes.run(*Module);

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 5);
    Value *FalseVal = CallInst::Create(Intrinsic::getDeclaration(Module.get(), Intrinsic::ctpop, {TrueVal->getType()}), {TrueVal}, "", BB);
    SelectInst *SI = new SelectInst(CI->getContext(), CI->isTrueUndef(), TrueVal, FalseVal, "select", BB);

     
    SI->setCondition(ICmpInst::make(Instruction::ICmp, ICmpInst::ICMP_ULT, SI->getTrueValue(), ConstantInt::get(Type::getInt32Ty(Context), 2)));

     
    BB->getInstList().push_back(SI);
    assert(!SI->use_empty() && "SelectInst must have at least one use");

     
    Module->print(errs(), nullptr);

    return 0;
}
