#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
  LLVMContext Context;
  Module M("test", Context);

   
  FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {}, false);
  Function *F = Function::Create(FTy, Function::ExternalLinkage, "testFunc", &M);
  BasicBlock *EntryBB = BasicBlock::Create(Context, "", F);
  IRBuilder<> Builder(EntryBB);

   
  Value *Args[] = {};
  CallInst *CI = CallInst::Create(F->getFunctionType(), F, Args, "", EntryBB);
  assert(!CI->use_empty() && "CallInst must have at least one use");
  CI->setDoesNotThrow();  

   
  Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 1);
  Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 0);
  SelectInst *SI = SelectInst::Create(Builder.getInt1(true), TrueVal, FalseVal, "", EntryBB);
  assert(SI && "SelectInst must be created");

   
  if (CI->getFunction()->hasFnAttribute("nounwind")) {
    std::cout << "Function is marked nounwind" << std::endl;
  } else {
    std::cout << "Function is not marked nounwind" << std::endl;
  }

   
  if (dyn_cast<IntrinsicInst>(CI)) {
    std::cout << "CallInst is an intrinsic call" << std::endl;
  } else {
    std::cout << "CallInst is not an intrinsic call" << std::endl;
  }

   

  return 0;
}
