#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/Transforms/Utils/ScalarEvolutionExpander.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> M = std::make_unique<Module>("test", Context);
    
     
    FunctionType *FTy = FunctionType::get(IntegerType::getInt32Ty(Context), {IntegerType::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "testFunc", M.get());
    
     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);
    
     
    Value *Arg = ConstantInt::get(IntegerType::getInt32Ty(Context), 42);
    Instruction *Call = CallInst::Create(Intrinsic::getDeclaration(M.get(), Intrinsic::memset), {Arg}, "", BB);
    
     
    Call->addUse(*F);
    
     
    F->setLinkage(GlobalValue::InternalLinkage);
    F->setDoesNotThrow();
    
     
    if (dyn_cast<IntrinsicInst>(Call)) {
        std::cout << "CallInst is an intrinsic call." << std::endl;
    } else {
        std::cout << "CallInst is not an intrinsic call." << std::endl;
    }
    
     
    if (!F->use_empty()) {
        std::cout << "Function contains the CallInst and has at least one use." << std::endl;
    } else {
        std::cout << "Function does not contain the CallInst or has no uses." << std::endl;
    }
    
     
    if (F->doesNotThrow()) {
        std::cout << "Function is marked as nounwind." << std::endl;
    } else {
        std::cout << "Function is not marked as nounwind." << std::endl;
    }
    
     
    if (!Call->doesNotThrow()) {
        std::cout << "CallInst is not marked as nounwind." << std::endl;
    } else {
        std::cout << "CallInst is marked as nounwind." << std::endl;
    }
    
    return 0;
}
