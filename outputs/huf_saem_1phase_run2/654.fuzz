#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/TypeBuilder.h>
#include <llvm/IR/Verifier.h>
#include <llvm/Transforms/Utils/SimplifyCFG.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    std::unique_ptr<Module> Mod = std::make_unique<Module>("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), { Type::getInt32Ty(Context) }, false);
    Function *F = Function::Create(FTy, GlobalValue::ExternalLinkage, "test_func", Mod.get());

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    CallInst *CI = CallInst::Create(FTy, F, { Arg }, "", BB);
    CI->setDoesNotThrow();  

     
    BB->getInstList().push_back(CI);

     
    F->setLinkage(GlobalValue::InternalLinkage);
    F->addFnAttr(Attribute::NoUnwind);

     
    assert(!CI->use_empty() && "CallInst must have at least one use");

     
    if (verifyModule(*Mod, &outs())) {
        errs() << "Verification failed!\n";
        return 1;
    }

     

    std::cout << "Test module successfully created.\n";
    return 0;
}
