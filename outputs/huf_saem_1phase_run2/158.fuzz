#include <iostream>
int main() {
#include <llvm/IR/LLVMContext.h>
#include <llvm/IR/Module.h>
#include <llvm/IR/Function.h>
#include <llvm/IR/BasicBlock.h>
#include <llvm/IR/Instructions.h>
#include <llvm/IR/Constants.h>
#include <llvm/IR/Value.h>
#include <llvm/Support/raw_ostream.h>

using namespace llvm;

int main() {
    LLVMContext Context;
    Module M("test", Context);

     
    FunctionType *FTy = FunctionType::get(Type::getInt32Ty(Context), {Type::getInt32Ty(Context)}, false);
    Function *F = Function::Create(FTy, Function::ExternalLinkage, "test_func", &M);

     
    BasicBlock *BB = BasicBlock::Create(Context, "", F);

     
    Argument *Arg = &*F->arg_begin();
    Arg->setName("arg");

     
    Value *Indices[] = {ConstantInt::get(Type::getInt32Ty(Context), 0)};
    Instruction *InsertInst = InsertElementInst::Create(Arg, ConstantFP::get(Type::getFloatTy(Context), APFloat(1.0)), Indices, "", BB);

     
    Value *TrueVal = ConstantInt::get(Type::getInt32Ty(Context), 42);
    Value *FalseVal = ConstantInt::get(Type::getInt32Ty(Context), 24);
    SelectInst *SI = new SelectInst(CmpInst::create(Instruction::ICmp, CmpInst::ICMP_ULT, Arg, ConstantInt::get(Type::getInt32Ty(Context), 2)), TrueVal, FalseVal, "", BB);

     
    SI->addUse(SI->getType());

     
    M.print(errs(), nullptr);

    return 0;
}
