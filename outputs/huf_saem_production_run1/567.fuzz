#include <iostream>
int main() {
    int a = 10;
    double b = 5.5;
    unsigned long c = 20UL;

     
    auto result1 = a + static_cast<double>(b) * c;
    std::cout << "Result of arithmetic: " << result1 << std::endl;

     
    int arr[] = {a, static_cast<int>(b), static_cast<int>(c)};
    for (auto &val : arr) {
        std::cout << "Array value: " << val << std::endl;
    }

     
    if (result1 == a + b * c) {
        std::cout << "Result matches expected." << std::endl;
    } else {
        std::cout << "Result does not match expected." << std::endl;
    }

     
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 2; ++j) {
            if (arr[i] == arr[j]) {
                std::cout << "arr[" << i << "] is equal to arr[" << j << "]" << std::endl;
            } else {
                std::cout << "arr[" << i << "] is not equal to arr[" << j << "]" << std::endl;
            }
        }
    }
}
