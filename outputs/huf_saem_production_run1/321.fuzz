#include <iostream>
int main() {
    int a = 5;
    double b = 3.14;
    unsigned long c = 2000000000;

     
    auto result1 = a + b;        
    auto result2 = b * c;        
    auto result3 = static_cast<int>(c) - a;   

    std::cout << "result1 (a + b): " << result1 << "\n";
    std::cout << "result2 (b * c): " << result2 << "\n";
    std::cout << "result3 (static_cast<int>(c) - a): " << result3 << "\n";

     
    if (result1 == static_cast<double>(a + b)) {
        std::cout << "result1 is equal to static_cast<double>(a + b)\n";
    } else {
        std::cout << "result1 is not equal to static_cast<double>(a + b)\n";
    }

    if (result2 != result3) {
        std::cout << "result2 is not equal to result3\n";
    } else {
        std::cout << "result2 is equal to result3\n";
    }

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << "Value: " << val << "\n";
    }

    return 0;
}
