#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template <int N>
    struct FibArray {
        static constexpr int value = fibonacci(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Fibonacci number at index 10 is not correct");

     
    std::cout << "Fibonacci number at index 10: " << FibArray<10>::value << std::endl;
}
