#include <iostream>
int main() {
int main() {
    struct Resource {
        int* ptr;
        Resource(int value = 0) : ptr(new int(value)) {}
        ~Resource() { delete ptr; }
        Resource(const Resource& other) : ptr(new int(*other.ptr)) {}
        Resource(Resource&& other) noexcept : ptr(other.ptr) { other.ptr = nullptr; }
        Resource& operator=(const Resource& other) {
            if (this != &other) {
                delete ptr;
                ptr = new int(*other.ptr);
            }
            return *this;
        }
        Resource& operator=(Resource&& other) noexcept {
            if (this != &other) {
                delete ptr;
                ptr = other.ptr;
                other.ptr = nullptr;
            }
            return *this;
        }
    };

    {
        Resource res(42);
        auto lambda = [res]() {
            std::cout << "Inside lambda, accessing resource: " << *res.ptr << "\n";
        };
        lambda();
    }
}
}
