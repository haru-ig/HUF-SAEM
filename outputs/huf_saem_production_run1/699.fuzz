#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template<int N>
    struct FibArray {
        static constexpr int value = fibonacci(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Compile-time calculation error");

     
    int fibArray[FibArray<10>::value];

     
    std::cout << "The Fibonacci number for index 10 is: " << FibArray<10>::value << std::endl;
}
