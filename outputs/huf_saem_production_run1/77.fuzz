#include <iostream>
int main() {
    int a = 5;
    double b = 3.14;
    unsigned long c = 2000000000UL;

     
    auto result1 = a + b;  
    auto result2 = b * c;  
    auto result3 = a - static_cast<int>(b);  

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (result1 == 8.14 && result2 != 608000000000UL) {
        std::cout << "Comparison passed." << std::endl;
    } else {
        std::cout << "Comparison failed." << std::endl;
    }
}
