#include <iostream>
int main() {
     
    std::vector<std::string> vec = {"apple", "banana", "cherry", "date"};

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "Index-based: " << vec[i] << std::endl;
    }

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << "Iterator-based: " << *it << std::endl;
    }

     
    vec.insert(vec.begin() + 2, "grape");
    std::cout << "After insert: ";
    for (const auto& str : vec) {
        std::cout << str << " ";
    }
    std::cout << std::endl;

     
    vec.resize(3);
    std::cout << "After resize: ";
    for (const auto& str : vec) {
        std::cout << str << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end(), [](const std::string& a, const std::string& b) {
        return a.size() < b.size();
    });
    std::cout << "After sorting: ";
    for (const auto& str : vec) {
        std::cout << str << " ";
    }
    std::cout << std::endl;

     
    std::string target = "banana";
    auto it = std::lower_bound(vec.begin(), vec.end(), target, [](const std::string& a, const std::string& b) {
        return a < b;
    });

    if (it != vec.end() && *it == target) {
        std::cout << "Found " << target << " at position: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << target << " not found." << std::endl;
    }

    return 0;
}
