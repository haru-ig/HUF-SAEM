#include <iostream>
int main() {
int main() {
    struct ResourceGuard {
        double value;
        ResourceGuard(double v = 0.0) : value(v) { std::cout << "Resource acquired with value: " << value << "\n"; }
        ~ResourceGuard() { std::cout << "Resource released for value: " << value << "\n"; }
        ResourceGuard(const ResourceGuard& other) : value(other.value) { std::cout << "Resource copied from value: " << other.value << "\n"; }
        ResourceGuard(ResourceGuard&& other) noexcept : value(other.value) { other.value = 0.0; std::cout << "Resource moved from value: " << value << "\n"; }
    };
    struct Resource {
        std::string name;
        explicit Resource(const std::string& n) : name(n) {
            std::cout << "Resource '" << name << "' constructed.\n";
        }
        ~Resource() {
            std::cout << "Resource '" << name << "' destructed.\n";
        }
        Resource(Resource&& other) noexcept : name(std::move(other.name)) {
            std::cout << "Resource '" << name << "' moved.\n";
        }
        Resource& operator=(Resource&& other) noexcept {
            if (this != &other) {
                name = std::move(other.name);
                std::cout << "Resource '" << name << "' move assigned.\n";
            }
            return *this;
        }
        Resource(const Resource& other) : name(other.name) {
            std::cout << "Resource '" << name << "' copied.\n";
        }
        Resource& operator=(const Resource& other) {
            if (this != &other) {
                name = other.name;
                std::cout << "Resource '" << name << "' copy assigned.\n";
            }
            return *this;
        }
    };
    {
        ResourceGuard rg1(42.5);
        auto lambda = [rg = std::move(rg1)]() {
            std::cout << "Inside lambda, resource value: " << rg.value << "\n";
        };
        lambda();
    }
    {
        Resource res1("first");
        {
            Resource res2 = res1;   
            std::cout << "Inside inner block, res2 is a copy of res1.\n";
        }
        Resource res3 = std::move(res1);   
        std::cout << "After moving res1 to res3, res1 has been moved out.\n";
    }
    auto lambda_resource = [](Resource r) {
        std::cout << "Lambda received a resource with name: '" << r.name << "'.\n";
    };
    Resource res3("first");  
    lambda_resource(res3);   
}
}
