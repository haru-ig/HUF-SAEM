#include <iostream>
int main() {
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    int size = 10;  
    int arr[size];

    std::cout << "The compile-time value of Fibonacci at index 10 is: " << fibonacci(10) << std::endl;
}
