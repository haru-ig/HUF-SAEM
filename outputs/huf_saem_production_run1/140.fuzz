#include <iostream>
int main() {
   
  struct ResourceGuard {
    int id;
    ResourceGuard(int i) : id(i) { std::cout << "ResourceGuard(" << id << ") constructed.\n"; }
    ~ResourceGuard() { std::cout << "ResourceGuard(" << id << ") destructed.\n"; }
     
    ResourceGuard(ResourceGuard&& other) noexcept : id(other.id) {
      other.id = -1;  
      std::cout << "ResourceGuard(" << id << ") moved.\n";
    }
    ResourceGuard& operator=(ResourceGuard&& other) noexcept {
      if (this != &other) {
        this->id = other.id;
        other.id = -1;  
        std::cout << "ResourceGuard(" << id << ") move assigned.\n";
      }
      return *this;
    }
  };

   
  {
    ResourceGuard rg(1);
    auto lambda = [rg]() {
      std::cout << "Lambda captured ResourceGuard with id: " << rg.id << "\n";
    };
    lambda();  
  }  
}
