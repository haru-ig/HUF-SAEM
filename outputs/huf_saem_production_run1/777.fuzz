#include <iostream>
int main() {
int a = 5, b = 3, c = 4, d = 2;
bool result = (a != b) || (c != d);
int x = 1, y = 1, z = 2, w = 2;
bool result2 = (x == y) && (z == w);
std::cout << "Result of logical OR operation: " << result << std::endl;
std::cout << "Result of logical AND operation: " << result2 << std::endl;
auto print_result = [](bool r) {
    std::cout << "Lambda captured result: " << r << std::endl;
};
print_result(result);
print_result(result2);
int arr1[] = {5, 3, 4, 2};
int arr2[] = {1, 1, 2, 2};
bool result3 = (arr1[0] != arr1[1]) || (arr1[2] != arr1[3]);
bool result4 = (arr2[0] == arr2[1]) && (arr2[2] == arr2[3]);
std::cout << "Result of array logical OR operation: " << result3 << std::endl;
std::cout << "Result of array logical AND operation: " << result4 << std::endl;
auto print_array_result = [](bool r) {
    std::cout << "Lambda captured array result: " << r << std::endl;
};
print_array_result(result3);
print_array_result(result4);
}
