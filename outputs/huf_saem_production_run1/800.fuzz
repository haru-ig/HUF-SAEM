#include <iostream>
int main() {
     
    int a = 10;
    double b = 2.5;
    unsigned long c = 3;

     
    std::array<double, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    double sum = a + b + c;
    std::cout << "Sum: " << sum << std::endl;

     
    if (sum == static_cast<int>(a) + b + static_cast<double>(c)) {
        std::cout << "Equal" << std::endl;
    } else {
        std::cout << "Not Equal" << std::endl;
    }

     
    double promotedResult = a + b;
    std::cout << "Promoted Result (int + double): " << promotedResult << std::endl;

    return 0;
}
