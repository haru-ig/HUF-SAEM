#include <iostream>
int main() {
     
    constexpr double pi_approx(double epsilon = 1e-10) {
        double pi = 0.0;
        for (int i = 0; ; ++i) {
            double term = pow(-1, i) / (2 * i + 1);
            if (fabs(term) < epsilon) break;
            pi += term;
        }
        return pi * 4;
    }

     
    constexpr double pi = pi_approx();
    static_assert(pi > 3.14 && pi < 3.15, "Approximation of π is not accurate enough");

     
    int array_size = static_cast<int>(pi * 10);
    double* arr = new double[array_size];

     
    for (int i = 0; i < array_size; ++i) {
        arr[i] = static_cast<double>(i);
    }

     
    std::cout << "Array size: " << array_size << "\n";
    for (int i = 0; i < array_size; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << "\n";

     
    delete[] arr;
}
