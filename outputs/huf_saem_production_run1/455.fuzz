#include <iostream>
int main() {
    std::vector<double> numbers = {3.2, 1.5, 4.8, 2.1, 5.0};
    
     
    for (size_t i = 0; i < numbers.size(); ++i) {
        std::cout << numbers[i] << " ";
    }
    std::cout << std::endl;
    
     
    for (auto it = numbers.begin(); it != numbers.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(numbers.begin(), numbers.end());
    
     
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
    
     
    double target = 2.1;
    auto lb = std::lower_bound(numbers.begin(), numbers.end(), target);
    if (lb != numbers.end() && *lb == target) {
        std::cout << "Found " << target << " at index " << std::distance(numbers.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }
    
     
    numbers.insert(numbers.begin() + 2, 3.14);
    
     
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
    
     
    numbers.resize(4);
    
     
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
    
    return 0;
}
