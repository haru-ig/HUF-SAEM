#include <iostream>
int main() {
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    constexpr int size = fibonacci(10);
    int arr[size];  

    std::cout << "The value of Fibonacci number at position 10 is: " << fibonacci(10) << "\n";
}
