#include <iostream>
int main() {
     
    struct Resource {
        int* ptr;
        Resource() : ptr(new int(0)) { std::cout << "Resource allocated\n"; }
        ~Resource() { delete ptr; std::cout << "Resource deallocated\n"; }
         
        Resource(Resource&& other) noexcept : ptr(other.ptr) {
            other.ptr = nullptr;
            std::cout << "Resource moved\n";
        }
        Resource& operator=(Resource&& other) noexcept {
            if (this != &other) {
                delete ptr;
                ptr = other.ptr;
                other.ptr = nullptr;
                std::cout << "Resource move assigned\n";
            }
            return *this;
        }
    };

     
    {
        Resource res;
         
        auto lambda = [res]() mutable { std::cout << "Lambda captured resource: " << *res.ptr << "\n"; };
        lambda();
    }

     
    int value = 42;
    std::cout << "Binary representation of 42 is: ";
    for (int i = sizeof(value) * 8 - 1; i >= 0; --i) {
        std::cout << ((value >> i) & 1);
    }
    std::cout << "\n";
}
