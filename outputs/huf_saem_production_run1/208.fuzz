#include <iostream>
int main() {
    std::vector<double> vec = {3.2, 1.5, 4.8, 2.1, 5.0};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    double target = 2.1;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at index " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }
    
     
    vec.insert(vec.begin() + 2, 1.9);
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.resize(7, 3.14);
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
    return 0;
}
