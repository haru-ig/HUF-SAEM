#include <iostream>
int main() {
    constexpr unsigned long long fibonacci(unsigned long long n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    constexpr unsigned long long N = 50;
    static_assert(fibonacci(N) == 12586269025, "Fibonacci computation is incorrect");

     
    unsigned long long fibArray[fibonacci(N)];

    std::cout << "The " << N << "th Fibonacci number is: " << fibonacci(N) << std::endl;
}
