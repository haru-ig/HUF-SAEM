#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 9, 1, 5, 6};

     
    std::cout << "Initial vector: ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    vec.insert(vec.begin(), 0);

     
    std::cout << "Vector after insert: ";
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.resize(4);

     
    std::cout << "Vector after resize: ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    std::cout << "Sorted vector: ";
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    int target = 5;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at position: " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found in the vector." << std::endl;
    }

    return 0;
}
