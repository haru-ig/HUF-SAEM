#include <iostream>
int main() {
     
    int arr[] = {5, 2, 9, 1, 7};
    int n = sizeof(arr) / sizeof(arr[0]);

     
    std::cout << "Array elements: ";
    for (int i = 0; i < n; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << std::endl;

     
    std::cout << "Array elements: ";
    for (int* ptr = arr; ptr != arr + n; ++ptr) {
        std::cout << *ptr << " ";
    }
    std::cout << std::endl;

     
    std::sort(arr, arr + n);

     
    std::cout << "Sorted array elements: ";
    for (int i = 0; i < n; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << std::endl;

     
    int target = 7;
    bool found = std::binary_search(arr, arr + n, target);
    if (found) {
        std::cout << "Element " << target << " found in the array." << std::endl;
    } else {
        std::cout << "Element " << target << " not found in the array." << std::endl;
    }

     
    std::vector<int> vec(arr, arr + n);

     
    vec.insert(vec.begin() + 2, 3);
    std::cout << "Vector elements after insert: ";
    for (int i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.erase(vec.begin() + 3);
    std::cout << "Vector elements after erase: ";
    for (int i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.resize(7);
    std::cout << "Vector elements after resize: ";
    for (int i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
}
