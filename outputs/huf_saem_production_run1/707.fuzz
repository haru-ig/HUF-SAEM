#include <iostream>
int main() {
    std::vector<double> vec = {3.14, 2.718, 1.618, 0.577, 1.414};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "Index-based: " << vec[i] << std::endl;
    }
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << "Iterator-based: " << *it << std::endl;
    }
    
     
    std::sort(vec.begin(), vec.end());
    
     
    double target = 1.618;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found: " << target << std::endl;
    } else {
        std::cout << "Not found: " << target << std::endl;
    }
    
     
    vec.insert(vec.begin() + 2, 1.732);
    
     
    vec.resize(4);
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "After modifications: Index-based: " << vec[i] << std::endl;
    }
}
