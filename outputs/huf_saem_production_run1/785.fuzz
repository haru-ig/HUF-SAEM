#include <iostream>
int main() {
    int a = 5, b = 3, c = 4, d = 2;
    bool result = (a != b) || (c != d);

    int x = 1, y = 1, z = 2, w = 2;
    bool result2 = (x == y) && (z == w);

     
    int num = 10;
    const char* message = (num > 5) ? "Greater than 5" : "Not greater than 5";

    std::cout << std::boolalpha;  
    std::cout << "Result of (a != b) || (c != d): " << result << std::endl;
    std::cout << "Result of (x == y) && (z == w): " << result2 << std::endl;
    std::cout << message << std::endl;
}
