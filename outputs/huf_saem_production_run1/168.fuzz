#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        if (n <= 1) return n;
        return fib(n - 1) + fib(n - 2);
    }

     
    template <int N>
    struct FibTemplate {};

     
    constexpr int fib_value = fib(10);

     
    static_assert(fib_value == 55, "Fibonacci number at index 10 should be 55");

     
    std::cout << "The Fibonacci number at index 10 is: " << fib_value << std::endl;
}
