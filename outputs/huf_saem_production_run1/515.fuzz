#include <iostream>
int main() {
    int a = 5, b = 3, c = 4, d = 2;
    bool result = (a != b) || (c != d);
    
    int x = 1, y = 1, z = 2, w = 2;
    bool result2 = (x == y) && (z == w);
    
    std::cout << "Result of logical OR operation: " << result << std::endl;
    std::cout << "Result of logical AND operation: " << result2 << std::endl;
    
     
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            std::cout << "i: " << i << ", j: " << j << std::endl;
        }
    }
    
    return 0;
}
