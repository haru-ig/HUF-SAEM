#include <iostream>
int main() {
    int a = 10;
    double b = 3.5;
    unsigned long c = 20UL;

     
    auto sum = a + static_cast<double>(b) + static_cast<unsigned long>(c);
    std::cout << "Sum of int, double, and unsigned long: " << sum << std::endl;

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (a + static_cast<double>(b) == sum) {
        std::cout << "Equal using arithmetic operations." << std::endl;
    } else {
        std::cout << "Not equal using arithmetic operations." << std::endl;
    }

     
    if (a + static_cast<double>(b) != sum) {
        std::cout << "Not equal using arithmetic operations." << std::endl;
    } else {
        std::cout << "Equal using arithmetic operations." << std::endl;
    }
}
