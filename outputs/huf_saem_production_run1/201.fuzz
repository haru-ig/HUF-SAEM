#include <iostream>
int main() {
    std::vector<int> vec = {5, 3, 8, 4, 2};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    vec.insert(std::lower_bound(vec.begin(), vec.end(), 6), 6);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.erase(std::remove(vec.begin(), vec.end(), 3), vec.end());

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.resize(3);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    int target = 8;
    auto it = std::lower_bound(vec.begin(), vec.end(), target);
    if (it != vec.end() && *it == target) {
        std::cout << "Element " << target << " found in the vector." << std::endl;
    } else {
        std::cout << "Element " << target << " not found in the vector." << std::endl;
    }

    return 0;
}
