#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    static_assert(fibonacci(10) == 55, "Fibonacci number at position 10 is not correct.");
    std::string fibArray[fibonacci(10)];

     
    for (int i = 0; i < 10; ++i) {
        std::cout << "Fibonacci number at position " << i << ": " << fibonacci(i) << std::endl;
    }

    return 0;
}
