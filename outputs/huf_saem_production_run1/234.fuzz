#include <iostream>
int main() {
    std::vector<int> vec = {5, 3, 8, 4, 2};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    int target = 4;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at position " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }

     
    vec.insert(vec.begin() + 2, 6);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.resize(4);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    auto printBitRepresentation = [](int num) {
        std::cout << "Binary representation of " << num << ": ";
        for (int i = 7; i >= 0; --i) {
            std::cout << ((num >> i) & 1);
        }
        std::cout << std::endl;
    };

    int number = 42;
    printBitRepresentation(number);

    return 0;
}
