#include <iostream>
int main() {
    constexpr double goldenRatio = 1.618033988749895;  
    
     
    template<int n>
    struct Fibonacci {
        static constexpr int value = Fibonacci<n - 1>::value + Fibonacci<n - 2>::value;
    };
    
    template<>
    struct Fibonacci<0> {
        static constexpr int value = 0;
    };
    
    template<>
    struct Fibonacci<1> {
        static constexpr int value = 1;
    };
    
     
    constexpr int fibonacciNumber = Fibonacci<10>::value;
    
     
    static_assert(fibonacciNumber == 55, "Fibonacci number is incorrect");
    
     
    std::cout << "The 10th Fibonacci number is: " << fibonacciNumber << std::endl;
}
