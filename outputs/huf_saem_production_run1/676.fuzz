#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    static_assert(fibonacci(8) == 21, "Fibonacci number at position 8 should be 21");
    int fibArray[fibonacci(8)];

     
    std::cout << "Fibonacci sequence up to the 8th element: ";
    for (int i = 0; i < fibonacci(8); ++i) {
        std::cout << fibArray[i] << " ";
    }
    std::cout << std::endl;
}
