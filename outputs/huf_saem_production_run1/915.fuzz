#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        if (n <= 1) return n;
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template <int N>
    struct FibArray {
        static constexpr int value = fibonacci(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Fibonacci number at index 10 is incorrect");

     
    std::cout << "The Fibonacci number at index 10 (compile-time computed) is: " << FibArray<10>::value << '\n';
}
