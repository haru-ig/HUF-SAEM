#include <iostream>
int main() {
     
    constexpr uint8_t computeConstexprValue(size_t n) {
        return n == 0 ? 0 : (computeConstexprValue(n - 1) | (1 << ((n - 1) % 8))) << ((n - 1) / 8);
    }

     
    static_assert(computeConstexprValue(8) == 0x55, "Computed value must be 0x55");

     
    uint8_t arr[computeConstexprValue(8)];

     
    std::cout << "Array size: " << sizeof(arr) << std::endl;
}
