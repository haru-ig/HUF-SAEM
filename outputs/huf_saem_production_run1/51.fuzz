#include <iostream>
int main() {
     
    int a = 10;
    double b = 3.5;
    unsigned long c = 20UL;

     
    std::cout << "Values: ";
    for (auto val : {a, b, c}) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    auto result1 = a + static_cast<int>(b);  
    auto result2 = b + static_cast<double>(c);  
    auto result3 = c - static_cast<unsigned long>(a);  

    std::cout << "Arithmetic results: ";
    std::cout << result1 << " " << result2 << " " << result3 << std::endl;

     
    if (result1 == static_cast<int>(result2)) {
        std::cout << "Comparison: true" << std::endl;
    } else {
        std::cout << "Comparison: false" << std::endl;
    }

     
    auto compareBool = static_cast<bool>(result1 != result3);
    std::cout << "Boolean comparison (result1 != result3): " << (compareBool ? "true" : "false") << std::endl;
}
