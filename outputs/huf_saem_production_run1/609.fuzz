#include <iostream>
int main() {
int main() {
    struct ResourceGuard {
        int* resource;
        explicit ResourceGuard(int* res) : resource(res) {}
        ~ResourceGuard() { delete resource; }
    };
    double b = 3.14;
    unsigned long c = 1000000000;
    auto sum = [](auto x, auto y) { return x + y; };
    auto product = [](auto x, auto y) { return x * y; };
    auto difference = [](auto x, auto y) { return x - y; };
    auto quotient = [](auto x, auto y) { return x / y; };
    std::cout << "Sum: " << sum(5, b) << "\n";
    std::cout << "Product: " << product(b, c) << "\n";
    std::cout << "Difference: " << difference(c, 5) << "\n";
    std::cout << "Quotient: " << quotient(5, b) << "\n";
    int array[] = {10, 20, 30};
    for (auto &val : array) {
        std::cout << "Value: " << val << "\n";
    }
    if (sum(5, b) == sum(b, 5)) {
        std::cout << "Sum comparison passed.\n";
    } else {
        std::cout << "Sum comparison failed.\n";
    }
    if (product(b, c) != quotient(c, b)) {
        std::cout << "Product and Quotient comparison passed.\n";
    } else {
        std::cout << "Product and Quotient comparison failed.\n";
    }
    int* resource = new int(42);
    ResourceGuard guard(resource);
    auto lambda = [guard]() {
        std::cout << "Resource value: " << *guard.resource << std::endl;
    };
    lambda();
}
}
