#include <iostream>
int main() {
     
    constexpr unsigned long long fibonacci(unsigned int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template <unsigned long long N>
    struct FibArray {
        static constexpr unsigned long long value = fibonacci(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Compile-time Fibonacci number verification failed");

     
    std::cout << "The 10th Fibonacci number is: " << FibArray<10>::value << std::endl;
}
