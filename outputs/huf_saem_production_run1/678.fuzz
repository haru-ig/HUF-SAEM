#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    static_assert(fibonacci(10) == 55, "Fibonacci computation is incorrect");
    int fibArray[fibonacci(10)];

     
     

     
    std::cout << "The size of the Fibonacci array is: " << sizeof(fibArray) / sizeof(fibArray[0]) << std::endl;
}
