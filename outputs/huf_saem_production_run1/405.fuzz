#include <iostream>
int main() {
     
    constexpr unsigned long long fibonacci(unsigned int n) {
        if (n == 0) return 0;
        if (n == 1) return 1;
        unsigned long long a = 0, b = 1;
        for (unsigned int i = 2; i <= n; ++i) {
            unsigned long long next = a + b;
            a = b;
            b = next;
        }
        return b;
    }

     
    template <unsigned int N>
    struct FibonacciArray {
        static constexpr unsigned long long value = fibonacci(N);
    };

     
    static_assert(FibonacciArray<10>::value == 55, "Compile-time Fibonacci computation is incorrect");

     
    std::cout << "The 10th Fibonacci number is: " << FibonacciArray<10>::value << std::endl;
}
