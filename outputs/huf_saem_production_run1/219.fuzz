#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 9, 1, 7};

     
    std::cout << "Original vector: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    std::cout << "Sorted vector: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    int target = 7;
    auto it = std::lower_bound(vec.begin(), vec.end(), target);
    if (it != vec.end() && *it == target) {
        std::cout << "Found " << target << " at index: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << target << " not found in the vector." << std::endl;
    }

     
    vec.insert(std::next(std::find(vec.begin(), vec.end(), 2)), 3);

     
    std::cout << "Vector after insertion: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    vec.erase(std::remove(vec.begin(), vec.end(), 9), vec.end());

     
    std::cout << "Vector after erasing 9: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    vec.resize(3);

     
    std::cout << "Vector after resizing: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

    return 0;
}
