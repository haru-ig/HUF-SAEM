#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 8, 1, 4};

     
    std::cout << "Vector elements (index-based): ";
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::cout << "Vector elements (iterator-based): ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end(), [](int a, int b) {
        return a < b;
    });

     
    std::cout << "Sorted vector: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    int target = 4;
    auto it = std::lower_bound(vec.begin(), vec.end(), target);
    if (it != vec.end() && *it == target) {
        std::cout << "Element " << target << " found at position: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << "Element " << target << " not found in the vector." << std::endl;
    }

     
    vec.insert(vec.begin() + 2, 3);  
    std::cout << "Vector after inserting 3: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    vec.erase(vec.begin() + 3);  
    std::cout << "Vector after erasing the element at position 3: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    vec.resize(4);  
    std::cout << "Vector after resizing to 4 elements: ";
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
}
