#include <iostream>
int main() {
     
    std::vector<std::string> words = {"apple", "banana", "cherry", "date"};

     
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;

     
    words.insert(words.begin() + 2, "blueberry");

     
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;

     
    words.resize(3);

     
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;

     
    words.erase(words.begin() + 1);

     
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;

     
    std::sort(words.begin(), words.end());

     
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;

     
    std::string target = "banana";
    auto it = std::find(words.begin(), words.end(), target);
    if (it != words.end()) {
        std::cout << target << " found at index: " << std::distance(words.begin(), it) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }

    return 0;
}
