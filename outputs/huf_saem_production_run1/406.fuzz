#include <iostream>
int main() {
     
    constexpr unsigned long long fib(unsigned n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    template <unsigned N>
    struct FibArray {
        static constexpr unsigned long long value = fib(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Fibonacci number at index 10 is incorrect");

     
    std::cout << "The 10th Fibonacci number (at compile time) is: " << FibArray<10>::value << "\n";
}
