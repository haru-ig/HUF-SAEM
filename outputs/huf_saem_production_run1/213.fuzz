#include <iostream>
int main() {
     
    std::vector<std::string> vec = {"apple", "banana", "cherry", "date"};

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "Index-based: " << vec[i] << std::endl;
    }

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << "Iterator-based: " << *it << std::endl;
    }

     
    vec.insert(vec.begin() + 2, "fig");
    std::cout << "After inserting 'fig': ";
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());
    std::cout << "After sorting: ";
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    std::string target = "banana";
    auto it = std::lower_bound(vec.begin(), vec.end(), target);
    if (it != vec.end() && *it == target) {
        std::cout << "Found '" << target << "' in the vector." << std::endl;
    } else {
        std::cout << "Did not find '" << target << "' in the vector." << std::endl;
    }

     
    vec.resize(3);
    std::cout << "After resizing to 3 elements: ";
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    vec.erase(vec.begin() + 1);
    std::cout << "After erasing the second element: ";
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;
}
