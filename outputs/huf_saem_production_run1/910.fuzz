#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    static_assert(fibonacci(8) == 21, "Fibonacci number at index 8 is not correct");
    int fibArray[fibonacci(8)];

     
    std::string fibSequence;
    for (int i = 0; i < 8; ++i) {
        fibSequence += std::to_string(fibonacci(i)) + " ";
    }
    std::cout << "Fibonacci sequence up to index 8: " << fibSequence << std::endl;
}
