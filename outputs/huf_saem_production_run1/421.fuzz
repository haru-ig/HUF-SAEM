#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    template <int N>
    struct FibTemplate {
        static constexpr int value = N;
    };

     
    static_assert(FibTemplate<fib(10)>::value == 55, "Fibonacci number at n=10 is incorrect");

     
    std::cout << "The 10th Fibonacci number is: " << fib(10) << std::endl;
}
