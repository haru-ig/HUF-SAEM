#include <iostream>
int main() {
    std::vector<int> vec = {5, 3, 8, 4, 2};

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (const auto& elem : vec) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;

     
    int target = 4;
    auto it = std::lower_bound(vec.begin(), vec.end(), target);
    if (it != vec.end() && *it == target) {
        std::cout << "Element " << target << " found at index " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << "Element " << target << " not found" << std::endl;
    }

     
    (it != vec.end() && *it == target) ? 
        std::cout << "Element " << target << " found using ternary operator at index " << std::distance(vec.begin(), it) << std::endl :
        std::cout << "Element " << target << " not found using ternary operator" << std::endl;

     
    vec.insert(it, 6);

     
    vec.resize(7);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
}
