#include <iostream>
int main() {
    std::vector<int> vec = {5, 2, 8, 1, 3};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    int target = 4;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at position: " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found in the vector." << std::endl;
    }
    
     
    vec.empty() ? std::cout << "Vector is empty.\n" : std::cout << "Vector is not empty.\n";
    
     
    vec.insert(vec.begin() + 2, 4);
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.erase(vec.begin() + 2);
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.resize(3);
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
}
