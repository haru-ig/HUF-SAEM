#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    static_assert(fib(8) == 21, "Fibonacci number at index 8 should be 21");
    int fibArray[fib(8)];

     
    std::cout << "Fibonacci sequence up to index 8: ";
    for (int i = 0; i <= 8; ++i) {
        std::cout << fib(i) << " ";
    }
    std::cout << std::endl;
}
