#include <iostream>
int main() {
     
    int arr[] = {5, 2, 8, 1, 3};
    
     
    std::array<int, 5> myArray = {5, 2, 8, 1, 3};
    
     
    std::cout << "Index-based iteration: ";
    for (size_t i = 0; i < myArray.size(); ++i) {
        std::cout << myArray[i] << " ";
    }
    std::cout << std::endl;
    
     
    std::cout << "Iterator-based iteration: ";
    for (auto it = myArray.begin(); it != myArray.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(myArray.begin(), myArray.end());
    
     
    std::cout << "Sorted array: ";
    for (const auto& elem : myArray) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
    
     
    int target = 8;
    auto lowerBoundIt = std::lower_bound(myArray.begin(), myArray.end(), target);
    if (lowerBoundIt != myArray.end() && *lowerBoundIt == target) {
        std::cout << "Found " << target << " at position: " << std::distance(myArray.begin(), lowerBoundIt) << std::endl;
    } else {
        std::cout << target << " not found in the array." << std::endl;
    }
    
     
    myArray.insert(std::lower_bound(myArray.begin(), myArray.end(), 7), 7);
    std::cout << "Array after inserting 7: ";
    for (const auto& elem : myArray) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
    
     
    myArray.erase(std::remove(myArray.begin(), myArray.end(), 2), myArray.end());
    std::cout << "Array after erasing 2: ";
    for (const auto& elem : myArray) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
    
     
    myArray.resize(4);
    std::cout << "Resized array to size 4: ";
    for (const auto& elem : myArray) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
}
