#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 8, 1, 4};

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    auto insertPos = vec.begin() + (vec.size() / 2);
    vec.insert(insertPos, 3);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    auto erasePos = vec.begin() + 3;
    vec.erase(erasePos);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    vec.resize(4);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    auto lowerBoundPos = std::lower_bound(vec.begin(), vec.end(), 8);
    if (lowerBoundPos != vec.end() && *lowerBoundPos == 8) {
        std::cout << "Element 8 found at index: " << std::distance(vec.begin(), lowerBoundPos) << std::endl;
    } else {
        std::cout << "Element 8 not found" << std::endl;
    }
}
