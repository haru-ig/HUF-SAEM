#include <iostream>
int main() {

    int a = 5, b = 3, c = 4, d = 2; 
    bool result = (a != b) || (c != d);
    std::string x = "hello", y = "world"; 
    bool result2 = (x == "hello") && (y == "world");
    std::cout << std::boolalpha;  
    std::cout << "result: " << result << std::endl;
    std::cout << "result2: " << result2 << std::endl;
}
