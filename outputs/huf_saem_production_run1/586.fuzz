#include <iostream>
int main() {
    int a = 10;
    double b = 20.5;
    unsigned long c = 30;

    auto result1 = a + b * c;  
    auto result2 = (a + b) * c;  
    auto result3 = a / c;  
    auto result4 = b % c;  

    for (auto value : {result1, result2, result3, result4}) {
        std::cout << "Value: " << value << std::endl;
    }

    bool allEqual = (result1 == result2) && (result2 == result3) && (result3 == result4);
    bool anyEqual = (result1 == result2) || (result2 == result3) || (result3 == result4);

    std::cout << "All results equal: " << (allEqual ? "Yes" : "No") << std::endl;
    std::cout << "Any results equal: " << (anyEqual ? "Yes" : "No") << std::endl;
}
