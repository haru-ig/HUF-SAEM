#include <iostream>
int main() {
int main() {
    struct ResourceGuard {
        int* ptr;
        ResourceGuard(int value) : ptr(new int(value)) {}
        ~ResourceGuard() { delete ptr; }
        ResourceGuard(const ResourceGuard& other) : ptr(new int(*other.ptr)) {}
        ResourceGuard(ResourceGuard&& other) noexcept : ptr(other.ptr) { other.ptr = nullptr; }
        ResourceGuard& operator=(const ResourceGuard& other) {
            if (this != &other) {
                delete ptr;
                ptr = new int(*other.ptr);
            }
            return *this;
        }
        ResourceGuard& operator=(ResourceGuard&& other) noexcept {
            if (this != &other) {
                delete ptr;
                ptr = other.ptr;
                other.ptr = nullptr;
            }
            return *this;
        }
    };
    ResourceGuard rg1(42);
    {
        ResourceGuard rg2 = std::move(rg1);  
    }
    auto lambda = [](ResourceGuard rg) {
        std::cout << "Inside lambda, resource value: " << *rg.ptr << std::endl;
    };
    ResourceGuard rg3(100);
    lambda(std::move(rg3));  
}
}
