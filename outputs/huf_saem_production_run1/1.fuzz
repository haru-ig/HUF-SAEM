#include <iostream>
int main() {
    int a = 5, b = 3, c = 4, d = 2;
    bool result_or = (a != b) || (c != d);
    int x = 1, y = 1, z = 2, w = 2;
    bool result_and = (x == y) && (z == w);
    std::cout << "Result of (a != b) || (c != d): " << result_or << std::endl;
    std::cout << "Result of (x == y) && (z == w): " << result_and << std::endl;
    return 0;
}
