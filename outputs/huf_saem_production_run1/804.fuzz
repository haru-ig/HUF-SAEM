#include <iostream>
int main() {
     
    unsigned int a = 5;
    double b = 3.14;
    unsigned long c = 10;

     
    auto result1 = a + static_cast<int>(b);  
    auto result2 = b + static_cast<double>(c);  
    auto result3 = c - a;  

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (result1 == static_cast<double>(a + b)) {
        std::cout << "Comparison result: true" << std::endl;
    } else {
        std::cout << "Comparison result: false" << std::endl;
    }

    if (result2 != c * 2) {
        std::cout << "Comparison result: false" << std::endl;
    } else {
        std::cout << "Comparison result: true" << std::endl;
    }
}
