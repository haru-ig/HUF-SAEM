#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 9, 1, 5, 6};

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    int target = 5;
    if (std::binary_search(vec.begin(), vec.end(), target)) {
        std::cout << "Found " << target << std::endl;
    } else {
        std::cout << "Did not find " << target << std::endl;
    }

     
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found lower_bound for " << target << ": " << *lb << std::endl;
    } else {
        std::cout << "Did not find lower_bound for " << target << std::endl;
    }

     
    vec.insert(vec.begin() + 2, 3);

     
    vec.resize(vec.size() + 1, 7);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    vec.erase(vec.begin() + 3);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
}
