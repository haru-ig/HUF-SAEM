#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    template <int N>
    struct FibArray {
        static constexpr int value = fib(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Compile-time Fibonacci number is incorrect");

     
    std::cout << "The 10th Fibonacci number at compile time is: " << FibArray<10>::value << std::endl;
}
