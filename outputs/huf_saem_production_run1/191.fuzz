#include <iostream>
int main() {
     
    constexpr uint64_t fibonacci(uint64_t n) noexcept {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template <uint64_t N>
    struct Fibonacci {};

    template <>
    struct Fibonacci<0> { static constexpr uint64_t value = 0; };

    template <>
    struct Fibonacci<1> { static constexpr uint64_t value = 1; };

    template <uint64_t N>
    struct Fibonacci {
        static constexpr uint64_t value = Fibonacci<N - 1>::value + Fibonacci<N - 2>::value;
    };

     
    static_assert(Fibonacci<8>::value == fibonacci(8), "Compile-time and runtime Fibonacci values do not match");

     
    std::cout << "The 8th Fibonacci number at compile time is: " << Fibonacci<8>::value << '\n';
}
