#include <iostream>
int main() {
     
    std::vector<double> numbers = {5.2, 3.1, 8.7, 1.9, 4.6};

     
    std::cout << "Vector elements: ";
    for (size_t i = 0; i < numbers.size(); ++i) {
        std::cout << numbers[i] << " ";
    }
    std::cout << std::endl;

     
    std::cout << "Vector elements (iterator): ";
    for (auto it = numbers.begin(); it != numbers.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    std::sort(numbers.begin(), numbers.end());

     
    std::cout << "Sorted vector elements: ";
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;

     
    double searchValue = 4.6;
    auto lb = std::lower_bound(numbers.begin(), numbers.end(), searchValue);
    if (lb != numbers.end() && *lb == searchValue) {
        std::cout << "Found " << searchValue << " in the vector." << std::endl;
    } else {
        std::cout << "Did not find " << searchValue << " in the vector." << std::endl;
    }

     
    numbers.insert(numbers.begin() + 2, 2.5);

     
    std::cout << "Vector elements after insertion: ";
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;

     
    numbers.erase(numbers.begin() + 3);

     
    std::cout << "Vector elements after erasing: ";
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;

     
    numbers.resize(4);

     
    std::cout << "Vector elements after resizing: ";
    for (const auto& num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;

    return 0;
}
