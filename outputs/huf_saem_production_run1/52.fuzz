#include <iostream>
int main() {
     
    unsigned int a = 10;
    double b = 20.5;
    unsigned long c = 30;

     
    auto result1 = a + static_cast<int>(b) - c;
    auto result2 = a * static_cast<double>(c) / b;

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (result1 == static_cast<int>(result2)) {
        std::cout << "Equal" << std::endl;
    } else {
        std::cout << "Not Equal" << std::endl;
    }

     
    std::cout << "Result1: " << result1 << ", Result2: " << result2 << std::endl;
}
