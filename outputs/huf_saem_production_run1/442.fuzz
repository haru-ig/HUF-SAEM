#include <iostream>
int main() {
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    int size = 10;  
    std::array<int, fibonacci(size)> arr;  

    for (auto &elem : arr) {
        elem = fibonacci(size);  
    }

    for (const auto &elem : arr) {
        std::cout << elem << " ";
    }
    std::cout << std::endl;
}
