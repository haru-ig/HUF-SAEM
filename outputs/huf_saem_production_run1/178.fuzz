#include <iostream>
int main() {
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    static_assert(fib(10) == 55, "Fibonacci computation is incorrect");

     
    const int fibIndex = 10;
    std::array<int, fib(fibIndex)> fibArray;

     
    for (int i = 0; i < fibArray.size(); ++i) {
        fibArray[i] = fib(i);
    }

     
    std::cout << "Fibonacci sequence up to index " << fibIndex << ": ";
    for (const auto& val : fibArray) {
        std::cout << val << " ";
    }
    std::cout << std::endl;
}
