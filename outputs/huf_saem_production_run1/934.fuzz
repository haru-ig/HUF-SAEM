#include <iostream>
int main() {
     
    constexpr unsigned long long fib(unsigned int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    constexpr unsigned int fibIndex = 10;  
    static_assert(fibIndex < 94, "Fibonacci number too large for type unsigned long long");
    
     
    constexpr unsigned long long fibNum = fib(fibIndex);
    static_assert(fibNum <= std::numeric_limits<unsigned long long>::max(), "Fibonacci number too large for type unsigned long long");
    
     
    unsigned long long fibArray[fibIndex];

     
    for (unsigned int i = 0; i < fibIndex; ++i) {
        fibArray[i] = fib(i);
    }

     
    std::cout << "Fibonacci sequence up to index " << fibIndex << ":" << std::endl;
    for (unsigned int i = 0; i < fibIndex; ++i) {
        std::cout << "fib(" << i << ") = " << fibArray[i] << std::endl;
    }

    return 0;
}
