#include <iostream>
int main() {

    int a = 5;
    double b = 3.2;
    unsigned long c = 10;
    auto result1 = a + b * c;
    std::cout << "Result of arithmetic operations: " << result1 << std::endl;
    int arr[] = {a, static_cast<int>(b), static_cast<int>(c)};
    for (auto val : arr) {
        std::cout << "Value: " << val << std::endl;
    }
    if (a + b * c == result1) {
        std::cout << "Equal" << std::endl;
    } else {
        std::cout << "Not Equal" << std::endl;
    }
    auto lambda = [](int x, double y, unsigned long z) {
        return static_cast<double>(x) + y / z;
    };
    auto result2 = lambda(a, b, c);
    std::cout << "Result of lambda operation: " << result2 << std::endl;
    if (result2 == static_cast<double>(a) + b / c) {
        std::cout << "Equal" << std::endl;
    } else {
        std::cout << "Not Equal" << std::endl;
    }
}
