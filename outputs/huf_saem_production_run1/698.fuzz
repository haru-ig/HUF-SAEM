#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    static_assert(fib(8) == 21, "Fibonacci number at index 8 is not correct");
    int fibArray[fib(8)];

     
    std::cout << "The first 8 elements of the Fibonacci sequence are: ";
    for (int i = 0; i < 8; ++i) {
        if (i != 0) std::cout << ", ";
        std::cout << fib(i);
    }
    std::cout << std::endl;
}
