#include <iostream>
int main() {
    constexpr int fibonacci(int n) {
        if (n <= 1) return n;
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    int fibArray[fibonacci(10)];  

    std::cout << "The size of the array is: " << sizeof(fibArray) / sizeof(fibArray[0]) << std::endl;
}
