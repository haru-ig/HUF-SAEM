#include <iostream>
int main() {
     
    unsigned int a = 5;
    double b = 3.2;
    unsigned long c = 10;

     
    auto sum = a + static_cast<double>(a) + static_cast<unsigned long>(b);
    auto product = a * b * c;
    auto difference = c - static_cast<int>(b);

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (sum == a + static_cast<double>(a) && sum != b + c) {
        std::cout << "Sum is correct: " << sum << std::endl;
    } else {
        std::cout << "Sum is incorrect." << std::endl;
    }

    if (product == a * b * c && product != difference) {
        std::cout << "Product is correct: " << product << std::endl;
    } else {
        std::cout << "Product is incorrect." << std::endl;
    }
}
