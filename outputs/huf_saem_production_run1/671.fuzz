#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    template <int N>
    struct FibArray {
        static constexpr int value = fib(N);
    };

     
    static_assert(FibArray<10>::value == 55, "Fibonacci number at index 10 should be 55");

     
    std::cout << "The 10th Fibonacci number is: " << FibArray<10>::value << '\n';
}
