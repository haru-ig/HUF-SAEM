#include <iostream>
int main() {

    int x = 1, y = 1, z = 2, w = 2; bool result2 = (x == y) && (z == w);
    if ((x != y) || (z != w)) {
        std::cout << "At least one comparison is true." << std::endl;
    } else {
        std::cout << "Both comparisons are false." << std::endl;
    }
    int a = 5, b = 3, c = 4, d = 2; bool result = (a != b) || (c != d);
    if ((a == b) && (c == d)) {
        std::cout << "Both comparisons are true." << std::endl;
    } else {
        std::cout << "At least one comparison is false." << std::endl;
    }
    struct ComparisonLogic {
        int e = 7, f = 8, g = 9, h = 10;
    };
    ComparisonLogic cl;
    bool result3 = (cl.e != cl.f) || (cl.g != cl.h);
    if ((cl.e == cl.f) && (cl.g == cl.h)) {
        std::cout << "Both comparisons are true." << std::endl;
    } else {
        std::cout << "At least one comparison is false." << std::endl;
    }
}
