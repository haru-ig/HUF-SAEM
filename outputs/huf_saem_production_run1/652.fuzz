#include <iostream>
int main() {
     
    constexpr unsigned long fib(unsigned int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    constexpr unsigned int fibIndex = 10;  
    static_assert(fib(fibIndex) == 55, "Fibonacci number at index does not match expected value");

     
    std::cout << "The Fibonacci number at index " << fibIndex << " is: " << fib(fibIndex) << "\n";
}
