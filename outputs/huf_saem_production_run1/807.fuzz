#include <iostream>
int main() {
    int a = 10;
    double b = 20.5;
    unsigned long c = 30L;

     
    auto sum = a + static_cast<double>(b) + static_cast<unsigned long>(c);
    auto product = a * static_cast<double>(b) * static_cast<unsigned long>(c);
    auto difference = b - static_cast<int>(a) - c;
    auto quotient = b / static_cast<int>(a);

     
    std::array<double, 3> arr = {static_cast<double>(a), b, static_cast<double>(c)};
    for (const auto& val : arr) {
        std::cout << "Value: " << val << std::endl;
    }

     
    if (sum == a + static_cast<int>(b) + c) {
        std::cout << "Sum comparison passed." << std::endl;
    } else {
        std::cout << "Sum comparison failed." << std::endl;
    }

    if (product != b * static_cast<double>(a) * c) {
        std::cout << "Product comparison failed." << std::endl;
    } else {
        std::cout << "Product comparison passed." << std::endl;
    }

     
    if (difference == b - a - static_cast<int>(c)) {
        std::cout << "Difference comparison passed." << std::endl;
    } else {
        std::cout << "Difference comparison failed." << std::endl;
    }

    if (quotient != b / a) {
        std::cout << "Quotient comparison failed." << std::endl;
    } else {
        std::cout << "Quotient comparison passed." << std::endl;
    }
}
