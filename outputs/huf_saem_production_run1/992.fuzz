#include <iostream>
int main() {
    std::vector<int> vec = {5, 2, 9, 1, 7};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "Index-based: " << vec[i] << " ";
    }
    std::cout << std::endl;
    
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << "Iterator-based: " << *it << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    int target = 7;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at position: " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found in the vector." << std::endl;
    }
    
     
    vec.insert(vec.begin() + 2, 3);
    std::cout << "After insert: ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.erase(vec.begin() + 3);
    std::cout << "After erase: ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.resize(4);
    std::cout << "After resize: ";
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
    return 0;
}
