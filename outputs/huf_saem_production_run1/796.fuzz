#include <iostream>
int main() {
    int e = 7, f = 8, g = 9, h = 10;
    bool result3 = (e != f) || (g != h);
    std::cout << "Result of (e != f) || (g != h): " << result3 << std::endl;
    int arr2[] = {6, 7, 8, 9, 10};
    int* ptr2 = arr2;
    for (int i = 0; i < 5; ++i) {
        std::cout << *(ptr2 + i) << " ";
    }
    std::cout << std::endl;
}
