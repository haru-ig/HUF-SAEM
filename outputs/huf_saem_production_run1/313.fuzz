#include <iostream>
int main() {
int main() {
    int a = 5;
    double b = 3.2;
    unsigned long c = 10;
    auto result1 = a + b;
    auto result2 = b * c;
    auto result3 = static_cast<int>(b) - a;
    std::cout << "result1 (a + b): " << result1 << "\n";
    std::cout << "result2 (b * c): " << result2 << "\n";
    std::cout << "result3 (static_cast<int>(b) - a): " << result3 << "\n";
    int arr[] = {a, static_cast<int>(b), static_cast<int>(c)};
    for (auto val : arr) {
        std::cout << "Value: " << val << "\n";
    }
    if (result1 == 8.2) {
        std::cout << "result1 is equal to 8.2\n";
    } else {
        std::cout << "result1 is not equal to 8.2\n";
    }
    if (result2 != static_cast<double>(c)) {
        std::cout << "result2 is not equal to c\n";
    } else {
        std::cout << "result2 is equal to c\n";
    }
}
}
