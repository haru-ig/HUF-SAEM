#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    static_assert(fib(8) == 21, "Fibonacci number at index 8 is not 21");
    std::string fibArray[fib(8)];

     
    std::cout << "The size of the Fibonacci array is: " << fib(8) << std::endl;
}
