#include <iostream>
int main() {
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    std::string result = "The Fibonacci number at position 10 is: ";
    result += std::to_string(fibonacci(10));

    std::cout << result << std::endl;
}
