#include <iostream>
int main() {
     
    constexpr double pi = 3.141592653589793;
    auto circumference = [](double radius) -> double {
        return 2 * pi * radius;
    };

     
    static_assert(circumference(1.0) == 6.283185307179586, "Circumference calculation is incorrect");

    double radius;
    std::cout << "Enter the radius of the circle: ";
    std::cin >> radius;

     
    double circ = circumference(radius);
    std::cout << "The circumference of the circle with radius " << radius << " is " << circ << std::endl;
}
