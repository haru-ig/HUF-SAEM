#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        if (n <= 1) return n;
        else return fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    template <int N>
    struct FibTemplate {};

     
    template <>
    struct FibTemplate<10> {};

     
    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

     
    std::cout << "Fibonacci number at compile time: " << fibonacci(10) << std::endl;
}
