#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 9, 1, 7};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    for (const auto& num : vec) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
    
     
    auto it = std::lower_bound(vec.begin(), vec.end(), 7);
    if (it != vec.end() && *it == 7) {
        std::cout << "Found 7 at index: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << "7 not found in the vector." << std::endl;
    }
    
     
    vec.insert(std::lower_bound(vec.begin(), vec.end(), 6), 6);
    
     
    for (const auto& num : vec) {
        std::cout << num << " ";
    }
    std::cout << std::endl;
    
     
    if (!vec.empty()) {
        vec.resize(vec.size() - 1);
        vec.erase(std::remove(vec.begin(), vec.end(), 2), vec.end());
        
         
        for (const auto& num : vec) {
            std::cout << num << " ";
        }
        std::cout << std::endl;
    }
    
    return 0;
}
