#include <iostream>
int main() {
     
    int arr[] = {5, 2, 9, 1, 7};
    
     
    std::vector<int> vec(std::begin(arr), std::end(arr));
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << "Index-based: " << vec[i] << " ";
    }
    std::cout << std::endl;
    
    for (const auto& num : vec) {
        std::cout << "Iterator-based: " << num << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
    int target = 7;
    auto it = std::find(vec.begin(), vec.end(), target);
    if (it != vec.end()) {
        std::cout << "Found " << target << " at index: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << target << " not found." << std::endl;
    }
    
     
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " using lower_bound at index: " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found with lower_bound." << std::endl;
    }
    
     
    vec.push_back(3);
    std::sort(vec.begin(), vec.end());
    
    for (const auto& num : vec) {
        std::cout << "After adding 3: " << num << " ";
    }
    std::cout << std::endl;
    
    return 0;
}
