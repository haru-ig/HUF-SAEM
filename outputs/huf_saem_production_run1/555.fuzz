#include <iostream>
int main() {
    int a = 10;
    double b = 3.5;
    unsigned long c = 20UL;

     
    auto sum = static_cast<double>(a) + b + static_cast<double>(c);
    auto product = static_cast<unsigned long>(a * b) + c;

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (sum == static_cast<double>(a) + b + c && product != a * b + c) {
        std::cout << "Sum is correct: " << sum << std::endl;
        std::cout << "Product is incorrect: " << product << std::endl;
    } else if (sum != static_cast<double>(a) + b + c && product == a * b + c) {
        std::cout << "Sum is incorrect: " << sum << std::endl;
        std::cout << "Product is correct: " << product << std::endl;
    } else if (sum != static_cast<double>(a) + b + c && product != a * b + c) {
        std::cout << "Sum and Product are both incorrect." << std::endl;
    } else {
        std::cout << "Sum and Product are correct." << std::endl;
    }
}
