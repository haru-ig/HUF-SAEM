#include <iostream>
int main() {
    std::vector<int> vec = {5, 2, 8, 1, 4};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    std::sort(vec.begin(), vec.end());

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    int target = 4;
    auto lb = std::lower_bound(vec.begin(), vec.end(), target);
    if (lb != vec.end() && *lb == target) {
        std::cout << "Found " << target << " at position: " << std::distance(vec.begin(), lb) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }

     
    vec.insert(vec.begin() + 2, 3);

     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;

     
    vec.resize(7, 0);

     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;

     
    int a = 5, b = 3;
    int xorResult = a ^ b;
    std::cout << "XOR of " << a << " and " << b << " is: " << xorResult << std::endl;
}
