#include <iostream>
int main() {
    int a = 10;
    double b = 20.5;
    unsigned long c = 30L;

     
    auto result1 = a + static_cast<double>(c);
    auto result2 = static_cast<int>(b) * c;
    auto result3 = (a + b) - static_cast<unsigned long>(c);

     
    std::cout << "result1: " << result1 << std::endl;
    std::cout << "result2: " << result2 << std::endl;
    std::cout << "result3: " << result3 << std::endl;

     
    int arr[] = {a, static_cast<int>(b), static_cast<int>(c)};
    for (auto val : arr) {
        std::cout << "Value: " << val << std::endl;
    }

     
    if (result1 == a + b && result2 != c * static_cast<unsigned long>(a)) {
        std::cout << "Comparisons are correct." << std::endl;
    } else {
        std::cout << "Comparisons failed." << std::endl;
    }

     
    int x = 5;
    int y = 3;
    int andResult = x & y;
    int orResult = x | y;
    int xorResult = x ^ y;
    int leftShift = x << 1;
    int rightShift = x >> 1;

    std::cout << "andResult: " << andResult << std::endl;
    std::cout << "orResult: " << orResult << std::endl;
    std::cout << "xorResult: " << xorResult << std::endl;
    std::cout << "leftShift: " << leftShift << std::endl;
    std::cout << "rightShift: " << rightShift << std::endl;
}
