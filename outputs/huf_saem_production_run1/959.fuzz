#include <iostream>
int main() {
    std::vector<double> numbers = {3.14, 2.718, 1.618, 2.718, 0.577};
    
     
    numbers.insert(numbers.begin() + 2, 1.414);
    
     
    numbers.erase(numbers.begin() + 3);
    
     
    numbers.resize(5);
    
     
    std::sort(numbers.begin(), numbers.end());
    
     
    double target = 2.718;
    auto it = std::lower_bound(numbers.begin(), numbers.end(), target);
    
    if (it != numbers.end() && *it == target) {
        std::cout << "Found " << target << " at index: " << std::distance(numbers.begin(), it) << std::endl;
    } else {
        std::cout << target << " not found in the vector." << std::endl;
    }
    
     
    for (size_t i = 0; i < numbers.size(); ++i) {
        std::cout << numbers[i] << " ";
    }
    std::cout << std::endl;
    
     
    for (auto it = numbers.begin(); it != numbers.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
}
