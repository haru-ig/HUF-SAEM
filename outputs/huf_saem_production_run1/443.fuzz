#include <iostream>
int main() {
     
    constexpr int fibonacci(int n) {
        return (n <= 1) ? n : fibonacci(n - 1) + fibonacci(n - 2);
    }

     
    static_assert(fibonacci(8) == 21, "Fibonacci number at index 8 should be 21");
    int fibArray[fibonacci(8)];

     
    for (int i = 0; i < 10; ++i) {
        std::cout << "Fibonacci number at index " << i << ": " << fibonacci(i) << std::endl;
    }
}
