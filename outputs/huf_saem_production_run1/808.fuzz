#include <iostream>
int main() {
    int a = 10;
    double b = 5.5;
    unsigned long c = 20UL;

     
    auto result1 = a + static_cast<double>(b) * c;
    auto result2 = (a / 2) + (b * 3) - (static_cast<unsigned long>(c) / 4);

     
    std::array<auto, 3> values = {a, b, c};
    for (const auto& val : values) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    if (result1 == static_cast<double>(a + b * c)) {
        std::cout << "Result 1 is equal to the expected value." << std::endl;
    } else {
        std::cout << "Result 1 is not equal to the expected value." << std::endl;
    }

    if (result2 != static_cast<int>(a / 2) + static_cast<double>(b * 3) - static_cast<unsigned long>(c / 4)) {
        std::cout << "Result 2 is not equal to the expected value." << std::endl;
    } else {
        std::cout << "Result 2 is equal to the expected value." << std::endl;
    }
}
