#include <iostream>
int main() {
    constexpr unsigned long long fibonacci(unsigned n) {
        if (n == 0) return 0;
        if (n == 1) return 1;
        return fibonacci(n - 1) + fibonacci(n - 2);
    }

    static_assert(fibonacci(10) == 55, "Fibonacci of 10 should be 55");

    constexpr unsigned long long fibValue = fibonacci(10);
    std::cout << "The 10th Fibonacci number is: " << fibValue << std::endl;

     
    static_assert(fibonacci(5) == 5, "Fibonacci of 5 should be 5");
    unsigned long long arr[fibonacci(5)];
    std::cout << "Array size: " << sizeof(arr) / sizeof(arr[0]) << std::endl;
}
