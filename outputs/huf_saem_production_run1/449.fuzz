#include <iostream>
int main() {
     
    constexpr int factorial(int n) {
        return (n <= 1) ? 1 : n * factorial(n - 1);
    }

     
    template<int N>
    struct ArrayHolder {
        int arr[N];
    };

     
    constexpr int value = 5;
    static_assert(factorial(value) == 120, "Factorial of 5 should be 120");
    ArrayHolder<factorial(value)> arrayInstance;

     
    std::cout << "The size of the array is: " << sizeof(arrayInstance.arr) / sizeof(arrayInstance.arr[0]) << std::endl;
}
