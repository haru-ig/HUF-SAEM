#include <iostream>
int main() {
    std::vector<double> numbers = {3.14, 2.718, 1.618, 2.718, 0.577};
    
     
    for (size_t i = 0; i < numbers.size(); ++i) {
        std::cout << "Index " << i << ": " << numbers[i] << std::endl;
    }
    
     
    std::sort(numbers.begin(), numbers.end());
    
     
    for (auto it = numbers.begin(); it != numbers.end(); ++it) {
        std::cout << "Sorted: " << *it << std::endl;
    }
    
     
    double target = 2.718;
    auto lb = std::lower_bound(numbers.begin(), numbers.end(), target);
    if (lb != numbers.end() && *lb == target) {
        std::cout << "Found: " << target << std::endl;
    } else {
        std::cout << "Not found: " << target << std::endl;
    }
    
     
    numbers.insert(numbers.begin() + 2, 1.414);
    
     
    numbers.resize(6);
    
    return 0;
}
