#include <iostream>
int main() {
    std::vector<double> vec = {3.14, 2.718, 1.618, 0.577, 1.414};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    double target = 1.618;
    auto lower = std::lower_bound(vec.begin(), vec.end(), target);
    if (lower != vec.end() && *lower == target) {
        std::cout << "Found " << target << " at index " << std::distance(vec.begin(), lower) << std::endl;
    } else {
        std::cout << target << " not found" << std::endl;
    }
    
     
    vec.insert(vec.begin() + 2, 1.0);
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    vec.resize(4);
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
    return 0;
}
