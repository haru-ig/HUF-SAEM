#include <iostream>
int main() {
     
    std::vector<int> vec = {5, 2, 9, 1, 7};

     
    std::sort(vec.begin(), vec.end());

     
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    auto it = std::lower_bound(vec.begin(), vec.end(), 7);
    if (it != vec.end() && *it == 7) {
        std::cout << "Found 7 at index: " << std::distance(vec.begin(), it) << std::endl;
    } else {
        std::cout << "7 not found" << std::endl;
    }

     
    vec.insert(std::lower_bound(vec.begin(), vec.end(), 4), 4);

     
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    vec.erase(std::remove(vec.begin(), vec.end(), 2), vec.end());

     
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

     
    vec.resize(3);

     
    for (const auto& item : vec) {
        std::cout << item << " ";
    }
    std::cout << std::endl;

    return 0;
}
