#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        return (n <= 1) ? n : fib(n - 1) + fib(n - 2);
    }

     
    static_assert(fib(8) == 21, "Fibonacci number at index 8 should be 21");
    int fibArray[fib(8)];

     
    constexpr int size = fib(8);
    std::array<int, size> stdArray;

     
    std::cout << "Size of the array: " << size << std::endl;

    return 0;
}
