#include <iostream>
int main() {
    std::vector<double> vec = {3.1, 1.2, 2.5, 4.8, 2.9};
    
     
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(vec.begin(), vec.end());
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.insert(vec.begin() + 2, 3.0);
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    vec.resize(7, 0.0);
    
     
    for (auto it = vec.begin(); it != vec.end(); ++it) {
        std::cout << *it << " ";
    }
    std::cout << std::endl;
    
     
    auto lb = std::lower_bound(vec.begin(), vec.end(), 2.5);
    if (lb != vec.end() && *lb == 2.5) {
        std::cout << "Found: " << *lb << std::endl;
    } else {
        std::cout << "Not found" << std::endl;
    }
    
    return 0;
}
