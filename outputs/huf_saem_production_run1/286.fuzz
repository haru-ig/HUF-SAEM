#include <iostream>
int main() {
    int a = 5, b = 3, c = 4, d = 2;
    bool result = (a != b) || (c != d);
    int x = 1, y = 1, z = 2, w = 2;
    bool result2 = (x == y) && (z == w);
    std::cout << "Result of (a != b) || (c != d): " << result << std::endl;
    std::cout << "Result of (x == y) && (z == w): " << result2 << std::endl;
    int num = 10;
    bool isEven = (num % 2 == 0);
    std::cout << "Is the number even? " << isEven << std::endl;
}
