#include <iostream>
int main() {
     
    constexpr unsigned long long fibonacci(unsigned int n) {
        if (n == 0) return 0;
        if (n == 1) return 1;
        unsigned long long a = 0, b = 1, c;
        for (unsigned int i = 2; i <= n; ++i) {
            c = a + b;
            a = b;
            b = c;
        }
        return b;
    }

     
    template <unsigned long long N>
    struct Fibonacci {
        static constexpr unsigned long long value = fibonacci(N);
    };

     
    static_assert(Fibonacci<10>::value == 55, "Fibonacci number at position 10 is incorrect");

     
    std::cout << "The Fibonacci number at position 10 is: " << Fibonacci<10>::value << std::endl;
}
