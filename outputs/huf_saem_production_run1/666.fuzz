#include <iostream>
int main() {
     
    constexpr int fib(int n) {
        if (n <= 1) return n;
        else return fib(n - 1) + fib(n - 2);
    }

     
    template <int N>
    struct FibTemplate {
        static constexpr int value = fib(N);
    };

     
    static_assert(FibTemplate<10>::value == 55, "Fibonacci number at position 10 is incorrect");

     
    std::cout << "Fibonacci number at position 10: " << FibTemplate<10>::value << std::endl;
}
