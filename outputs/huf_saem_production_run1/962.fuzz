#include <iostream>
int main() {
     
    std::vector<std::string> words = {"apple", "banana", "cherry", "date"};
    
     
    std::cout << "Initial vector: ";
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;
    
     
    words.insert(words.begin(), "apricot");
    
     
    std::cout << "Vector after insertion: ";
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;
    
     
    words.resize(3);
    
     
    std::cout << "Vector after resize: ";
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;
    
     
    std::sort(words.begin(), words.end());
    
     
    std::cout << "Sorted vector: ";
    for (const auto& word : words) {
        std::cout << word << " ";
    }
    std::cout << std::endl;
    
     
    std::string target = "banana";
    auto it = std::find(words.begin(), words.end(), target);
    if (it != words.end()) {
        std::cout << "\"" << target << "\" found in vector." << std::endl;
    } else {
        std::cout << "\"" << target << "\" not found in vector." << std::endl;
    }
}
