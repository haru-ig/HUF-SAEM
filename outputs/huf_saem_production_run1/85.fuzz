#include <iostream>
int main() {
    int a = 10;
    double b = 3.5;
    unsigned long c = 20UL;

    auto result1 = a + b * c - (a % c);  
    auto result2 = static_cast<int>(b) + a / c * 2;  

    for (auto val : {result1, result2}) {  
        std::cout << "Result: " << val << std::endl;
    }

    std::cout << (result1 == static_cast<int>(result1) ? "Equal" : "Not Equal") << std::endl;  
    std::cout << (result2 != result2 - 1 ? "Not Equal" : "Equal") << std::endl;
}
