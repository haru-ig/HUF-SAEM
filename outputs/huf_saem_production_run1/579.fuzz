#include <iostream>
int main() {
    int a = 5;
    double b = 3.14;
    unsigned long c = 2000000000;
    
     
    std::array<int, 3> arr = {a, static_cast<int>(b), static_cast<int>(c)};
    
     
    for (const auto& val : arr) {
        std::cout << "Value: " << val << std::endl;
    }
    
    double sum = 0.0;
    for (const auto& val : arr) {
        sum += val;
    }
    
     
    std::cout << "Sum: " << sum << std::endl;
    
     
    if (sum == static_cast<double>(a + b) && sum != c) {
        std::cout << "Comparison passed." << std::endl;
    } else {
        std::cout << "Comparison failed." << std::endl;
    }
    
    return 0;
}
