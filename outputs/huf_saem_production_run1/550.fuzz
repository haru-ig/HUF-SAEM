#include <iostream>
int main() {
     
    int a = 10;
    double b = 3.5;
    unsigned long c = 20UL;

     
    std::array<double, 3> arr = {a, b, static_cast<double>(c)};
    for (const auto& val : arr) {
        std::cout << val << " ";
    }
    std::cout << std::endl;

     
    double sum = a + b + c;
    std::cout << "Sum: " << sum << std::endl;

     
    if (sum == static_cast<double>(a) + b + c) {
        std::cout << "Sums are equal." << std::endl;
    } else {
        std::cout << "Sums are not equal." << std::endl;
    }

     
    if (sum != static_cast<double>(a) + b + c) {
        std::cout << "Sums are not equal." << std::endl;
    } else {
        std::cout << "Sums are equal." << std::endl;
    }
}
