#include <iostream>
int main() {
    int a = 5, b = 3, c = 4, d = 2;
    bool result = (a != b) || (c != d);
    std::cout << std::boolalpha << "Result of (a != b) || (c != d): " << result << std::endl;
    int x = 1, y = 1, z = 2, w = 2;
    bool result2 = (x == y) && (z == w);
    std::cout << std::boolalpha << "Result of (x == y) && (z == w): " << result2 << std::endl;
    auto checkEven = [](int n) {
        return (n % 2 == 0);
    };
    int num1 = 4, num2 = 7;
    bool isNum1Even = checkEven(num1);
    bool isNum2Even = checkEven(num2);
    std::cout << "Is num1 even? " << isNum1Even << ", Is num2 even? " << isNum2Even << std::endl;
}
